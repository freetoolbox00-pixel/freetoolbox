---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Bcrypt Hash Generator" description="Generate and verify bcrypt password hashes. Choose salt rounds. 100% client-side — your password never leaves your device." category="security" icon="🔐">
  <div>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="space-y-4">
        <h3 class="text-lg font-semibold text-gray-900">Generate Hash</h3>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <input type="text" id="bgPass" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" placeholder="Enter password" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Salt Rounds</label>
          <select id="bgRounds" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="8">8 (fast)</option>
            <option value="10" selected>10 (default)</option>
            <option value="12">12 (strong)</option>
          </select>
        </div>
        <button id="bgGen" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium w-full">Generate Hash</button>
        <div id="bgResult" class="hidden">
          <div class="flex justify-between mb-1"><span class="text-sm font-medium text-gray-700">Bcrypt Hash</span><button id="bgCopy" class="text-xs text-blue-600 hover:underline">Copy</button></div>
          <div id="bgHash" class="p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm font-mono break-all"></div>
        </div>
      </div>
      <div class="space-y-4">
        <h3 class="text-lg font-semibold text-gray-900">Verify Hash</h3>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <input type="text" id="bvPass" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" placeholder="Enter password" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Bcrypt Hash</label>
          <input type="text" id="bvHash" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" placeholder="$2a$10$..." />
        </div>
        <button id="bvCheck" class="px-6 py-2.5 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium w-full">Verify</button>
        <div id="bvResult" class="hidden p-3 rounded-lg text-sm font-medium text-center"></div>
      </div>
    </div>
  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bcryptjs/2.4.3/bcrypt.min.js"></script>
</ToolLayout>

<script is:inline>
  const dcrypt = window.dcrypt || window.bcrypt;

  document.getElementById('bgGen').addEventListener('click', function() {
    const pass = document.getElementById('bgPass').value;
    if (!pass) return;
    const rounds = parseInt(document.getElementById('bgRounds').value);
    const btn = this;
    btn.disabled = true; btn.textContent = 'Hashing...';
    setTimeout(function() {
      try {
        var salt = dcrypt.genSaltSync(rounds);
        var hash = dcrypt.hashSync(pass, salt);
        document.getElementById('bgHash').textContent = hash;
        document.getElementById('bgResult').classList.remove('hidden');
      } catch(e) {
        alert('Error: ' + e.message);
      }
      btn.disabled = false; btn.textContent = 'Generate Hash';
    }, 50);
  });

  document.getElementById('bgCopy').addEventListener('click', function() {
    navigator.clipboard.writeText(document.getElementById('bgHash').textContent);
    this.textContent = 'Copied!'; setTimeout(function() { document.getElementById('bgCopy').textContent = 'Copy'; }, 1500);
  });

  document.getElementById('bvCheck').addEventListener('click', function() {
    var pass = document.getElementById('bvPass').value;
    var hash = document.getElementById('bvHash').value;
    if (!pass || !hash) return;
    var btn = this;
    btn.disabled = true; btn.textContent = 'Checking...';
    setTimeout(function() {
      try {
        var match = dcrypt.compareSync(pass, hash);
        var el = document.getElementById('bvResult');
        el.classList.remove('hidden');
        if (match) { el.textContent = '✓ Password matches!'; el.className = 'p-3 rounded-lg text-sm font-medium text-center bg-green-50 text-green-700 border border-green-200'; }
        else { el.textContent = '✗ Password does not match'; el.className = 'p-3 rounded-lg text-sm font-medium text-center bg-red-50 text-red-700 border border-red-200'; }
      } catch(e) { alert('Invalid hash format'); }
      btn.disabled = false; btn.textContent = 'Verify';
    }, 50);
  });
</script>
