---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Electricity Cost Calculator" description="Calculate electricity cost for appliances. Enter watts, hours, rate. See daily, monthly, yearly costs." category="utility" icon="💡">
  <div>
    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Power (Watts)</label>
        <input type="number" id="ecWatts" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="100" min="0" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Usage (hours per day)</label>
        <input type="number" id="ecHours" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="8" min="0" max="24" step="0.5" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Electricity Rate ($/kWh)</label>
        <input type="number" id="ecRate" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="0.12" min="0" step="0.01" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Number of units</label>
        <input type="number" id="ecUnits" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="1" min="1" />
      </div>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-6">
      <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-center">
        <div class="text-xs text-yellow-600">Daily Cost</div>
        <div class="text-2xl font-bold text-yellow-700" id="ecDay">$0.00</div>
      </div>
      <div class="p-4 bg-orange-50 border border-orange-200 rounded-lg text-center">
        <div class="text-xs text-orange-600">Weekly Cost</div>
        <div class="text-2xl font-bold text-orange-700" id="ecWeek">$0.00</div>
      </div>
      <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
        <div class="text-xs text-blue-600">Monthly Cost</div>
        <div class="text-2xl font-bold text-blue-700" id="ecMonth">$0.00</div>
      </div>
      <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-center">
        <div class="text-xs text-red-600">Yearly Cost</div>
        <div class="text-2xl font-bold text-red-700" id="ecYear">$0.00</div>
      </div>
    </div>
    <div class="p-3 bg-gray-50 rounded-lg">
      <div class="text-xs text-gray-500">Energy consumption</div>
      <div class="font-mono text-sm" id="ecKwh">0 kWh/day · 0 kWh/month · 0 kWh/year</div>
    </div>
    <h3 class="text-sm font-medium text-gray-700 mt-6 mb-2">Common Appliances</h3>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="60" data-h="5">Light Bulb (60W)</button>
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="1500" data-h="4">Space Heater</button>
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="150" data-h="24">Refrigerator</button>
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="200" data-h="8">Computer</button>
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="2000" data-h="1">Oven</button>
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="500" data-h="1">Washer</button>
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="100" data-h="6">TV</button>
      <button class="ec-pre p-2 bg-gray-50 rounded-lg hover:bg-gray-100 text-center" data-w="1200" data-h="0.5">Hair Dryer</button>
    </div>
  </div>
</ToolLayout>

<script>
  const wattsIn = document.getElementById('ecWatts') as HTMLInputElement;
  const hoursIn = document.getElementById('ecHours') as HTMLInputElement;
  const rateIn = document.getElementById('ecRate') as HTMLInputElement;
  const unitsIn = document.getElementById('ecUnits') as HTMLInputElement;

  function calc() {
    const watts = parseFloat(wattsIn.value) || 0;
    const hours = parseFloat(hoursIn.value) || 0;
    const rate = parseFloat(rateIn.value) || 0;
    const units = parseInt(unitsIn.value) || 1;

    const kwhDay = (watts * hours * units) / 1000;
    const costDay = kwhDay * rate;

    document.getElementById('ecDay')!.textContent = '$' + costDay.toFixed(2);
    document.getElementById('ecWeek')!.textContent = '$' + (costDay * 7).toFixed(2);
    document.getElementById('ecMonth')!.textContent = '$' + (costDay * 30).toFixed(2);
    document.getElementById('ecYear')!.textContent = '$' + (costDay * 365).toFixed(2);
    document.getElementById('ecKwh')!.textContent = `${kwhDay.toFixed(2)} kWh/day · ${(kwhDay * 30).toFixed(1)} kWh/month · ${(kwhDay * 365).toFixed(0)} kWh/year`;
  }

  [wattsIn, hoursIn, rateIn, unitsIn].forEach(el => el.addEventListener('input', calc));

  document.querySelectorAll('.ec-pre').forEach(btn => btn.addEventListener('click', () => {
    wattsIn.value = (btn as HTMLElement).dataset.w!;
    hoursIn.value = (btn as HTMLElement).dataset.h!;
    calc();
  }));

  calc();
</script>
