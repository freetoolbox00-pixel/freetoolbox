---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Text to Speech"
  description="Convert text to speech using your browser's built-in voices. Adjust speed, pitch and choose from multiple languages. Free TTS tool."
  category="text"
  icon="🔊"
>
  <div>
    <!-- Input -->
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Enter Text</label>
      <textarea id="ttsInput" rows="6" placeholder="Type or paste text to convert to speech..." class="w-full p-4 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
      <div class="mt-1 text-xs text-gray-400"><span id="ttsCharCount">0</span> characters</div>
    </div>

    <!-- Voice Settings -->
    <div class="grid gap-4 sm:grid-cols-3 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Voice</label>
        <select id="ttsVoice" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Speed: <span id="speedVal">1.0</span>x</label>
        <input type="range" id="ttsSpeed" min="0.5" max="2" step="0.1" value="1" class="w-full accent-blue-600" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Pitch: <span id="pitchVal">1.0</span></label>
        <input type="range" id="ttsPitch" min="0.5" max="2" step="0.1" value="1" class="w-full accent-blue-600" />
      </div>
    </div>

    <!-- Controls -->
    <div class="flex gap-2 mb-6">
      <button id="ttsPlay" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors flex items-center gap-2">
        ▶ Speak
      </button>
      <button id="ttsPause" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-sm font-medium rounded-lg transition-colors hidden">
        ⏸ Pause
      </button>
      <button id="ttsResume" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-sm font-medium rounded-lg transition-colors hidden">
        ▶ Resume
      </button>
      <button id="ttsStop" class="px-4 py-2 bg-red-100 hover:bg-red-200 text-red-700 text-sm font-medium rounded-lg transition-colors hidden">
        ■ Stop
      </button>
    </div>

    <!-- Status -->
    <div id="ttsStatus" class="p-3 bg-gray-50 rounded-lg text-sm text-gray-600 hidden"></div>
  </div>

  <script>
    const input = document.getElementById('ttsInput') as HTMLTextAreaElement;
    const voiceSelect = document.getElementById('ttsVoice') as HTMLSelectElement;
    const speedSlider = document.getElementById('ttsSpeed') as HTMLInputElement;
    const pitchSlider = document.getElementById('ttsPitch') as HTMLInputElement;
    const playBtn = document.getElementById('ttsPlay')!;
    const pauseBtn = document.getElementById('ttsPause')!;
    const resumeBtn = document.getElementById('ttsResume')!;
    const stopBtn = document.getElementById('ttsStop')!;
    const status = document.getElementById('ttsStatus')!;

    let voices: SpeechSynthesisVoice[] = [];
    let speaking = false;

    function loadVoices(): void {
      voices = speechSynthesis.getVoices();
      voiceSelect.innerHTML = '';
      voices.forEach((v, i) => {
        const opt = document.createElement('option');
        opt.value = i.toString();
        opt.textContent = `${v.name} (${v.lang})${v.default ? ' ★' : ''}`;
        voiceSelect.appendChild(opt);
      });
      // Default to English
      const enIdx = voices.findIndex(v => v.lang.startsWith('en') && v.default);
      if (enIdx >= 0) voiceSelect.value = enIdx.toString();
    }

    speechSynthesis.onvoiceschanged = loadVoices;
    loadVoices();

    speedSlider.addEventListener('input', () => {
      document.getElementById('speedVal')!.textContent = parseFloat(speedSlider.value).toFixed(1);
    });
    pitchSlider.addEventListener('input', () => {
      document.getElementById('pitchVal')!.textContent = parseFloat(pitchSlider.value).toFixed(1);
    });
    input.addEventListener('input', () => {
      document.getElementById('ttsCharCount')!.textContent = input.value.length.toString();
    });

    function setButtons(state: 'idle' | 'speaking' | 'paused'): void {
      playBtn.classList.toggle('hidden', state !== 'idle');
      pauseBtn.classList.toggle('hidden', state !== 'speaking');
      resumeBtn.classList.toggle('hidden', state !== 'paused');
      stopBtn.classList.toggle('hidden', state === 'idle');
    }

    playBtn.addEventListener('click', () => {
      const text = input.value.trim();
      if (!text) return;
      speechSynthesis.cancel();

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.voice = voices[parseInt(voiceSelect.value)] || null;
      utterance.rate = parseFloat(speedSlider.value);
      utterance.pitch = parseFloat(pitchSlider.value);

      utterance.onstart = () => { setButtons('speaking'); status.classList.remove('hidden'); status.textContent = 'Speaking...'; };
      utterance.onend = () => { setButtons('idle'); status.textContent = 'Done.'; };
      utterance.onerror = () => { setButtons('idle'); status.textContent = 'Error occurred.'; };

      speechSynthesis.speak(utterance);
    });

    pauseBtn.addEventListener('click', () => { speechSynthesis.pause(); setButtons('paused'); status.textContent = 'Paused.'; });
    resumeBtn.addEventListener('click', () => { speechSynthesis.resume(); setButtons('speaking'); status.textContent = 'Speaking...'; });
    stopBtn.addEventListener('click', () => { speechSynthesis.cancel(); setButtons('idle'); status.textContent = 'Stopped.'; });
  </script>

  <Fragment slot="seo-content">
    <h2>Free Text to Speech Online</h2>
    <p>Convert any text to spoken audio using your browser's built-in speech synthesis. Choose from dozens of voices in multiple languages. Adjust speed and pitch.</p>
    <h3>Features</h3>
    <ul>
      <li><strong>Multiple voices</strong> - Choose from system-installed voices in many languages</li>
      <li><strong>Speed control</strong> - Slow down or speed up from 0.5x to 2x</li>
      <li><strong>Pitch control</strong> - Adjust voice pitch for preference</li>
      <li><strong>Play/Pause/Stop</strong> - Full playback controls</li>
    </ul>
    <h3>Use Cases</h3>
    <p>Proofread documents by hearing them read aloud, language learning, accessibility testing, checking pronunciation, creating quick audio content.</p>
  </Fragment>
</ToolLayout>
