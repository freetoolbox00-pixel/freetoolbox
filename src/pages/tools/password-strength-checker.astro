---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Password Strength Checker"
  description="Check how strong your password is. Analyzes entropy, patterns, and crack time. 100% client-side — your password never leaves your device."
  category="security"
  icon="🔒"
>
  <div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Enter password to check</label>
      <div class="relative">
        <input type="text" id="psPass" class="w-full px-3 py-3 border border-gray-300 rounded-lg text-lg font-mono pr-10" placeholder="Type a password..." autocomplete="off" />
      </div>
    </div>

    <div id="psResult" class="hidden">
      <div class="mb-4">
        <div class="flex items-center justify-between mb-1">
          <span class="text-sm font-medium text-gray-700">Strength</span>
          <span id="psLabel" class="text-sm font-medium"></span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-3">
          <div id="psBar" class="h-3 rounded-full transition-all duration-300" style="width:0%"></div>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 mb-4">
        <div class="p-3 bg-gray-50 rounded-lg">
          <div class="text-xs text-gray-500">Entropy</div>
          <div class="text-lg font-bold text-gray-900"><span id="psEntropy">0</span> bits</div>
        </div>
        <div class="p-3 bg-gray-50 rounded-lg">
          <div class="text-xs text-gray-500">Estimated crack time</div>
          <div class="text-lg font-bold text-gray-900" id="psCrack">-</div>
        </div>
      </div>

      <div class="space-y-2 mb-4" id="psCriteria"></div>

      <div id="psSuggestions" class="p-3 bg-yellow-50 border border-yellow-200 rounded-lg hidden">
        <div class="text-sm font-medium text-yellow-800 mb-1">Suggestions</div>
        <ul id="psSugList" class="text-sm text-yellow-700 list-disc pl-4 space-y-0.5"></ul>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const passIn = document.getElementById('psPass') as HTMLInputElement;
  const resultEl = document.getElementById('psResult')!;
  const labelEl = document.getElementById('psLabel')!;
  const barEl = document.getElementById('psBar')!;
  const entropyEl = document.getElementById('psEntropy')!;
  const crackEl = document.getElementById('psCrack')!;
  const criteriaEl = document.getElementById('psCriteria')!;
  const sugEl = document.getElementById('psSuggestions')!;
  const sugList = document.getElementById('psSugList')!;

  function calcEntropy(pw: string): number {
    let pool = 0;
    if (/[a-z]/.test(pw)) pool += 26;
    if (/[A-Z]/.test(pw)) pool += 26;
    if (/[0-9]/.test(pw)) pool += 10;
    if (/[^a-zA-Z0-9]/.test(pw)) pool += 33;
    return pool > 0 ? Math.floor(pw.length * Math.log2(pool)) : 0;
  }

  function crackTime(entropy: number): string {
    const guessesPerSec = 1e10;
    const seconds = Math.pow(2, entropy) / guessesPerSec;
    if (seconds < 1) return 'Instantly';
    if (seconds < 60) return `${Math.round(seconds)} seconds`;
    if (seconds < 3600) return `${Math.round(seconds / 60)} minutes`;
    if (seconds < 86400) return `${Math.round(seconds / 3600)} hours`;
    if (seconds < 31536000) return `${Math.round(seconds / 86400)} days`;
    if (seconds < 31536000 * 1000) return `${Math.round(seconds / 31536000)} years`;
    if (seconds < 31536000 * 1e6) return `${Math.round(seconds / 31536000 / 1000)}K years`;
    if (seconds < 31536000 * 1e9) return `${Math.round(seconds / 31536000 / 1e6)}M years`;
    return `${(seconds / 31536000 / 1e9).toFixed(0)}B+ years`;
  }

  const checks = [
    { label: 'At least 8 characters', test: (p: string) => p.length >= 8 },
    { label: 'At least 12 characters', test: (p: string) => p.length >= 12 },
    { label: 'Lowercase letters (a-z)', test: (p: string) => /[a-z]/.test(p) },
    { label: 'Uppercase letters (A-Z)', test: (p: string) => /[A-Z]/.test(p) },
    { label: 'Numbers (0-9)', test: (p: string) => /[0-9]/.test(p) },
    { label: 'Special characters (!@#$...)', test: (p: string) => /[^a-zA-Z0-9]/.test(p) },
    { label: 'No common patterns (123, abc, qwerty)', test: (p: string) => !/(?:123|abc|qwerty|password|letmein|admin|welcome)/i.test(p) },
    { label: 'No repeated characters (aaa, 111)', test: (p: string) => !/(.)\1{2,}/.test(p) },
  ];

  passIn.addEventListener('input', () => {
    const pw = passIn.value;
    if (!pw) { resultEl.classList.add('hidden'); return; }
    resultEl.classList.remove('hidden');

    const entropy = calcEntropy(pw);
    entropyEl.textContent = String(entropy);
    crackEl.textContent = crackTime(entropy);

    let score = 0;
    const passed = checks.map(c => c.test(pw));
    score = passed.filter(Boolean).length;

    criteriaEl.innerHTML = checks.map((c, i) => `
      <div class="flex items-center gap-2 text-sm">
        <span class="${passed[i] ? 'text-green-500' : 'text-gray-300'}">${passed[i] ? '✓' : '○'}</span>
        <span class="${passed[i] ? 'text-gray-700' : 'text-gray-400'}">${c.label}</span>
      </div>
    `).join('');

    let level: string, color: string, pct: number;
    if (score <= 2) { level = 'Very Weak'; color = 'bg-red-500'; pct = 12; }
    else if (score <= 4) { level = 'Weak'; color = 'bg-orange-500'; pct = 30; }
    else if (score <= 5) { level = 'Fair'; color = 'bg-yellow-500'; pct = 50; }
    else if (score <= 6) { level = 'Good'; color = 'bg-blue-500'; pct = 70; }
    else if (score <= 7) { level = 'Strong'; color = 'bg-green-500'; pct = 85; }
    else { level = 'Very Strong'; color = 'bg-green-600'; pct = 100; }

    labelEl.textContent = level;
    labelEl.className = `text-sm font-medium ${color.replace('bg-', 'text-')}`;
    barEl.className = `h-3 rounded-full transition-all duration-300 ${color}`;
    barEl.style.width = pct + '%';

    const suggestions: string[] = [];
    if (pw.length < 12) suggestions.push('Use at least 12 characters');
    if (!/[A-Z]/.test(pw)) suggestions.push('Add uppercase letters');
    if (!/[0-9]/.test(pw)) suggestions.push('Add numbers');
    if (!/[^a-zA-Z0-9]/.test(pw)) suggestions.push('Add special characters');
    if (/(.)\1{2,}/.test(pw)) suggestions.push('Avoid repeated characters');

    if (suggestions.length) {
      sugEl.classList.remove('hidden');
      sugList.innerHTML = suggestions.map(s => `<li>${s}</li>`).join('');
    } else {
      sugEl.classList.add('hidden');
    }
  });
</script>
