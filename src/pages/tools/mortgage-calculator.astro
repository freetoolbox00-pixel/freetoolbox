---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Mortgage Calculator"
  description="Free mortgage calculator with monthly payment breakdown, property tax and insurance estimates, extra payment analysis, and total cost over the life of the loan."
  category="utility"
  icon="🏠"
>
  <div>
    <!-- Inputs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div class="p-4 bg-white border border-gray-200 rounded-lg">
        <label class="block text-sm font-medium text-gray-700 mb-1">Home Price ($)</label>
        <input type="number" id="homePrice" value="350000" min="0" step="1000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div class="p-4 bg-white border border-gray-200 rounded-lg">
        <label class="block text-sm font-medium text-gray-700 mb-1">Down Payment</label>
        <div class="flex gap-2">
          <input type="number" id="downPayment" value="20" min="0" step="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
          <select id="downPaymentType" class="px-2 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="percent">%</option>
            <option value="dollar">$</option>
          </select>
        </div>
        <div class="text-xs text-gray-400 mt-1">Loan amount: <span id="loanAmountDisplay" class="font-medium">$280,000</span></div>
      </div>
      <div class="p-4 bg-white border border-gray-200 rounded-lg">
        <label class="block text-sm font-medium text-gray-700 mb-1">Interest Rate (%)</label>
        <input type="number" id="mortgageRate" value="6.75" min="0" max="30" step="0.125" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div class="p-4 bg-white border border-gray-200 rounded-lg">
        <label class="block text-sm font-medium text-gray-700 mb-1">Loan Term</label>
        <div class="flex gap-2 flex-wrap">
          <button data-term="15" class="term-btn px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-blue-50 transition-colors">15 yr</button>
          <button data-term="20" class="term-btn px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-blue-50 transition-colors">20 yr</button>
          <button data-term="25" class="term-btn px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-blue-50 transition-colors">25 yr</button>
          <button data-term="30" class="term-btn px-3 py-2 text-sm border border-gray-300 rounded-lg bg-blue-50 border-blue-300 text-blue-700 font-medium transition-colors">30 yr</button>
        </div>
      </div>
    </div>

    <!-- Extra inputs -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
      <div class="p-4 bg-white border border-gray-200 rounded-lg">
        <label class="block text-sm font-medium text-gray-700 mb-1">Property Tax (% / year)</label>
        <input type="number" id="taxRate" value="1.2" min="0" step="0.1" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div class="p-4 bg-white border border-gray-200 rounded-lg">
        <label class="block text-sm font-medium text-gray-700 mb-1">Home Insurance ($ / year)</label>
        <input type="number" id="insurance" value="1500" min="0" step="100" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div class="p-4 bg-white border border-gray-200 rounded-lg">
        <label class="block text-sm font-medium text-gray-700 mb-1">Extra Monthly Payment ($)</label>
        <input type="number" id="extraPayment" value="0" min="0" step="50" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
    </div>

    <!-- Monthly Payment Breakdown -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg mb-4">
      <h3 class="text-sm font-medium text-gray-700 mb-3">Monthly Payment Breakdown</h3>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-center mb-3">
        <div class="p-3 bg-blue-50 rounded-lg">
          <div class="text-xs text-gray-500">Principal & Interest</div>
          <div id="piPayment" class="text-lg font-bold text-blue-600">$0</div>
        </div>
        <div class="p-3 bg-orange-50 rounded-lg">
          <div class="text-xs text-gray-500">Property Tax</div>
          <div id="taxPayment" class="text-lg font-bold text-orange-500">$0</div>
        </div>
        <div class="p-3 bg-green-50 rounded-lg">
          <div class="text-xs text-gray-500">Insurance</div>
          <div id="insPayment" class="text-lg font-bold text-green-600">$0</div>
        </div>
        <div class="p-3 bg-purple-50 rounded-lg">
          <div class="text-xs text-gray-500">Extra</div>
          <div id="extraDisplay" class="text-lg font-bold text-purple-600">$0</div>
        </div>
        <div class="p-3 bg-gray-100 rounded-lg">
          <div class="text-xs text-gray-500">Total Monthly</div>
          <div id="totalMonthly" class="text-lg font-bold text-gray-800">$0</div>
        </div>
      </div>
      <!-- Stacked bar -->
      <div class="flex h-6 rounded-lg overflow-hidden">
        <div id="barPI" class="bg-blue-500 transition-all duration-300"></div>
        <div id="barTax" class="bg-orange-400 transition-all duration-300"></div>
        <div id="barIns" class="bg-green-500 transition-all duration-300"></div>
        <div id="barExtra" class="bg-purple-500 transition-all duration-300"></div>
      </div>
    </div>

    <!-- Total Cost -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
      <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
        <div class="text-xs text-gray-500 mb-1">Total Interest Paid</div>
        <div id="totalInterest" class="text-xl font-bold text-blue-600">$0</div>
      </div>
      <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-center">
        <div class="text-xs text-gray-500 mb-1">Total Cost of Loan</div>
        <div id="totalCost" class="text-xl font-bold text-green-600">$0</div>
      </div>
      <div class="p-4 bg-purple-50 border border-purple-200 rounded-lg text-center">
        <div class="text-xs text-gray-500 mb-1">Payoff Time</div>
        <div id="payoffTime" class="text-xl font-bold text-purple-600">0 yr</div>
      </div>
    </div>

    <!-- Extra Payment Savings -->
    <div id="savingsBox" class="p-4 bg-emerald-50 border border-emerald-200 rounded-lg mb-4 hidden">
      <h3 class="text-sm font-medium text-emerald-700 mb-2">Extra Payment Savings</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <div>Interest saved: <span id="interestSaved" class="font-bold text-emerald-700">$0</span></div>
        <div>Time saved: <span id="timeSaved" class="font-bold text-emerald-700">0 months</span></div>
      </div>
    </div>
  </div>

  <script>
    const fmt = (n: number): string => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    const fmt2 = (n: number): string => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    let termYears = 30;

    function calcMortgage(principal: number, rate: number, months: number, extra: number): { monthly: number; totalInterest: number; totalPaid: number; actualMonths: number } {
      if (principal <= 0 || months <= 0) return { monthly: 0, totalInterest: 0, totalPaid: 0, actualMonths: 0 };
      const mr = rate / 100 / 12;
      let monthly: number;
      if (mr === 0) {
        monthly = principal / months;
      } else {
        monthly = principal * (mr * Math.pow(1 + mr, months)) / (Math.pow(1 + mr, months) - 1);
      }

      let balance = principal;
      let totalInt = 0;
      let m = 0;
      while (balance > 0.01 && m < months * 2) {
        m++;
        const intPay = balance * mr;
        totalInt += intPay;
        const princPay = monthly - intPay + extra;
        balance = Math.max(0, balance - princPay);
      }
      return { monthly, totalInterest: totalInt, totalPaid: principal + totalInt, actualMonths: m };
    }

    function calculate(): void {
      const homePrice = parseFloat((document.getElementById('homePrice') as HTMLInputElement).value) || 0;
      const dpVal = parseFloat((document.getElementById('downPayment') as HTMLInputElement).value) || 0;
      const dpType = (document.getElementById('downPaymentType') as HTMLSelectElement).value;
      const rate = parseFloat((document.getElementById('mortgageRate') as HTMLInputElement).value) || 0;
      const taxRate = parseFloat((document.getElementById('taxRate') as HTMLInputElement).value) || 0;
      const insurance = parseFloat((document.getElementById('insurance') as HTMLInputElement).value) || 0;
      const extra = parseFloat((document.getElementById('extraPayment') as HTMLInputElement).value) || 0;

      const downPayment = dpType === 'percent' ? homePrice * (dpVal / 100) : dpVal;
      const principal = Math.max(0, homePrice - downPayment);
      const months = termYears * 12;

      document.getElementById('loanAmountDisplay')!.textContent = fmt(principal);

      const result = calcMortgage(principal, rate, months, extra);
      const noExtra = calcMortgage(principal, rate, months, 0);

      const monthlyTax = homePrice * (taxRate / 100) / 12;
      const monthlyIns = insurance / 12;
      const totalMonthly = result.monthly + monthlyTax + monthlyIns + extra;

      document.getElementById('piPayment')!.textContent = fmt2(result.monthly);
      document.getElementById('taxPayment')!.textContent = fmt2(monthlyTax);
      document.getElementById('insPayment')!.textContent = fmt2(monthlyIns);
      document.getElementById('extraDisplay')!.textContent = fmt2(extra);
      document.getElementById('totalMonthly')!.textContent = fmt2(totalMonthly);

      // Bar widths
      const total = result.monthly + monthlyTax + monthlyIns + extra || 1;
      (document.getElementById('barPI') as HTMLElement).style.width = (result.monthly / total * 100) + '%';
      (document.getElementById('barTax') as HTMLElement).style.width = (monthlyTax / total * 100) + '%';
      (document.getElementById('barIns') as HTMLElement).style.width = (monthlyIns / total * 100) + '%';
      (document.getElementById('barExtra') as HTMLElement).style.width = (extra / total * 100) + '%';

      document.getElementById('totalInterest')!.textContent = fmt(result.totalInterest);
      document.getElementById('totalCost')!.textContent = fmt(result.totalPaid);

      const yrs = Math.floor(result.actualMonths / 12);
      const mos = result.actualMonths % 12;
      document.getElementById('payoffTime')!.textContent = yrs + ' yr' + (mos > 0 ? ' ' + mos + ' mo' : '');

      // Savings
      const savingsBox = document.getElementById('savingsBox')!;
      if (extra > 0) {
        savingsBox.classList.remove('hidden');
        const saved = noExtra.totalInterest - result.totalInterest;
        const timeSavedMo = noExtra.actualMonths - result.actualMonths;
        document.getElementById('interestSaved')!.textContent = fmt(saved);
        document.getElementById('timeSaved')!.textContent = timeSavedMo + ' months';
      } else {
        savingsBox.classList.add('hidden');
      }
    }

    // Term buttons
    document.querySelectorAll('.term-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        termYears = parseInt((btn as HTMLElement).dataset.term || '30');
        document.querySelectorAll('.term-btn').forEach(b => {
          b.className = 'term-btn px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-blue-50 transition-colors';
        });
        btn.className = 'term-btn px-3 py-2 text-sm border rounded-lg bg-blue-50 border-blue-300 text-blue-700 font-medium transition-colors';
        calculate();
      });
    });

    ['homePrice', 'downPayment', 'downPaymentType', 'mortgageRate', 'taxRate', 'insurance', 'extraPayment'].forEach(id =>
      document.getElementById(id)!.addEventListener('input', calculate)
    );
    calculate();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Mortgage Calculator</h2>
    <p>Estimate your monthly mortgage payment with a detailed breakdown of principal, interest, property tax, and insurance. Compare different loan terms, see how extra payments reduce your payoff time and interest, and understand the true total cost of your home loan.</p>
  </Fragment>
</ToolLayout>
