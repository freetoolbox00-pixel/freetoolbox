---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Robots.txt Generator"
  description="Generate robots.txt files for your website. Control which pages search engines can crawl. Free robots.txt generator with templates."
  category="seo"
  icon="🤖"
>
  <div>
    <!-- Quick Templates -->
    <div class="mb-6">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Templates</h3>
      <div class="flex flex-wrap gap-2">
        <button class="robot-tpl px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-tpl="allow-all">Allow All</button>
        <button class="robot-tpl px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-tpl="block-all">Block All</button>
        <button class="robot-tpl px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-tpl="wordpress">WordPress</button>
        <button class="robot-tpl px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-tpl="ecommerce">E-commerce</button>
        <button class="robot-tpl px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-tpl="block-ai">Block AI Bots</button>
      </div>
    </div>

    <!-- Builder -->
    <div class="space-y-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">User-agent</label>
        <select id="robotAgent" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="*">* (All bots)</option>
          <option value="Googlebot">Googlebot</option>
          <option value="Bingbot">Bingbot</option>
          <option value="GPTBot">GPTBot (ChatGPT)</option>
          <option value="CCBot">CCBot (Common Crawl)</option>
          <option value="anthropic-ai">Anthropic AI</option>
          <option value="custom">Custom...</option>
        </select>
        <input type="text" id="customAgent" class="hidden mt-2 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Custom user-agent" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Disallowed Paths (one per line)</label>
        <textarea id="robotDisallow" rows="4" placeholder="/admin/&#10;/private/&#10;/api/" class="w-full p-3 font-mono text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Allowed Paths (one per line)</label>
        <textarea id="robotAllow" rows="2" placeholder="/public/" class="w-full p-3 font-mono text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Sitemap URL</label>
        <input type="url" id="robotSitemap" placeholder="https://example.com/sitemap.xml" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Crawl-delay (seconds)</label>
        <input type="number" id="robotDelay" min="0" max="60" value="" placeholder="Optional" class="w-24 px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>

      <button id="addRule" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Add Rule</button>
    </div>

    <!-- Output -->
    <div>
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-medium text-gray-700">robots.txt</h3>
        <button id="copyRobots" class="px-3 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded">Copy</button>
      </div>
      <textarea id="robotOutput" rows="12" class="w-full p-4 font-mono text-sm bg-gray-900 text-green-400 rounded-lg resize-y"></textarea>
    </div>
  </div>

  <script>
    const output = document.getElementById('robotOutput') as HTMLTextAreaElement;

    const TEMPLATES: Record<string, string> = {
      'allow-all': `User-agent: *\nAllow: /\n\nSitemap: https://example.com/sitemap.xml`,
      'block-all': `User-agent: *\nDisallow: /`,
      'wordpress': `User-agent: *\nDisallow: /wp-admin/\nDisallow: /wp-includes/\nDisallow: /wp-content/plugins/\nDisallow: /wp-content/cache/\nDisallow: /trackback/\nDisallow: /feed/\nDisallow: /comments/\nAllow: /wp-admin/admin-ajax.php\n\nSitemap: https://example.com/sitemap.xml`,
      'ecommerce': `User-agent: *\nDisallow: /cart/\nDisallow: /checkout/\nDisallow: /account/\nDisallow: /search?\nDisallow: /api/\nDisallow: /admin/\nDisallow: /*?sort=\nDisallow: /*?filter=\nAllow: /\n\nSitemap: https://example.com/sitemap.xml`,
      'block-ai': `User-agent: GPTBot\nDisallow: /\n\nUser-agent: ChatGPT-User\nDisallow: /\n\nUser-agent: CCBot\nDisallow: /\n\nUser-agent: anthropic-ai\nDisallow: /\n\nUser-agent: Google-Extended\nDisallow: /\n\nUser-agent: *\nAllow: /\n\nSitemap: https://example.com/sitemap.xml`
    };

    document.querySelectorAll('.robot-tpl').forEach(btn => {
      btn.addEventListener('click', () => {
        output.value = TEMPLATES[(btn as HTMLElement).dataset.tpl!] || '';
      });
    });

    document.getElementById('robotAgent')!.addEventListener('change', () => {
      const v = (document.getElementById('robotAgent') as HTMLSelectElement).value;
      document.getElementById('customAgent')!.classList.toggle('hidden', v !== 'custom');
    });

    document.getElementById('addRule')!.addEventListener('click', () => {
      const agentSel = (document.getElementById('robotAgent') as HTMLSelectElement).value;
      const agent = agentSel === 'custom' ? (document.getElementById('customAgent') as HTMLInputElement).value : agentSel;
      const disallow = (document.getElementById('robotDisallow') as HTMLTextAreaElement).value.split('\n').filter(l => l.trim());
      const allow = (document.getElementById('robotAllow') as HTMLTextAreaElement).value.split('\n').filter(l => l.trim());
      const sitemap = (document.getElementById('robotSitemap') as HTMLInputElement).value.trim();
      const delay = (document.getElementById('robotDelay') as HTMLInputElement).value;

      let rule = `User-agent: ${agent}\n`;
      disallow.forEach(p => rule += `Disallow: ${p.trim()}\n`);
      allow.forEach(p => rule += `Allow: ${p.trim()}\n`);
      if (delay) rule += `Crawl-delay: ${delay}\n`;

      let current = output.value.trim();
      if (current) current += '\n\n';
      current += rule;
      if (sitemap && !current.includes('Sitemap:')) current += `\nSitemap: ${sitemap}`;
      output.value = current;
    });

    document.getElementById('copyRobots')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(output.value);
    });

    output.value = TEMPLATES['allow-all'];
  </script>

  <Fragment slot="seo-content">
    <h2>Free Robots.txt Generator</h2>
    <p>Create robots.txt files to control how search engines crawl your website. Use templates for WordPress, e-commerce or AI bot blocking. Add custom rules for specific crawlers.</p>
    <h3>What is robots.txt?</h3>
    <p>The robots.txt file tells search engine crawlers which pages they can and cannot access on your website. It's placed at the root of your domain (example.com/robots.txt).</p>
  </Fragment>
</ToolLayout>
