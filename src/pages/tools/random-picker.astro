---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Random Picker & Spinner" description="Pick random items from a list. Spin the wheel to decide. Coin flip, dice roll, random choice maker." category="utility" icon="🎰">
  <div>
    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-3">Random List Picker</h3>
        <textarea id="rpList" rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm mb-2" placeholder="Enter items, one per line&#10;Pizza&#10;Sushi&#10;Tacos&#10;Burgers"></textarea>
        <div class="flex gap-2 mb-3">
          <button id="rpPick" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 font-medium">Pick Random</button>
          <input type="number" id="rpCount" min="1" max="50" value="1" class="w-16 px-2 py-2 border border-gray-300 rounded-lg text-sm" />
        </div>
        <div id="rpResult" class="hidden p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
          <div class="text-xs text-blue-600 mb-1">Winner</div>
          <div id="rpWinner" class="text-2xl font-bold text-blue-800"></div>
        </div>
      </div>
      <div class="space-y-6">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Coin Flip</h3>
          <div class="flex items-center gap-3">
            <button id="rpCoin" class="px-6 py-3 bg-yellow-500 text-white rounded-full text-lg font-bold hover:bg-yellow-600 transition-transform">🪙 Flip</button>
            <div id="rpCoinResult" class="text-2xl font-bold text-gray-900"></div>
          </div>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Dice Roll</h3>
          <div class="flex items-center gap-3">
            <select id="rpDice" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="6">D6</option>
              <option value="4">D4</option>
              <option value="8">D8</option>
              <option value="10">D10</option>
              <option value="12">D12</option>
              <option value="20">D20</option>
              <option value="100">D100</option>
            </select>
            <button id="rpRoll" class="px-6 py-3 bg-purple-600 text-white rounded-lg font-bold hover:bg-purple-700">🎲 Roll</button>
            <div id="rpDiceResult" class="text-3xl font-bold text-purple-700"></div>
          </div>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Yes or No</h3>
          <div class="flex items-center gap-3">
            <button id="rpYesNo" class="px-6 py-3 bg-green-600 text-white rounded-lg font-bold hover:bg-green-700">Ask</button>
            <div id="rpYnResult" class="text-2xl font-bold"></div>
          </div>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Random Color</h3>
          <div class="flex items-center gap-3">
            <button id="rpColor" class="px-6 py-3 bg-gray-800 text-white rounded-lg font-bold hover:bg-gray-900">🎨 Generate</button>
            <div id="rpColorBox" class="w-12 h-12 rounded-lg border border-gray-200"></div>
            <div id="rpColorVal" class="font-mono text-sm font-medium"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const listArea = document.getElementById('rpList') as HTMLTextAreaElement;
  const pickBtn = document.getElementById('rpPick')!;
  const countIn = document.getElementById('rpCount') as HTMLInputElement;
  const resultEl = document.getElementById('rpResult')!;
  const winnerEl = document.getElementById('rpWinner')!;

  pickBtn.addEventListener('click', () => {
    const items = listArea.value.split('\n').map(s => s.trim()).filter(Boolean);
    if (!items.length) return;
    const n = Math.min(parseInt(countIn.value) || 1, items.length);
    const shuffled = [...items].sort(() => Math.random() - 0.5);
    const picks = shuffled.slice(0, n);
    winnerEl.textContent = picks.join(', ');
    resultEl.classList.remove('hidden');
    resultEl.classList.add('animate-pulse');
    setTimeout(() => resultEl.classList.remove('animate-pulse'), 1000);
  });

  document.getElementById('rpCoin')!.addEventListener('click', () => {
    const r = Math.random() < 0.5 ? 'Heads! 🪙' : 'Tails! 🪙';
    document.getElementById('rpCoinResult')!.textContent = r;
  });

  document.getElementById('rpRoll')!.addEventListener('click', () => {
    const sides = parseInt((document.getElementById('rpDice') as HTMLSelectElement).value);
    const r = Math.floor(Math.random() * sides) + 1;
    document.getElementById('rpDiceResult')!.textContent = String(r);
  });

  document.getElementById('rpYesNo')!.addEventListener('click', () => {
    const answers = ['Yes ✓', 'No ✗', 'Maybe 🤔', 'Definitely! ✓', 'Absolutely not ✗', 'Ask again later 🔮'];
    const r = answers[Math.floor(Math.random() * answers.length)];
    const el = document.getElementById('rpYnResult')!;
    el.textContent = r;
    el.className = 'text-2xl font-bold ' + (r.includes('✓') ? 'text-green-600' : r.includes('✗') ? 'text-red-600' : 'text-yellow-600');
  });

  document.getElementById('rpColor')!.addEventListener('click', () => {
    const hex = '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0');
    document.getElementById('rpColorBox')!.style.backgroundColor = hex;
    document.getElementById('rpColorVal')!.textContent = hex.toUpperCase();
  });
</script>
