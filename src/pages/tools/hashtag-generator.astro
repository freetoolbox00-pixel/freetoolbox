---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Hashtag Generator" description="Generate relevant hashtags for Instagram, Twitter/X, TikTok and LinkedIn. Copy with one click." category="seo" icon="#️⃣">
  <div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Enter your topic or keywords</label>
      <input type="text" id="hgInput" class="w-full px-3 py-3 border border-gray-300 rounded-lg text-lg" placeholder="e.g. fitness, travel, food photography" />
    </div>
    <div class="flex gap-3 mb-4">
      <button class="hg-cat px-3 py-1.5 border border-blue-500 bg-blue-50 text-blue-700 rounded-lg text-sm font-medium" data-cat="general">General</button>
      <button class="hg-cat px-3 py-1.5 border border-gray-300 rounded-lg text-sm hover:border-gray-400" data-cat="business">Business</button>
      <button class="hg-cat px-3 py-1.5 border border-gray-300 rounded-lg text-sm hover:border-gray-400" data-cat="lifestyle">Lifestyle</button>
      <button class="hg-cat px-3 py-1.5 border border-gray-300 rounded-lg text-sm hover:border-gray-400" data-cat="tech">Tech</button>
    </div>
    <button id="hgGen" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium mb-4">Generate Hashtags</button>
    <div id="hgResult" class="hidden">
      <div class="flex justify-between mb-2"><span class="text-sm font-medium text-gray-700"><span id="hgCount">0</span> hashtags</span><button id="hgCopy" class="text-xs text-blue-600 hover:underline">Copy All</button></div>
      <div id="hgTags" class="flex flex-wrap gap-2 p-4 bg-gray-50 rounded-lg border border-gray-200"></div>
    </div>
  </div>
</ToolLayout>

<script>
  const DB: Record<string, string[]> = {
    general: ['love','instagood','photooftheday','beautiful','happy','cute','fashion','followme','like4like','art','style','amazing','photography','nature','travel','fitness','food','life','beauty','fun','smile','family','photo','music','cool','friends','follow','selfie','summer','instadaily'],
    business: ['entrepreneur','business','motivation','success','marketing','startup','money','mindset','inspiration','hustle','goals','leadership','branding','smallbusiness','digitalmarketing','socialmedia','growth','strategy','innovation','networking','ecommerce','ceo','wealth','profit','productivity'],
    lifestyle: ['lifestyle','fitness','healthy','wellness','workout','yoga','meditation','selfcare','mindfulness','nutrition','vegan','organic','cleaneating','homemade','diy','interior','decor','fashion','ootd','beauty','skincare','travel','adventure','explore','nature','sunset','beach'],
    tech: ['technology','coding','programming','developer','webdev','javascript','python','ai','machinelearning','datascience','cybersecurity','cloud','devops','software','tech','innovation','startup','saas','api','frontend','backend','react','nodejs','database','opensource','github'],
  };

  const genBtn = document.getElementById('hgGen')!;
  const resultEl = document.getElementById('hgResult')!;
  const tagsEl = document.getElementById('hgTags')!;
  const countEl = document.getElementById('hgCount')!;
  let currentCat = 'general';

  document.querySelectorAll('.hg-cat').forEach(btn => btn.addEventListener('click', () => {
    document.querySelectorAll('.hg-cat').forEach(b => { b.className = 'hg-cat px-3 py-1.5 border border-gray-300 rounded-lg text-sm hover:border-gray-400'; });
    (btn as HTMLElement).className = 'hg-cat px-3 py-1.5 border border-blue-500 bg-blue-50 text-blue-700 rounded-lg text-sm font-medium';
    currentCat = (btn as HTMLElement).dataset.cat!;
  }));

  genBtn.addEventListener('click', () => {
    const input = (document.getElementById('hgInput') as HTMLInputElement).value.trim();
    const keywords = input.split(/[,\s]+/).filter(Boolean).map(w => w.toLowerCase().replace(/[^a-z0-9]/g, ''));

    const tags = new Set<string>();
    keywords.forEach(k => { if (k) tags.add(k); });
    keywords.forEach(k => {
      if (k) {
        tags.add(k + 'life'); tags.add(k + 'lover'); tags.add(k + 'daily');
        tags.add(k + 'goals'); tags.add('best' + k);
      }
    });

    const catTags = DB[currentCat] || DB.general;
    const shuffled = [...catTags].sort(() => Math.random() - 0.5);
    shuffled.slice(0, 15).forEach(t => tags.add(t));

    const tagArr = Array.from(tags).slice(0, 30);
    countEl.textContent = String(tagArr.length);
    tagsEl.innerHTML = tagArr.map(t => `<span class="px-3 py-1.5 bg-blue-100 text-blue-700 rounded-full text-sm cursor-pointer hover:bg-blue-200" onclick="navigator.clipboard.writeText('#${t}');this.textContent='Copied!';setTimeout(()=>this.textContent='#${t}',800)">#${t}</span>`).join('');
    resultEl.classList.remove('hidden');
  });

  document.getElementById('hgCopy')!.addEventListener('click', () => {
    const tags = Array.from(tagsEl.querySelectorAll('span')).map(s => s.textContent).join(' ');
    navigator.clipboard.writeText(tags);
    const btn = document.getElementById('hgCopy')!;
    btn.textContent = 'Copied!'; setTimeout(() => { btn.textContent = 'Copy All'; }, 1500);
  });
</script>
