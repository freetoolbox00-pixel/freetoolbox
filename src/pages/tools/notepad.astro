---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Online Notepad" description="Simple online notepad with auto-save. Write notes, count words, download as TXT. No signup needed." category="utility" icon="📝">
  <div>
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <button id="npBold" class="px-2 py-1 bg-gray-100 rounded text-sm font-bold hover:bg-gray-200" title="Bold">B</button>
      <button id="npItalic" class="px-2 py-1 bg-gray-100 rounded text-sm italic hover:bg-gray-200" title="Italic">I</button>
      <button id="npUl" class="px-2 py-1 bg-gray-100 rounded text-sm hover:bg-gray-200" title="Bullet List">• List</button>
      <div class="flex-1"></div>
      <select id="npFont" class="px-2 py-1 border border-gray-300 rounded text-sm">
        <option value="sans-serif">Sans-serif</option>
        <option value="serif">Serif</option>
        <option value="monospace">Monospace</option>
      </select>
      <select id="npSize" class="px-2 py-1 border border-gray-300 rounded text-sm">
        <option value="14">14px</option>
        <option value="16" selected>16px</option>
        <option value="18">18px</option>
        <option value="20">20px</option>
        <option value="24">24px</option>
      </select>
    </div>
    <textarea id="npArea" class="w-full px-4 py-3 border border-gray-300 rounded-lg resize-y" style="min-height:400px;font-size:16px;line-height:1.7;font-family:sans-serif;" placeholder="Start typing your notes here..."></textarea>
    <div class="flex flex-wrap items-center justify-between mt-3 gap-2">
      <div class="flex gap-4 text-xs text-gray-500">
        <span>Words: <strong id="npWords">0</strong></span>
        <span>Characters: <strong id="npChars">0</strong></span>
        <span>Lines: <strong id="npLines">0</strong></span>
      </div>
      <div class="flex gap-2">
        <span id="npSaved" class="text-xs text-green-600 hidden">✓ Auto-saved</span>
        <button id="npClear" class="px-3 py-1.5 bg-red-100 text-red-700 rounded-lg text-xs hover:bg-red-200">Clear</button>
        <button id="npCopy" class="px-3 py-1.5 bg-gray-100 rounded-lg text-xs hover:bg-gray-200">Copy</button>
        <button id="npDl" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-xs hover:bg-blue-700">Download .txt</button>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const area = document.getElementById('npArea') as HTMLTextAreaElement;
  const wordsEl = document.getElementById('npWords')!;
  const charsEl = document.getElementById('npChars')!;
  const linesEl = document.getElementById('npLines')!;
  const savedEl = document.getElementById('npSaved')!;

  const saved = localStorage.getItem('ftb_notepad');
  if (saved) area.value = saved;

  let saveTimer: number;

  function updateStats() {
    const text = area.value;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    wordsEl.textContent = String(words);
    charsEl.textContent = String(text.length);
    linesEl.textContent = String(text.split('\n').length);
  }

  function autoSave() {
    localStorage.setItem('ftb_notepad', area.value);
    savedEl.classList.remove('hidden');
    setTimeout(() => savedEl.classList.add('hidden'), 2000);
  }

  area.addEventListener('input', () => {
    updateStats();
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(autoSave, 1000);
  });

  document.getElementById('npFont')!.addEventListener('change', (e) => {
    area.style.fontFamily = (e.target as HTMLSelectElement).value;
  });

  document.getElementById('npSize')!.addEventListener('change', (e) => {
    area.style.fontSize = (e.target as HTMLSelectElement).value + 'px';
  });

  document.getElementById('npBold')!.addEventListener('click', () => {
    const isBold = area.style.fontWeight === 'bold';
    area.style.fontWeight = isBold ? 'normal' : 'bold';
  });

  document.getElementById('npItalic')!.addEventListener('click', () => {
    const isItalic = area.style.fontStyle === 'italic';
    area.style.fontStyle = isItalic ? 'normal' : 'italic';
  });

  document.getElementById('npUl')!.addEventListener('click', () => {
    const start = area.selectionStart;
    const end = area.selectionEnd;
    const selected = area.value.substring(start, end);
    if (selected) {
      const bulleted = selected.split('\n').map(l => l.trim() ? '• ' + l.replace(/^[•\-]\s*/, '') : l).join('\n');
      area.value = area.value.substring(0, start) + bulleted + area.value.substring(end);
    } else {
      const before = area.value.substring(0, start);
      area.value = before + '• ' + area.value.substring(start);
      area.selectionStart = area.selectionEnd = start + 2;
    }
    area.focus();
    updateStats();
  });

  document.getElementById('npClear')!.addEventListener('click', () => {
    if (area.value && !confirm('Clear all notes?')) return;
    area.value = '';
    localStorage.removeItem('ftb_notepad');
    updateStats();
  });

  document.getElementById('npCopy')!.addEventListener('click', () => {
    navigator.clipboard.writeText(area.value);
    const btn = document.getElementById('npCopy')!;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
  });

  document.getElementById('npDl')!.addEventListener('click', () => {
    const blob = new Blob([area.value], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'notes.txt';
    a.click();
  });

  updateStats();
</script>
