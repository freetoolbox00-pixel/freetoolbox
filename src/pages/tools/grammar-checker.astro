---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Grammar Checker"
  description="Check your text for common grammar, spelling and style mistakes. Free online grammar checker — 100% client-side, no data sent to servers."
  category="text"
  icon="✅"
>
  <div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Enter your text</label>
      <textarea id="gcInput" rows="10" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm resize-y" placeholder="Type or paste your text here..."></textarea>
      <div class="flex justify-between mt-1">
        <span class="text-xs text-gray-400"><span id="gcWords">0</span> words</span>
        <button id="gcClear" class="text-xs text-gray-400 hover:text-gray-600">Clear</button>
      </div>
    </div>

    <div class="flex gap-3 mb-6">
      <button id="gcCheck" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">Check Grammar</button>
    </div>

    <div id="gcResult" class="hidden">
      <div class="flex items-center gap-3 mb-4">
        <div id="gcScore" class="px-3 py-1 rounded text-sm font-medium"></div>
        <div class="text-sm text-gray-500"><span id="gcIssues">0</span> issues found</div>
      </div>

      <div id="gcList" class="space-y-3 mb-6"></div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-medium text-gray-700">Corrected text</label>
          <button id="gcCopy" class="text-xs text-blue-600 hover:underline">Copy</button>
        </div>
        <div id="gcCorrected" class="p-4 bg-green-50 border border-green-200 rounded-lg text-sm leading-relaxed whitespace-pre-wrap"></div>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const input = document.getElementById('gcInput') as HTMLTextAreaElement;
  const wordsEl = document.getElementById('gcWords')!;
  const checkBtn = document.getElementById('gcCheck')!;
  const clearBtn = document.getElementById('gcClear')!;
  const resultEl = document.getElementById('gcResult')!;
  const scoreEl = document.getElementById('gcScore')!;
  const issuesEl = document.getElementById('gcIssues')!;
  const listEl = document.getElementById('gcList')!;
  const correctedEl = document.getElementById('gcCorrected')!;
  const copyBtn = document.getElementById('gcCopy')!;

  input.addEventListener('input', () => {
    wordsEl.textContent = String(input.value.trim().split(/\s+/).filter(Boolean).length);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    wordsEl.textContent = '0';
    resultEl.classList.add('hidden');
  });

  interface Issue {
    type: 'grammar' | 'spelling' | 'style';
    match: string;
    replacement: string;
    reason: string;
    index: number;
  }

  const RULES: { pattern: RegExp; type: Issue['type']; replacement: (m: RegExpMatchArray) => string; reason: string }[] = [
    // Double words
    { pattern: /\b(\w+)\s+\1\b/gi, type: 'grammar', replacement: m => m[1], reason: 'Repeated word' },
    // a/an
    { pattern: /\ba\s+([aeiou])/gi, type: 'grammar', replacement: m => `an ${m[1]}`, reason: 'Use "an" before vowel sounds' },
    { pattern: /\ban\s+([bcdfghjklmnpqrstvwxyz])/gi, type: 'grammar', replacement: m => `a ${m[1]}`, reason: 'Use "a" before consonant sounds' },
    // Common misspellings
    { pattern: /\bteh\b/gi, type: 'spelling', replacement: () => 'the', reason: 'Common misspelling of "the"' },
    { pattern: /\brecieve\b/gi, type: 'spelling', replacement: () => 'receive', reason: 'Correct spelling: "receive"' },
    { pattern: /\boccured\b/gi, type: 'spelling', replacement: () => 'occurred', reason: 'Correct spelling: "occurred"' },
    { pattern: /\bseperate\b/gi, type: 'spelling', replacement: () => 'separate', reason: 'Correct spelling: "separate"' },
    { pattern: /\bdefinately\b/gi, type: 'spelling', replacement: () => 'definitely', reason: 'Correct spelling: "definitely"' },
    { pattern: /\boccasionaly\b/gi, type: 'spelling', replacement: () => 'occasionally', reason: 'Correct spelling: "occasionally"' },
    { pattern: /\bneccessary\b/gi, type: 'spelling', replacement: () => 'necessary', reason: 'Correct spelling: "necessary"' },
    { pattern: /\baccommodate\b/gi, type: 'spelling', replacement: () => 'accommodate', reason: 'Correct spelling: "accommodate"' },
    { pattern: /\bwich\b/gi, type: 'spelling', replacement: () => 'which', reason: 'Correct spelling: "which"' },
    { pattern: /\bthere\s+(is|are|was|were)\s+alot\b/gi, type: 'spelling', replacement: m => `there ${m[1]} a lot`, reason: '"A lot" is two words' },
    { pattern: /\balot\b/gi, type: 'spelling', replacement: () => 'a lot', reason: '"A lot" is two words' },
    // its/it's
    { pattern: /\bits\s+(a|an|the|very|not|been|going|just|also)\b/gi, type: 'grammar', replacement: m => `it's ${m[1]}`, reason: '"It\'s" = "it is"; "its" = possessive' },
    // their/there/they're
    { pattern: /\btheir\s+(is|are|was|were)\b/gi, type: 'grammar', replacement: m => `there ${m[1]}`, reason: '"There" for location/existence; "their" for possession' },
    // your/you're
    { pattern: /\byour\s+(a|an|the|very|not|going|being|right|wrong|welcome)\b/gi, type: 'grammar', replacement: m => `you're ${m[1]}`, reason: '"You\'re" = "you are"; "your" = possessive' },
    // then/than
    { pattern: /\b(more|less|better|worse|bigger|smaller|faster|slower|rather)\s+then\b/gi, type: 'grammar', replacement: m => `${m[1]} than`, reason: '"Than" for comparisons; "then" for time' },
    // Double spaces
    { pattern: /  +/g, type: 'style', replacement: () => ' ', reason: 'Multiple spaces' },
    // No space after period
    { pattern: /\.([A-Z])/g, type: 'style', replacement: m => `. ${m[1]}`, reason: 'Missing space after period' },
    // Capitalize first letter of sentence
    { pattern: /(?:^|[.!?]\s+)([a-z])/g, type: 'style', replacement: m => m[0].slice(0, -1) + m[1].toUpperCase(), reason: 'Capitalize first letter of sentence' },
    // could of → could have
    { pattern: /\b(could|would|should|must|might)\s+of\b/gi, type: 'grammar', replacement: m => `${m[1]} have`, reason: `"${'{m[1]}'} of" should be "${'{m[1]}'} have"` },
    // Ending with preposition (style suggestion)
    { pattern: /\bwho\s+.{5,30}\s+(to|for|with|at)\s*[.?!]/gi, type: 'style', replacement: m => m[0], reason: 'Sentence may end with a preposition (consider rephrasing)' },
  ];

  function checkGrammar(text: string): Issue[] {
    const issues: Issue[] = [];

    for (const rule of RULES) {
      let match;
      const regex = new RegExp(rule.pattern.source, rule.pattern.flags);
      while ((match = regex.exec(text)) !== null) {
        const repl = rule.replacement(match);
        if (repl !== match[0]) {
          issues.push({
            type: rule.type,
            match: match[0],
            replacement: repl,
            reason: rule.reason,
            index: match.index,
          });
        }
      }
    }

    // Sort by position, deduplicate overlapping
    issues.sort((a, b) => a.index - b.index);
    const filtered: Issue[] = [];
    let lastEnd = -1;
    for (const issue of issues) {
      if (issue.index >= lastEnd) {
        filtered.push(issue);
        lastEnd = issue.index + issue.match.length;
      }
    }

    return filtered;
  }

  function applyFixes(text: string, issues: Issue[]): string {
    let result = '';
    let cursor = 0;
    for (const issue of issues) {
      result += text.slice(cursor, issue.index) + issue.replacement;
      cursor = issue.index + issue.match.length;
    }
    result += text.slice(cursor);
    return result;
  }

  checkBtn.addEventListener('click', () => {
    const text = input.value;
    if (!text.trim()) return;

    const issues = checkGrammar(text);
    const corrected = applyFixes(text, issues);

    issuesEl.textContent = String(issues.length);

    if (issues.length === 0) {
      scoreEl.textContent = '✓ No issues found';
      scoreEl.className = 'px-3 py-1 rounded text-sm font-medium bg-green-100 text-green-700';
    } else if (issues.length <= 3) {
      scoreEl.textContent = '⚠ Minor issues';
      scoreEl.className = 'px-3 py-1 rounded text-sm font-medium bg-yellow-100 text-yellow-700';
    } else {
      scoreEl.textContent = '✗ Multiple issues';
      scoreEl.className = 'px-3 py-1 rounded text-sm font-medium bg-red-100 text-red-700';
    }

    const typeColors: Record<string, string> = {
      grammar: 'bg-red-50 border-red-200 text-red-700',
      spelling: 'bg-orange-50 border-orange-200 text-orange-700',
      style: 'bg-yellow-50 border-yellow-200 text-yellow-700',
    };
    const typeBadge: Record<string, string> = {
      grammar: 'bg-red-100 text-red-600',
      spelling: 'bg-orange-100 text-orange-600',
      style: 'bg-yellow-100 text-yellow-600',
    };

    listEl.innerHTML = issues.map(issue => `
      <div class="p-3 rounded-lg border ${typeColors[issue.type]}">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs px-2 py-0.5 rounded ${typeBadge[issue.type]} font-medium">${issue.type}</span>
          <span class="text-xs">${issue.reason}</span>
        </div>
        <div class="text-sm">
          <span class="line-through opacity-60">${issue.match}</span> → <span class="font-medium">${issue.replacement}</span>
        </div>
      </div>
    `).join('');

    correctedEl.textContent = corrected;
    resultEl.classList.remove('hidden');
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(correctedEl.textContent || '');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
  });
</script>
