---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Sales Tax Calculator"
  description="Free sales tax calculator. Calculate tax amount and total price, reverse-calculate pre-tax price, use state tax presets, and calculate bulk items with different tax rates."
  category="utility"
  icon="🧾"
>
  <div>
    <!-- Mode Tabs -->
    <div class="flex gap-1 mb-4 bg-gray-100 rounded-lg p-1">
      <button id="tabStandard" class="mode-tab flex-1 px-3 py-2 text-sm font-medium rounded-md bg-white shadow text-blue-600 transition-colors">Standard</button>
      <button id="tabReverse" class="mode-tab flex-1 px-3 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-800 transition-colors">Reverse</button>
      <button id="tabBulk" class="mode-tab flex-1 px-3 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-800 transition-colors">Bulk</button>
    </div>

    <!-- Standard Mode -->
    <div id="standardMode">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <label class="block text-sm font-medium text-gray-700 mb-1">Pre-Tax Price ($)</label>
          <input type="number" id="preTaxPrice" value="100" min="0" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <label class="block text-sm font-medium text-gray-700 mb-1">Tax Rate (%)</label>
          <input type="number" id="taxRate" value="8.25" min="0" max="100" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </div>
      </div>

      <!-- State Presets -->
      <div class="p-4 bg-white border border-gray-200 rounded-lg mb-4">
        <h3 class="text-sm font-medium text-gray-700 mb-2">Common US State Rates</h3>
        <div class="flex gap-2 flex-wrap" id="statePresets"></div>
      </div>

      <!-- Results -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 bg-orange-50 border border-orange-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Tax Amount</div>
          <div id="taxAmount" class="text-2xl font-bold text-orange-600">$0.00</div>
        </div>
        <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Total Price</div>
          <div id="totalPrice" class="text-2xl font-bold text-blue-600">$0.00</div>
        </div>
        <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Effective Rate</div>
          <div id="effectiveRate" class="text-2xl font-bold text-green-600">0%</div>
        </div>
      </div>
    </div>

    <!-- Reverse Mode -->
    <div id="reverseMode" class="hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <label class="block text-sm font-medium text-gray-700 mb-1">Total Price (with tax) ($)</label>
          <input type="number" id="revTotal" value="108.25" min="0" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <label class="block text-sm font-medium text-gray-700 mb-1">Tax Rate (%)</label>
          <input type="number" id="revTaxRate" value="8.25" min="0" max="100" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Pre-Tax Price</div>
          <div id="revPreTax" class="text-2xl font-bold text-blue-600">$0.00</div>
        </div>
        <div class="p-4 bg-orange-50 border border-orange-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Tax Amount</div>
          <div id="revTaxAmount" class="text-2xl font-bold text-orange-600">$0.00</div>
        </div>
        <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Tax Rate</div>
          <div id="revRateDisplay" class="text-2xl font-bold text-green-600">0%</div>
        </div>
      </div>
    </div>

    <!-- Bulk Mode -->
    <div id="bulkMode" class="hidden">
      <div class="p-4 bg-white border border-gray-200 rounded-lg mb-4">
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-sm font-medium text-gray-700">Items</h3>
          <div class="flex gap-2 items-center">
            <label class="text-xs text-gray-500">Default tax rate:</label>
            <input type="number" id="bulkDefaultRate" value="8.25" min="0" max="100" step="0.01" class="w-20 px-2 py-1 border border-gray-300 rounded text-sm text-center" />
            <span class="text-xs text-gray-500">%</span>
          </div>
        </div>
        <div id="bulkItems" class="space-y-2"></div>
        <button id="addItem" class="mt-3 px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">+ Add Item</button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Subtotal</div>
          <div id="bulkSubtotal" class="text-2xl font-bold text-blue-600">$0.00</div>
        </div>
        <div class="p-4 bg-orange-50 border border-orange-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Total Tax</div>
          <div id="bulkTax" class="text-2xl font-bold text-orange-600">$0.00</div>
        </div>
        <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-center">
          <div class="text-xs text-gray-500 mb-1">Grand Total</div>
          <div id="bulkTotal" class="text-2xl font-bold text-green-600">$0.00</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const fmt = (n: number): string => '$' + n.toFixed(2);

    const states: [string, number][] = [
      ['CA', 7.25], ['TX', 6.25], ['NY', 8.0], ['FL', 6.0], ['WA', 6.5],
      ['IL', 6.25], ['PA', 6.0], ['OH', 5.75], ['GA', 4.0], ['NJ', 6.625],
      ['NC', 4.75], ['MI', 6.0], ['VA', 5.3], ['TN', 7.0], ['AZ', 5.6],
      ['CO', 2.9], ['MN', 6.875], ['NV', 6.85], ['OR', 0], ['NH', 0],
    ];

    // State presets
    const presetsEl = document.getElementById('statePresets')!;
    for (const [st, rate] of states) {
      const btn = document.createElement('button');
      btn.className = 'px-2 py-1 text-xs border border-gray-300 rounded hover:bg-blue-50 hover:border-blue-300 transition-colors';
      btn.textContent = st + ' ' + rate + '%';
      btn.addEventListener('click', () => {
        (document.getElementById('taxRate') as HTMLInputElement).value = String(rate);
        calcStandard();
      });
      presetsEl.appendChild(btn);
    }

    // Tab switching
    function showTab(tab: string): void {
      ['standard', 'reverse', 'bulk'].forEach(t => {
        document.getElementById(t + 'Mode')!.classList.toggle('hidden', t !== tab);
      });
      document.querySelectorAll('.mode-tab').forEach(b => {
        b.className = 'mode-tab flex-1 px-3 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-800 transition-colors';
      });
      document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1))!.className =
        'mode-tab flex-1 px-3 py-2 text-sm font-medium rounded-md bg-white shadow text-blue-600 transition-colors';
    }
    document.getElementById('tabStandard')!.addEventListener('click', () => showTab('standard'));
    document.getElementById('tabReverse')!.addEventListener('click', () => showTab('reverse'));
    document.getElementById('tabBulk')!.addEventListener('click', () => showTab('bulk'));

    // Standard calc
    function calcStandard(): void {
      const price = parseFloat((document.getElementById('preTaxPrice') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('taxRate') as HTMLInputElement).value) || 0;
      const tax = price * (rate / 100);
      const total = price + tax;
      document.getElementById('taxAmount')!.textContent = fmt(tax);
      document.getElementById('totalPrice')!.textContent = fmt(total);
      document.getElementById('effectiveRate')!.textContent = rate.toFixed(2) + '%';
    }
    ['preTaxPrice', 'taxRate'].forEach(id =>
      document.getElementById(id)!.addEventListener('input', calcStandard)
    );

    // Reverse calc
    function calcReverse(): void {
      const total = parseFloat((document.getElementById('revTotal') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('revTaxRate') as HTMLInputElement).value) || 0;
      const preTax = total / (1 + rate / 100);
      const tax = total - preTax;
      document.getElementById('revPreTax')!.textContent = fmt(preTax);
      document.getElementById('revTaxAmount')!.textContent = fmt(tax);
      document.getElementById('revRateDisplay')!.textContent = rate.toFixed(2) + '%';
    }
    ['revTotal', 'revTaxRate'].forEach(id =>
      document.getElementById(id)!.addEventListener('input', calcReverse)
    );

    // Bulk mode
    interface BulkItem { name: string; price: number; qty: number; rate: number }
    let bulkItems: BulkItem[] = [
      { name: 'Item 1', price: 29.99, qty: 1, rate: 8.25 },
      { name: 'Item 2', price: 49.99, qty: 2, rate: 8.25 },
    ];

    function renderBulk(): void {
      const container = document.getElementById('bulkItems')!;
      let html = '';
      for (let i = 0; i < bulkItems.length; i++) {
        const item = bulkItems[i];
        html += `<div class="flex gap-2 items-center flex-wrap">
          <input type="text" value="${item.name}" data-idx="${i}" data-field="name" class="bulk-input flex-1 min-w-[100px] px-2 py-1.5 border border-gray-300 rounded text-sm" placeholder="Item name" />
          <input type="number" value="${item.price}" data-idx="${i}" data-field="price" class="bulk-input w-24 px-2 py-1.5 border border-gray-300 rounded text-sm text-right" step="0.01" min="0" placeholder="Price" />
          <span class="text-xs text-gray-400">x</span>
          <input type="number" value="${item.qty}" data-idx="${i}" data-field="qty" class="bulk-input w-16 px-2 py-1.5 border border-gray-300 rounded text-sm text-center" min="1" step="1" placeholder="Qty" />
          <span class="text-xs text-gray-400">@</span>
          <input type="number" value="${item.rate}" data-idx="${i}" data-field="rate" class="bulk-input w-20 px-2 py-1.5 border border-gray-300 rounded text-sm text-center" step="0.01" min="0" placeholder="Tax %" />
          <span class="text-xs text-gray-400">%</span>
          <button data-remove="${i}" class="remove-item w-8 h-8 flex items-center justify-center text-red-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors text-lg">&times;</button>
        </div>`;
      }
      container.innerHTML = html;

      // Attach events
      container.querySelectorAll('.bulk-input').forEach(el => {
        el.addEventListener('input', () => {
          const idx = parseInt((el as HTMLElement).dataset.idx || '0');
          const field = (el as HTMLElement).dataset.field as string;
          if (field === 'name') bulkItems[idx].name = (el as HTMLInputElement).value;
          else if (field === 'price') bulkItems[idx].price = parseFloat((el as HTMLInputElement).value) || 0;
          else if (field === 'qty') bulkItems[idx].qty = parseInt((el as HTMLInputElement).value) || 1;
          else if (field === 'rate') bulkItems[idx].rate = parseFloat((el as HTMLInputElement).value) || 0;
          calcBulk();
        });
      });
      container.querySelectorAll('.remove-item').forEach(el => {
        el.addEventListener('click', () => {
          const idx = parseInt((el as HTMLElement).dataset.remove || '0');
          bulkItems.splice(idx, 1);
          renderBulk();
          calcBulk();
        });
      });
    }

    function calcBulk(): void {
      let subtotal = 0;
      let totalTax = 0;
      for (const item of bulkItems) {
        const linePrice = item.price * item.qty;
        subtotal += linePrice;
        totalTax += linePrice * (item.rate / 100);
      }
      document.getElementById('bulkSubtotal')!.textContent = fmt(subtotal);
      document.getElementById('bulkTax')!.textContent = fmt(totalTax);
      document.getElementById('bulkTotal')!.textContent = fmt(subtotal + totalTax);
    }

    document.getElementById('addItem')!.addEventListener('click', () => {
      const defRate = parseFloat((document.getElementById('bulkDefaultRate') as HTMLInputElement).value) || 0;
      bulkItems.push({ name: 'Item ' + (bulkItems.length + 1), price: 0, qty: 1, rate: defRate });
      renderBulk();
      calcBulk();
    });

    calcStandard();
    calcReverse();
    renderBulk();
    calcBulk();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Sales Tax Calculator</h2>
    <p>Calculate sales tax on any purchase amount. Use preset rates for common US states, reverse-calculate the pre-tax price from a total, or add multiple items in bulk mode with different tax rates. Instantly see tax amount, total price, and per-item breakdowns.</p>
  </Fragment>
</ToolLayout>
