---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Percentage Calculator"
  description="Calculate percentages: X% of Y, percentage increase/decrease, what percent X is of Y. Free online percentage calculator."
  category="utility"
  icon="%"
>
  <div>
    <!-- Calculator 1: X% of Y -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg mb-4">
      <h3 class="text-sm font-medium text-gray-700 mb-3">What is X% of Y?</h3>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm">What is</span>
        <input type="number" id="pct1x" value="25" class="w-20 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">% of</span>
        <input type="number" id="pct1y" value="200" class="w-24 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">=</span>
        <span id="pct1result" class="text-xl font-bold text-blue-600">50</span>
      </div>
    </div>

    <!-- Calculator 2: X is what % of Y -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg mb-4">
      <h3 class="text-sm font-medium text-gray-700 mb-3">X is what percent of Y?</h3>
      <div class="flex items-center gap-2 flex-wrap">
        <input type="number" id="pct2x" value="50" class="w-24 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">is what % of</span>
        <input type="number" id="pct2y" value="200" class="w-24 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">=</span>
        <span id="pct2result" class="text-xl font-bold text-green-600">25%</span>
      </div>
    </div>

    <!-- Calculator 3: Percentage change -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg mb-4">
      <h3 class="text-sm font-medium text-gray-700 mb-3">Percentage Change</h3>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm">From</span>
        <input type="number" id="pct3from" value="100" class="w-24 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">to</span>
        <input type="number" id="pct3to" value="150" class="w-24 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">=</span>
        <span id="pct3result" class="text-xl font-bold text-purple-600">+50%</span>
      </div>
    </div>

    <!-- Calculator 4: Increase/Decrease -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg mb-4">
      <h3 class="text-sm font-medium text-gray-700 mb-3">Increase/Decrease by Percent</h3>
      <div class="flex items-center gap-2 flex-wrap">
        <input type="number" id="pct4val" value="100" class="w-24 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <select id="pct4dir" class="px-2 py-2 border border-gray-300 rounded text-sm">
          <option value="increase">+ increase</option>
          <option value="decrease">- decrease</option>
        </select>
        <span class="text-sm">by</span>
        <input type="number" id="pct4pct" value="20" class="w-20 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">% =</span>
        <span id="pct4result" class="text-xl font-bold text-orange-600">120</span>
      </div>
    </div>

    <!-- Calculator 5: Tip Calculator -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg">
      <h3 class="text-sm font-medium text-gray-700 mb-3">Tip Calculator</h3>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm">Bill:</span>
        <input type="number" id="tipBill" value="50" class="w-24 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
        <span class="text-sm">Tip:</span>
        <select id="tipPct" class="px-2 py-2 border border-gray-300 rounded text-sm">
          <option value="10">10%</option>
          <option value="15">15%</option>
          <option value="18">18%</option>
          <option value="20" selected>20%</option>
          <option value="25">25%</option>
        </select>
        <span class="text-sm">Split:</span>
        <input type="number" id="tipSplit" value="1" min="1" class="w-16 px-2 py-2 border border-gray-300 rounded text-sm text-center" />
      </div>
      <div class="mt-3 grid grid-cols-3 gap-3 text-center">
        <div class="p-2 bg-gray-50 rounded"><div class="text-xs text-gray-500">Tip</div><div id="tipAmount" class="font-bold">$10.00</div></div>
        <div class="p-2 bg-gray-50 rounded"><div class="text-xs text-gray-500">Total</div><div id="tipTotal" class="font-bold">$60.00</div></div>
        <div class="p-2 bg-gray-50 rounded"><div class="text-xs text-gray-500">Per Person</div><div id="tipPerson" class="font-bold">$60.00</div></div>
      </div>
    </div>
  </div>

  <script>
    function calc1(): void {
      const x = parseFloat((document.getElementById('pct1x') as HTMLInputElement).value) || 0;
      const y = parseFloat((document.getElementById('pct1y') as HTMLInputElement).value) || 0;
      document.getElementById('pct1result')!.textContent = ((x / 100) * y).toFixed(2).replace(/\.?0+$/, '');
    }
    function calc2(): void {
      const x = parseFloat((document.getElementById('pct2x') as HTMLInputElement).value) || 0;
      const y = parseFloat((document.getElementById('pct2y') as HTMLInputElement).value) || 1;
      document.getElementById('pct2result')!.textContent = ((x / y) * 100).toFixed(2).replace(/\.?0+$/, '') + '%';
    }
    function calc3(): void {
      const from = parseFloat((document.getElementById('pct3from') as HTMLInputElement).value) || 1;
      const to = parseFloat((document.getElementById('pct3to') as HTMLInputElement).value) || 0;
      const change = ((to - from) / from) * 100;
      document.getElementById('pct3result')!.textContent = (change >= 0 ? '+' : '') + change.toFixed(2).replace(/\.?0+$/, '') + '%';
    }
    function calc4(): void {
      const val = parseFloat((document.getElementById('pct4val') as HTMLInputElement).value) || 0;
      const pct = parseFloat((document.getElementById('pct4pct') as HTMLInputElement).value) || 0;
      const dir = (document.getElementById('pct4dir') as HTMLSelectElement).value;
      const result = dir === 'increase' ? val * (1 + pct / 100) : val * (1 - pct / 100);
      document.getElementById('pct4result')!.textContent = result.toFixed(2).replace(/\.?0+$/, '');
    }
    function calcTip(): void {
      const bill = parseFloat((document.getElementById('tipBill') as HTMLInputElement).value) || 0;
      const pct = parseFloat((document.getElementById('tipPct') as HTMLSelectElement).value) || 0;
      const split = Math.max(1, parseInt((document.getElementById('tipSplit') as HTMLInputElement).value) || 1);
      const tip = bill * (pct / 100);
      const total = bill + tip;
      document.getElementById('tipAmount')!.textContent = '$' + tip.toFixed(2);
      document.getElementById('tipTotal')!.textContent = '$' + total.toFixed(2);
      document.getElementById('tipPerson')!.textContent = '$' + (total / split).toFixed(2);
    }

    ['pct1x', 'pct1y'].forEach(id => document.getElementById(id)!.addEventListener('input', calc1));
    ['pct2x', 'pct2y'].forEach(id => document.getElementById(id)!.addEventListener('input', calc2));
    ['pct3from', 'pct3to'].forEach(id => document.getElementById(id)!.addEventListener('input', calc3));
    ['pct4val', 'pct4pct', 'pct4dir'].forEach(id => document.getElementById(id)!.addEventListener('input', calc4));
    ['tipBill', 'tipPct', 'tipSplit'].forEach(id => document.getElementById(id)!.addEventListener('input', calcTip));

    calc1(); calc2(); calc3(); calc4(); calcTip();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Percentage Calculator</h2>
    <p>Calculate percentages easily: find X% of Y, percentage change, increase/decrease by percent, and a tip calculator with bill splitting.</p>
  </Fragment>
</ToolLayout>
