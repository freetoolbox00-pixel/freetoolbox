---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="JSON Formatter"
  description="Format, validate and beautify JSON data online. Minify or pretty-print JSON with syntax highlighting. Free JSON formatter and validator."
  category="developer"
  icon="{ }"
>
  <div>
    <!-- Action Buttons -->
    <div class="flex flex-wrap gap-2 mb-4">
      <button id="formatBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
        Format / Beautify
      </button>
      <button id="minifyBtn" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white text-sm font-medium rounded-lg transition-colors">
        Minify
      </button>
      <button id="validateBtn" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors">
        Validate
      </button>
      <button id="copyJsonBtn" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-sm font-medium rounded-lg transition-colors">
        Copy
      </button>
      <button id="clearJsonBtn" class="px-4 py-2 text-sm text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
        Clear
      </button>
    </div>

    <!-- Status message -->
    <div id="jsonStatus" class="mb-4 hidden">
      <div id="jsonStatusMsg" class="p-3 rounded-lg text-sm font-medium"></div>
    </div>

    <!-- Indent Size -->
    <div class="flex items-center gap-2 mb-4">
      <label class="text-sm text-gray-600">Indent:</label>
      <select id="indentSize" class="text-sm border border-gray-300 rounded px-2 py-1">
        <option value="2" selected>2 spaces</option>
        <option value="4">4 spaces</option>
        <option value="\t">Tab</option>
      </select>
    </div>

    <!-- Input/Output -->
    <div class="grid gap-4 lg:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Input JSON</label>
        <textarea
          id="jsonInput"
          rows="16"
          placeholder='{"name":"John","age":30,"hobbies":["reading","coding"]}'
          class="w-full p-4 font-mono text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"
        ></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Output</label>
        <pre id="jsonOutput" class="w-full p-4 font-mono text-sm bg-gray-50 border border-gray-300 rounded-lg overflow-auto min-h-[400px] whitespace-pre-wrap"></pre>
      </div>
    </div>
  </div>

  <script>
    const jsonInput = document.getElementById('jsonInput') as HTMLTextAreaElement;
    const jsonOutput = document.getElementById('jsonOutput')!;
    const status = document.getElementById('jsonStatus')!;
    const statusMsg = document.getElementById('jsonStatusMsg')!;
    const indentSelect = document.getElementById('indentSize') as HTMLSelectElement;

    function showStatus(msg: string, type: 'success' | 'error'): void {
      status.classList.remove('hidden');
      statusMsg.textContent = msg;
      statusMsg.className = `p-3 rounded-lg text-sm font-medium ${
        type === 'success' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'
      }`;
    }

    function getIndent(): string | number {
      const val = indentSelect.value;
      return val === '\\t' ? '\t' : parseInt(val);
    }

    document.getElementById('formatBtn')!.addEventListener('click', () => {
      try {
        const parsed = JSON.parse(jsonInput.value);
        const formatted = JSON.stringify(parsed, null, getIndent());
        jsonOutput.textContent = formatted;
        showStatus('Valid JSON - formatted successfully', 'success');
      } catch (e: any) {
        showStatus('Invalid JSON: ' + e.message, 'error');
      }
    });

    document.getElementById('minifyBtn')!.addEventListener('click', () => {
      try {
        const parsed = JSON.parse(jsonInput.value);
        const minified = JSON.stringify(parsed);
        jsonOutput.textContent = minified;
        showStatus(`Minified: ${minified.length} characters`, 'success');
      } catch (e: any) {
        showStatus('Invalid JSON: ' + e.message, 'error');
      }
    });

    document.getElementById('validateBtn')!.addEventListener('click', () => {
      try {
        const parsed = JSON.parse(jsonInput.value);
        const keys = typeof parsed === 'object' ? Object.keys(parsed).length : 0;
        showStatus(`Valid JSON! Type: ${Array.isArray(parsed) ? 'Array' : typeof parsed}${keys ? `, ${keys} keys` : ''}`, 'success');
        jsonOutput.textContent = JSON.stringify(parsed, null, getIndent());
      } catch (e: any) {
        showStatus('Invalid JSON: ' + e.message, 'error');
      }
    });

    document.getElementById('copyJsonBtn')!.addEventListener('click', async () => {
      const text = jsonOutput.textContent || '';
      await navigator.clipboard.writeText(text);
      showStatus('Copied to clipboard!', 'success');
    });

    document.getElementById('clearJsonBtn')!.addEventListener('click', () => {
      jsonInput.value = '';
      jsonOutput.textContent = '';
      status.classList.add('hidden');
      jsonInput.focus();
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free Online JSON Formatter and Validator</h2>
    <p>Format, beautify, validate and minify JSON data instantly in your browser. Our JSON formatter supports custom indentation (2 spaces, 4 spaces, or tabs) and provides clear error messages for invalid JSON.</p>
    <h3>Features</h3>
    <ul>
      <li><strong>Format</strong> - Pretty-print JSON with proper indentation</li>
      <li><strong>Minify</strong> - Compress JSON by removing whitespace</li>
      <li><strong>Validate</strong> - Check if your JSON is valid with detailed error messages</li>
      <li><strong>Copy</strong> - One-click copy to clipboard</li>
    </ul>
    <h3>When to Use</h3>
    <p>Use this tool when working with API responses, configuration files, database exports, or any JSON data that needs to be readable or compressed.</p>
  </Fragment>
</ToolLayout>
