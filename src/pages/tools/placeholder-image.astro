---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Placeholder Image Generator"
  description="Generate placeholder images with custom size, color and text. Download as PNG or get HTML/CSS code. Free placeholder image tool."
  category="developer"
  icon="🖼"
>
  <div>
    <!-- Controls -->
    <div class="grid gap-4 sm:grid-cols-3 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Width</label>
        <input type="number" id="phW" value="800" min="10" max="4000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Height</label>
        <input type="number" id="phH" value="400" min="10" max="4000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Text</label>
        <input type="text" id="phText" value="" placeholder="Auto (800×400)" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Background</label>
        <div class="flex gap-2">
          <input type="color" id="phBg" value="#CCCCCC" class="w-10 h-10 rounded cursor-pointer" />
          <input type="text" id="phBgHex" value="#CCCCCC" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Text Color</label>
        <div class="flex gap-2">
          <input type="color" id="phFg" value="#666666" class="w-10 h-10 rounded cursor-pointer" />
          <input type="text" id="phFgHex" value="#666666" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Font Size</label>
        <input type="number" id="phFont" value="0" min="0" max="200" placeholder="Auto" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        <span class="text-xs text-gray-400">0 = auto</span>
      </div>
    </div>

    <!-- Presets -->
    <div class="flex flex-wrap gap-2 mb-6">
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="1920" data-h="1080">1920×1080</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="1280" data-h="720">1280×720</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="800" data-h="600">800×600</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="400" data-h="300">400×300</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="300" data-h="250">300×250 (Ad)</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="728" data-h="90">728×90 (Banner)</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="1200" data-h="630">1200×630 (OG)</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="512" data-h="512">512×512</button>
      <button class="ph-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="150" data-h="150">150×150</button>
    </div>

    <!-- Preview -->
    <div class="flex justify-center mb-6">
      <canvas id="phCanvas" class="max-w-full border border-gray-200 rounded-lg"></canvas>
    </div>

    <!-- Actions -->
    <div class="flex gap-2 mb-6">
      <button id="phDownload" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg">Download PNG</button>
      <button id="phCopyHtml" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-sm rounded-lg">Copy HTML</button>
    </div>
  </div>

  <script>
    function render(): void {
      const w = parseInt((document.getElementById('phW') as HTMLInputElement).value) || 800;
      const h = parseInt((document.getElementById('phH') as HTMLInputElement).value) || 400;
      const bg = (document.getElementById('phBg') as HTMLInputElement).value;
      const fg = (document.getElementById('phFg') as HTMLInputElement).value;
      const customText = (document.getElementById('phText') as HTMLInputElement).value;
      const customFont = parseInt((document.getElementById('phFont') as HTMLInputElement).value) || 0;

      const canvas = document.getElementById('phCanvas') as HTMLCanvasElement;
      // Display at max 600px wide
      const displayW = Math.min(w, 600);
      const scale = displayW / w;
      canvas.width = w;
      canvas.height = h;
      canvas.style.width = displayW + 'px';
      canvas.style.height = (h * scale) + 'px';

      const ctx = canvas.getContext('2d')!;
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, w, h);

      const text = customText || `${w}×${h}`;
      const fontSize = customFont || Math.max(12, Math.min(w, h) / 8);
      ctx.fillStyle = fg;
      ctx.font = `bold ${fontSize}px -apple-system, "Segoe UI", sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, w / 2, h / 2);
    }

    ['phW', 'phH', 'phText', 'phFont'].forEach(id => {
      document.getElementById(id)!.addEventListener('input', render);
    });

    document.getElementById('phBg')!.addEventListener('input', (e) => {
      (document.getElementById('phBgHex') as HTMLInputElement).value = (e.target as HTMLInputElement).value;
      render();
    });
    document.getElementById('phBgHex')!.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value;
      if (/^#[0-9a-fA-F]{6}$/.test(v)) { (document.getElementById('phBg') as HTMLInputElement).value = v; render(); }
    });
    document.getElementById('phFg')!.addEventListener('input', (e) => {
      (document.getElementById('phFgHex') as HTMLInputElement).value = (e.target as HTMLInputElement).value;
      render();
    });
    document.getElementById('phFgHex')!.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value;
      if (/^#[0-9a-fA-F]{6}$/.test(v)) { (document.getElementById('phFg') as HTMLInputElement).value = v; render(); }
    });

    document.querySelectorAll('.ph-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        (document.getElementById('phW') as HTMLInputElement).value = (btn as HTMLElement).dataset.w!;
        (document.getElementById('phH') as HTMLInputElement).value = (btn as HTMLElement).dataset.h!;
        render();
      });
    });

    document.getElementById('phDownload')!.addEventListener('click', () => {
      const canvas = document.getElementById('phCanvas') as HTMLCanvasElement;
      const a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      const w = (document.getElementById('phW') as HTMLInputElement).value;
      const h = (document.getElementById('phH') as HTMLInputElement).value;
      a.download = `placeholder-${w}x${h}.png`;
      a.click();
    });

    document.getElementById('phCopyHtml')!.addEventListener('click', () => {
      const w = (document.getElementById('phW') as HTMLInputElement).value;
      const h = (document.getElementById('phH') as HTMLInputElement).value;
      const canvas = document.getElementById('phCanvas') as HTMLCanvasElement;
      const dataUrl = canvas.toDataURL('image/png');
      navigator.clipboard.writeText(`<img src="${dataUrl}" width="${w}" height="${h}" alt="Placeholder ${w}×${h}" />`);
    });

    render();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Placeholder Image Generator</h2>
    <p>Generate placeholder images with custom dimensions, colors and text. Download as PNG or copy as HTML. Includes presets for common sizes like 1920×1080, social media OG images and ad banners.</p>
  </Fragment>
</ToolLayout>
