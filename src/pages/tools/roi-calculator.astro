---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="ROI Calculator" description="Calculate Return on Investment. Compare investments, annualized ROI, break-even analysis. Free ROI calculator." category="utility" icon="📈">
  <div>
    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Initial Investment ($)</label>
        <input type="number" id="roiInit" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="10000" min="0" step="100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Final Value ($)</label>
        <input type="number" id="roiFinal" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="15000" min="0" step="100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Time Period (years)</label>
        <input type="number" id="roiYears" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="3" min="0.1" step="0.1" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Additional Costs ($)</label>
        <input type="number" id="roiCosts" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="0" min="0" step="100" />
      </div>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-center">
        <div class="text-xs text-green-600">ROI</div>
        <div class="text-3xl font-bold text-green-700" id="roiPct">50%</div>
      </div>
      <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
        <div class="text-xs text-blue-600">Annualized ROI</div>
        <div class="text-3xl font-bold text-blue-700" id="roiAnn">14.5%</div>
      </div>
      <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg text-center">
        <div class="text-xs text-gray-500">Net Profit</div>
        <div class="text-2xl font-bold text-gray-900" id="roiProfit">$5,000</div>
      </div>
      <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg text-center">
        <div class="text-xs text-gray-500">Total Cost</div>
        <div class="text-2xl font-bold text-gray-900" id="roiTotal">$10,000</div>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const initIn = document.getElementById('roiInit') as HTMLInputElement;
  const finalIn = document.getElementById('roiFinal') as HTMLInputElement;
  const yearsIn = document.getElementById('roiYears') as HTMLInputElement;
  const costsIn = document.getElementById('roiCosts') as HTMLInputElement;

  function calc() {
    const init = parseFloat(initIn.value) || 0;
    const final_ = parseFloat(finalIn.value) || 0;
    const years = parseFloat(yearsIn.value) || 1;
    const costs = parseFloat(costsIn.value) || 0;
    const totalCost = init + costs;
    const profit = final_ - totalCost;
    const roi = totalCost > 0 ? (profit / totalCost) * 100 : 0;
    const annRoi = totalCost > 0 ? (Math.pow(final_ / totalCost, 1 / years) - 1) * 100 : 0;

    document.getElementById('roiPct')!.textContent = roi.toFixed(1) + '%';
    document.getElementById('roiAnn')!.textContent = annRoi.toFixed(1) + '%';
    document.getElementById('roiProfit')!.textContent = '$' + profit.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    document.getElementById('roiTotal')!.textContent = '$' + totalCost.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 });

    const pctEl = document.getElementById('roiPct')!;
    pctEl.className = 'text-3xl font-bold ' + (roi >= 0 ? 'text-green-700' : 'text-red-600');
  }

  [initIn, finalIn, yearsIn, costsIn].forEach(el => el.addEventListener('input', calc));
  calc();
</script>
