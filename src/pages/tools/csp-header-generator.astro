---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="CSP Header Generator" description="Generate Content Security Policy headers to protect your site from XSS and injection attacks. Free CSP builder." category="security" icon="🛡️">
  <div>
    <div class="space-y-3 mb-6" id="cspFields">
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">default-src</label>
        <input type="text" data-dir="default-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">script-src</label>
        <input type="text" data-dir="script-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">style-src</label>
        <input type="text" data-dir="style-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self' 'unsafe-inline'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">img-src</label>
        <input type="text" data-dir="img-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self' data:" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">font-src</label>
        <input type="text" data-dir="font-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">connect-src</label>
        <input type="text" data-dir="connect-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">frame-src</label>
        <input type="text" data-dir="frame-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'none'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">object-src</label>
        <input type="text" data-dir="object-src" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'none'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">base-uri</label>
        <input type="text" data-dir="base-uri" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self'" />
      </div>
      <div class="grid gap-2 sm:grid-cols-[180px_1fr] items-center">
        <label class="text-sm font-medium text-gray-700">form-action</label>
        <input type="text" data-dir="form-action" class="csp-d w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" value="'self'" />
      </div>
    </div>
    <div class="flex gap-2 mb-2">
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="cspUpgrade" checked /> upgrade-insecure-requests</label>
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="cspBlock" /> block-all-mixed-content</label>
    </div>
    <button id="cspGen" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium mb-4">Generate</button>
    <div id="cspOut" class="hidden">
      <div class="flex justify-between items-center mb-1">
        <label class="text-sm font-medium text-gray-700">HTTP Header</label>
        <button id="cspCopy" class="text-xs text-blue-600 hover:underline">Copy</button>
      </div>
      <pre id="cspHeader" class="p-4 bg-gray-900 text-green-400 rounded-lg text-sm font-mono overflow-x-auto whitespace-pre-wrap"></pre>
      <div class="mt-3">
        <label class="text-sm font-medium text-gray-700 mb-1 block">HTML Meta Tag</label>
        <pre id="cspMeta" class="p-4 bg-gray-900 text-green-400 rounded-lg text-sm font-mono overflow-x-auto whitespace-pre-wrap"></pre>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const genBtn = document.getElementById('cspGen')!;
  const outEl = document.getElementById('cspOut')!;
  const headerEl = document.getElementById('cspHeader')!;
  const metaEl = document.getElementById('cspMeta')!;
  const copyBtn = document.getElementById('cspCopy')!;
  const upgrade = document.getElementById('cspUpgrade') as HTMLInputElement;
  const block = document.getElementById('cspBlock') as HTMLInputElement;

  genBtn.addEventListener('click', () => {
    const directives: string[] = [];
    document.querySelectorAll('.csp-d').forEach(el => {
      const inp = el as HTMLInputElement;
      const val = inp.value.trim();
      if (val) directives.push(`${inp.dataset.dir} ${val}`);
    });
    if (upgrade.checked) directives.push('upgrade-insecure-requests');
    if (block.checked) directives.push('block-all-mixed-content');
    const policy = directives.join('; ');
    headerEl.textContent = `Content-Security-Policy: ${policy}`;
    metaEl.textContent = `<meta http-equiv="Content-Security-Policy" content="${policy}">`;
    outEl.classList.remove('hidden');
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(headerEl.textContent || '');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
  });
</script>
