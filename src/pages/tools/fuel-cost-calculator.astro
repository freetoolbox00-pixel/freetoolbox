---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Fuel Cost Calculator" description="Calculate fuel costs for your trip. Enter distance, fuel efficiency and gas price. Free trip cost estimator." category="utility" icon="⛽">
  <div>
    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Distance</label>
        <div class="flex gap-2">
          <input type="number" id="fcDist" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm" value="100" min="0" step="1" />
          <select id="fcDistUnit" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="miles">miles</option>
            <option value="km">km</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Fuel Efficiency</label>
        <div class="flex gap-2">
          <input type="number" id="fcEff" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm" value="25" min="1" step="0.1" />
          <select id="fcEffUnit" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="mpg">MPG</option>
            <option value="kml">km/L</option>
            <option value="l100">L/100km</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Fuel Price (per gallon/liter)</label>
        <input type="number" id="fcPrice" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="3.50" min="0" step="0.01" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Round Trip?</label>
        <select id="fcRound" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="1">One way</option>
          <option value="2">Round trip</option>
        </select>
      </div>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
        <div class="text-xs text-blue-600">Total Cost</div>
        <div class="text-3xl font-bold text-blue-700" id="fcCost">$0.00</div>
      </div>
      <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg text-center">
        <div class="text-xs text-gray-500">Fuel Needed</div>
        <div class="text-2xl font-bold text-gray-900" id="fcFuel">0 gal</div>
      </div>
      <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg text-center">
        <div class="text-xs text-gray-500">Cost per Mile/km</div>
        <div class="text-2xl font-bold text-gray-900" id="fcPer">$0.00</div>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const distIn = document.getElementById('fcDist') as HTMLInputElement;
  const distUnit = document.getElementById('fcDistUnit') as HTMLSelectElement;
  const effIn = document.getElementById('fcEff') as HTMLInputElement;
  const effUnit = document.getElementById('fcEffUnit') as HTMLSelectElement;
  const priceIn = document.getElementById('fcPrice') as HTMLInputElement;
  const roundSel = document.getElementById('fcRound') as HTMLSelectElement;
  const costEl = document.getElementById('fcCost')!;
  const fuelEl = document.getElementById('fcFuel')!;
  const perEl = document.getElementById('fcPer')!;

  function calc() {
    let dist = parseFloat(distIn.value) || 0;
    const eff = parseFloat(effIn.value) || 1;
    const price = parseFloat(priceIn.value) || 0;
    const mult = parseInt(roundSel.value);
    dist *= mult;

    let gallons: number;
    const eu = effUnit.value;
    const du = distUnit.value;

    if (eu === 'mpg') {
      const miles = du === 'km' ? dist * 0.621371 : dist;
      gallons = miles / eff;
    } else if (eu === 'kml') {
      const km = du === 'miles' ? dist * 1.60934 : dist;
      const liters = km / eff;
      gallons = liters * 0.264172;
    } else {
      const km = du === 'miles' ? dist * 1.60934 : dist;
      const liters = (eff / 100) * km;
      gallons = liters * 0.264172;
    }

    const cost = gallons * price;
    const perUnit = dist > 0 ? cost / (dist / mult) : 0;
    const isMetric = du === 'km';

    costEl.textContent = '$' + cost.toFixed(2);
    fuelEl.textContent = gallons.toFixed(1) + ' gal';
    perEl.textContent = '$' + perUnit.toFixed(3) + '/' + (isMetric ? 'km' : 'mi');
  }

  [distIn, effIn, priceIn].forEach(el => el.addEventListener('input', calc));
  [distUnit, effUnit, roundSel].forEach(el => el.addEventListener('change', calc));
  calc();
</script>
