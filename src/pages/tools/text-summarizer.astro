---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Text Summarizer"
  description="Summarize long text into key points. Extractive summarization — picks the most important sentences. Free online text summarizer — 100% client-side."
  category="text"
  icon="📝"
>
  <div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Paste your text</label>
      <textarea id="tsInput" rows="10" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm resize-y" placeholder="Paste any text you want to summarize..."></textarea>
      <div class="flex justify-between mt-1">
        <span class="text-xs text-gray-400"><span id="tsWords">0</span> words · <span id="tsSent">0</span> sentences</span>
        <button id="tsClear" class="text-xs text-gray-400 hover:text-gray-600">Clear</button>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 mb-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Summary length</label>
        <select id="tsLength" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="3">Short (3 sentences)</option>
          <option value="5" selected>Medium (5 sentences)</option>
          <option value="8">Long (8 sentences)</option>
          <option value="10">Very long (10 sentences)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Output format</label>
        <select id="tsFormat" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="paragraph">Paragraph</option>
          <option value="bullets">Bullet points</option>
        </select>
      </div>
    </div>

    <div class="flex gap-3 mb-6">
      <button id="tsSum" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">Summarize</button>
    </div>

    <div id="tsResult" class="hidden">
      <div class="flex items-center justify-between mb-2">
        <label class="block text-sm font-medium text-gray-700">Summary</label>
        <div class="flex gap-2">
          <span class="text-xs text-gray-400"><span id="tsReduction">0</span>% shorter</span>
          <button id="tsCopy" class="text-xs text-blue-600 hover:underline">Copy</button>
        </div>
      </div>
      <div id="tsOutput" class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-sm leading-relaxed"></div>
    </div>
  </div>
</ToolLayout>

<script>
  const input = document.getElementById('tsInput') as HTMLTextAreaElement;
  const wordsEl = document.getElementById('tsWords')!;
  const sentEl = document.getElementById('tsSent')!;
  const lengthSel = document.getElementById('tsLength') as HTMLSelectElement;
  const formatSel = document.getElementById('tsFormat') as HTMLSelectElement;
  const sumBtn = document.getElementById('tsSum')!;
  const resultEl = document.getElementById('tsResult')!;
  const outputEl = document.getElementById('tsOutput')!;
  const reductionEl = document.getElementById('tsReduction')!;
  const copyBtn = document.getElementById('tsCopy')!;
  const clearBtn = document.getElementById('tsClear')!;

  function countWords(t: string) { return t.trim().split(/\s+/).filter(Boolean).length; }
  function splitSentences(t: string): string[] {
    return t.match(/[^.!?]+[.!?]+[\s]*/g)?.map(s => s.trim()).filter(Boolean) || [];
  }

  input.addEventListener('input', () => {
    const text = input.value.trim();
    wordsEl.textContent = String(countWords(text));
    sentEl.textContent = String(splitSentences(text).length);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    wordsEl.textContent = '0';
    sentEl.textContent = '0';
    resultEl.classList.add('hidden');
  });

  function scoreSentences(sentences: string[], fullText: string): { sentence: string; score: number; index: number }[] {
    const words = fullText.toLowerCase().replace(/[^a-z0-9\s]/g, '').split(/\s+/).filter(Boolean);
    const freq: Record<string, number> = {};
    words.forEach(w => { if (w.length > 3) freq[w] = (freq[w] || 0) + 1; });

    const maxFreq = Math.max(...Object.values(freq), 1);
    Object.keys(freq).forEach(w => { freq[w] /= maxFreq; });

    return sentences.map((sentence, index) => {
      const sWords = sentence.toLowerCase().replace(/[^a-z0-9\s]/g, '').split(/\s+/).filter(Boolean);
      if (!sWords.length) return { sentence, score: 0, index };

      let score = sWords.reduce((sum, w) => sum + (freq[w] || 0), 0) / sWords.length;

      // Boost first sentences (positional bias)
      if (index < 3) score *= 1.3;
      // Boost longer sentences (more info)
      if (sWords.length > 10 && sWords.length < 40) score *= 1.1;
      // Penalize very short sentences
      if (sWords.length < 5) score *= 0.7;

      return { sentence, score, index };
    });
  }

  sumBtn.addEventListener('click', () => {
    const text = input.value.trim();
    if (!text) return;

    const sentences = splitSentences(text);
    if (!sentences.length) { outputEl.textContent = 'No sentences found.'; resultEl.classList.remove('hidden'); return; }

    const n = Math.min(parseInt(lengthSel.value), sentences.length);
    const scored = scoreSentences(sentences, text);
    const top = scored.sort((a, b) => b.score - a.score).slice(0, n);
    // Restore original order
    top.sort((a, b) => a.index - b.index);

    const summaryText = top.map(s => s.sentence).join(' ');
    const originalWords = countWords(text);
    const summaryWords = countWords(summaryText);
    const reduction = Math.round((1 - summaryWords / originalWords) * 100);

    if (formatSel.value === 'bullets') {
      outputEl.innerHTML = '<ul class="list-disc pl-5 space-y-1">' + top.map(s => `<li>${s.sentence}</li>`).join('') + '</ul>';
    } else {
      outputEl.textContent = summaryText;
    }

    reductionEl.textContent = String(Math.max(0, reduction));
    resultEl.classList.remove('hidden');
  });

  copyBtn.addEventListener('click', () => {
    const text = outputEl.innerText;
    navigator.clipboard.writeText(text);
    copyBtn.textContent = 'Copied!';
    setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
  });
</script>
