---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="UTM Link Builder" description="Build campaign URLs with UTM parameters for Google Analytics tracking. Free UTM generator." category="seo" icon="🔗">
  <div>
    <div class="space-y-3 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Website URL *</label>
        <input type="url" id="utUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="https://example.com/landing-page" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Campaign Source * (utm_source)</label>
        <input type="text" id="utSource" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. google, facebook, newsletter" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Campaign Medium * (utm_medium)</label>
        <input type="text" id="utMedium" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. cpc, email, social, banner" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Campaign Name * (utm_campaign)</label>
        <input type="text" id="utCampaign" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. spring_sale, product_launch" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Campaign Term (utm_term)</label>
        <input type="text" id="utTerm" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. running+shoes (optional)" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Campaign Content (utm_content)</label>
        <input type="text" id="utContent" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. logo_link, text_link (optional)" />
      </div>
    </div>
    <div id="utResult" class="mb-4">
      <div class="flex justify-between mb-1"><label class="text-sm font-medium text-gray-700">Generated URL</label><button id="utCopy" class="text-xs text-blue-600 hover:underline">Copy</button></div>
      <div id="utOutput" class="p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm font-mono break-all min-h-[40px]"></div>
    </div>
    <div class="flex gap-2">
      <button id="utShort" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200">Use lowercase</button>
      <button id="utClear" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200">Clear all</button>
    </div>
  </div>
</ToolLayout>

<script>
  const fields = ['utUrl','utSource','utMedium','utCampaign','utTerm','utContent'];
  const output = document.getElementById('utOutput')!;

  function build() {
    const url = (document.getElementById('utUrl') as HTMLInputElement).value.trim();
    const source = (document.getElementById('utSource') as HTMLInputElement).value.trim();
    const medium = (document.getElementById('utMedium') as HTMLInputElement).value.trim();
    const campaign = (document.getElementById('utCampaign') as HTMLInputElement).value.trim();
    const term = (document.getElementById('utTerm') as HTMLInputElement).value.trim();
    const content = (document.getElementById('utContent') as HTMLInputElement).value.trim();

    if (!url) { output.textContent = 'Enter a URL to get started'; return; }

    const params = new URLSearchParams();
    if (source) params.set('utm_source', source);
    if (medium) params.set('utm_medium', medium);
    if (campaign) params.set('utm_campaign', campaign);
    if (term) params.set('utm_term', term);
    if (content) params.set('utm_content', content);

    const sep = url.includes('?') ? '&' : '?';
    const paramStr = params.toString();
    output.textContent = paramStr ? url + sep + paramStr : url;
  }

  fields.forEach(id => document.getElementById(id)!.addEventListener('input', build));

  document.getElementById('utCopy')!.addEventListener('click', () => {
    navigator.clipboard.writeText(output.textContent || '');
    const btn = document.getElementById('utCopy')!;
    btn.textContent = 'Copied!'; setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
  });

  document.getElementById('utShort')!.addEventListener('click', () => {
    fields.slice(1).forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement;
      el.value = el.value.toLowerCase().replace(/\s+/g, '_');
    });
    build();
  });

  document.getElementById('utClear')!.addEventListener('click', () => {
    fields.forEach(id => { (document.getElementById(id) as HTMLInputElement).value = ''; });
    build();
  });
</script>
