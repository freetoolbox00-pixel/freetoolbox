---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Text Repeater"
  description="Repeat any text multiple times with custom separator. Generate repeated text for testing, filler content and more. Free text repeat tool."
  category="text"
  icon="×N"
>
  <div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Text to Repeat</label>
      <textarea id="repeatInput" rows="3" placeholder="Enter text to repeat..." class="w-full p-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
    </div>

    <div class="grid gap-4 sm:grid-cols-3 mb-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Repeat Count</label>
        <input type="number" id="repeatCount" value="10" min="1" max="10000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Separator</label>
        <select id="repeatSep" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value=" ">Space</option>
          <option value="\n" selected>New Line</option>
          <option value=", ">Comma</option>
          <option value="">None</option>
          <option value="custom">Custom</option>
        </select>
      </div>
      <div id="customSepWrap" class="hidden">
        <label class="block text-sm font-medium text-gray-700 mb-1">Custom Separator</label>
        <input type="text" id="customSep" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
    </div>

    <div class="flex gap-2 mb-4">
      <button id="repeatBtn" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Repeat</button>
      <button id="copyRepeat" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-sm font-medium rounded-lg transition-colors">Copy</button>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Result (<span id="repeatLen">0</span> chars)</label>
      <textarea id="repeatOutput" rows="8" readonly class="w-full p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm resize-y"></textarea>
    </div>
  </div>

  <script>
    function getSep(): string {
      const v = (document.getElementById('repeatSep') as HTMLSelectElement).value;
      if (v === 'custom') return (document.getElementById('customSep') as HTMLInputElement).value;
      return v === '\\n' ? '\n' : v;
    }

    function repeat(): void {
      const text = (document.getElementById('repeatInput') as HTMLTextAreaElement).value;
      const count = Math.min(10000, Math.max(1, parseInt((document.getElementById('repeatCount') as HTMLInputElement).value) || 1));
      const sep = getSep();
      const result = Array(count).fill(text).join(sep);
      (document.getElementById('repeatOutput') as HTMLTextAreaElement).value = result;
      document.getElementById('repeatLen')!.textContent = result.length.toString();
    }

    document.getElementById('repeatBtn')!.addEventListener('click', repeat);
    document.getElementById('repeatSep')!.addEventListener('change', () => {
      document.getElementById('customSepWrap')!.classList.toggle('hidden', (document.getElementById('repeatSep') as HTMLSelectElement).value !== 'custom');
    });
    document.getElementById('copyRepeat')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText((document.getElementById('repeatOutput') as HTMLTextAreaElement).value);
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free Text Repeater Tool</h2>
    <p>Repeat any text string multiple times with a custom separator. Useful for generating test data, creating filler content, or formatting repeated patterns.</p>
  </Fragment>
</ToolLayout>
