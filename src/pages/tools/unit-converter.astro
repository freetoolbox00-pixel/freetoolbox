---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Unit Converter"
  description="Convert between units of length, weight, temperature, volume, speed and more. Free online unit converter."
  category="utility"
  icon="⚖"
>
  <div>
    <!-- Category selector -->
    <div class="flex flex-wrap gap-2 mb-6">
      <button class="uc-cat px-3 py-2 bg-blue-600 text-white text-sm rounded-lg" data-cat="length">Length</button>
      <button class="uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg" data-cat="weight">Weight</button>
      <button class="uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg" data-cat="temperature">Temperature</button>
      <button class="uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg" data-cat="volume">Volume</button>
      <button class="uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg" data-cat="speed">Speed</button>
      <button class="uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg" data-cat="area">Area</button>
      <button class="uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg" data-cat="data">Data</button>
      <button class="uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg" data-cat="time">Time</button>
    </div>

    <!-- Converter -->
    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">From</label>
        <input type="number" id="ucFrom" value="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm mb-2" />
        <select id="ucFromUnit" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">To</label>
        <input type="number" id="ucTo" readonly class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-sm mb-2" />
        <select id="ucToUnit" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></select>
      </div>
    </div>

    <!-- Swap -->
    <div class="flex justify-center mb-6">
      <button id="ucSwap" class="px-4 py-2 bg-gray-100 hover:bg-blue-50 rounded-lg text-sm">⇅ Swap</button>
    </div>

    <!-- Formula -->
    <div id="ucFormula" class="p-4 bg-gray-50 rounded-lg text-sm text-gray-600 font-mono"></div>
  </div>

  <script>
    type UnitData = Record<string, Record<string, number>>;
    const units: UnitData = {
      length: { meter: 1, kilometer: 1000, centimeter: 0.01, millimeter: 0.001, mile: 1609.344, yard: 0.9144, foot: 0.3048, inch: 0.0254, nautical_mile: 1852 },
      weight: { kilogram: 1, gram: 0.001, milligram: 0.000001, metric_ton: 1000, pound: 0.453592, ounce: 0.0283495, stone: 6.35029 },
      volume: { liter: 1, milliliter: 0.001, gallon_us: 3.78541, quart: 0.946353, pint: 0.473176, cup: 0.236588, fluid_oz: 0.0295735, tablespoon: 0.0147868, teaspoon: 0.00492892, cubic_meter: 1000 },
      speed: { 'm/s': 1, 'km/h': 0.277778, 'mph': 0.44704, knot: 0.514444, 'ft/s': 0.3048 },
      area: { sqm: 1, sqkm: 1000000, sqft: 0.092903, sqyd: 0.836127, acre: 4046.86, hectare: 10000, sqmi: 2589988.11, sqin: 0.00064516 },
      data: { byte: 1, kilobyte: 1024, megabyte: 1048576, gigabyte: 1073741824, terabyte: 1099511627776, petabyte: 1125899906842624, bit: 0.125 },
      time: { second: 1, minute: 60, hour: 3600, day: 86400, week: 604800, month: 2629746, year: 31556952 }
    };

    let currentCat = 'length';

    function populateUnits(): void {
      const fromSel = document.getElementById('ucFromUnit') as HTMLSelectElement;
      const toSel = document.getElementById('ucToUnit') as HTMLSelectElement;
      fromSel.innerHTML = '';
      toSel.innerHTML = '';
      if (currentCat === 'temperature') {
        ['Celsius', 'Fahrenheit', 'Kelvin'].forEach(u => {
          fromSel.add(new Option(u, u));
          toSel.add(new Option(u, u));
        });
        toSel.value = 'Fahrenheit';
      } else {
        const catUnits = units[currentCat];
        Object.keys(catUnits).forEach(u => {
          const label = u.replace(/_/g, ' ');
          fromSel.add(new Option(label, u));
          toSel.add(new Option(label, u));
        });
        const keys = Object.keys(catUnits);
        if (keys.length > 1) toSel.value = keys[1];
      }
      convert();
    }

    function convertTemp(val: number, from: string, to: string): number {
      if (from === to) return val;
      let celsius = val;
      if (from === 'Fahrenheit') celsius = (val - 32) * 5 / 9;
      else if (from === 'Kelvin') celsius = val - 273.15;
      if (to === 'Celsius') return celsius;
      if (to === 'Fahrenheit') return celsius * 9 / 5 + 32;
      return celsius + 273.15;
    }

    function convert(): void {
      const val = parseFloat((document.getElementById('ucFrom') as HTMLInputElement).value) || 0;
      const fromUnit = (document.getElementById('ucFromUnit') as HTMLSelectElement).value;
      const toUnit = (document.getElementById('ucToUnit') as HTMLSelectElement).value;

      let result: number;
      if (currentCat === 'temperature') {
        result = convertTemp(val, fromUnit, toUnit);
      } else {
        const fromFactor = units[currentCat][fromUnit];
        const toFactor = units[currentCat][toUnit];
        result = (val * fromFactor) / toFactor;
      }

      (document.getElementById('ucTo') as HTMLInputElement).value = result.toPrecision(10).replace(/\.?0+$/, '');
      document.getElementById('ucFormula')!.textContent = `${val} ${fromUnit.replace(/_/g, ' ')} = ${result.toPrecision(10).replace(/\.?0+$/, '')} ${toUnit.replace(/_/g, ' ')}`;
    }

    document.querySelectorAll('.uc-cat').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.uc-cat').forEach(b => b.className = 'uc-cat px-3 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg');
        (btn as HTMLElement).className = 'uc-cat px-3 py-2 bg-blue-600 text-white text-sm rounded-lg';
        currentCat = (btn as HTMLElement).dataset.cat!;
        populateUnits();
      });
    });

    document.getElementById('ucFrom')!.addEventListener('input', convert);
    document.getElementById('ucFromUnit')!.addEventListener('change', convert);
    document.getElementById('ucToUnit')!.addEventListener('change', convert);

    document.getElementById('ucSwap')!.addEventListener('click', () => {
      const fromSel = document.getElementById('ucFromUnit') as HTMLSelectElement;
      const toSel = document.getElementById('ucToUnit') as HTMLSelectElement;
      const tmp = fromSel.value;
      fromSel.value = toSel.value;
      toSel.value = tmp;
      convert();
    });

    populateUnits();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Unit Converter</h2>
    <p>Convert between units of length, weight, temperature, volume, speed, area, data size and time. Instant conversions with formulas.</p>
  </Fragment>
</ToolLayout>
