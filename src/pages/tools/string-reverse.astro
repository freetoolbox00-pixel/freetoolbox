---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="String Reverser"
  description="Reverse text strings, words, sentences, or individual words. Check if text is a palindrome. Free online string reverse tool."
  category="text"
  icon="🔄"
>
  <div>
    <!-- Input -->
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Input Text</label>
      <textarea id="revInput" rows="4" placeholder="Type or paste text to reverse..." class="w-full p-4 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
    </div>

    <!-- Reverse Mode Buttons -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
      <button class="rev-btn px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg transition-colors hover:bg-blue-700" data-mode="string">Reverse String</button>
      <button class="rev-btn px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-sm font-medium rounded-lg transition-colors" data-mode="words">Reverse Words</button>
      <button class="rev-btn px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-sm font-medium rounded-lg transition-colors" data-mode="each">Reverse Each Word</button>
      <button class="rev-btn px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-sm font-medium rounded-lg transition-colors" data-mode="sentences">Reverse Sentences</button>
    </div>

    <!-- Palindrome Check -->
    <div id="palindromeResult" class="mb-4 p-3 rounded-lg text-sm hidden"></div>

    <!-- Output -->
    <div class="flex items-center justify-between mb-1">
      <label class="block text-sm font-medium text-gray-700">Result</label>
      <button id="revCopy" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Copy</button>
    </div>
    <div id="revOutput" class="p-4 bg-gray-50 border border-gray-200 rounded-lg min-h-[100px] text-sm whitespace-pre-wrap font-mono"></div>

    <!-- Info -->
    <div class="mt-4 p-3 bg-gray-50 border border-gray-200 rounded-lg">
      <h4 class="text-xs font-semibold text-gray-600 uppercase mb-1">Mode Descriptions</h4>
      <ul class="text-xs text-gray-500 space-y-1">
        <li><strong>Reverse String</strong> — Reverses all characters: "hello" → "olleh"</li>
        <li><strong>Reverse Words</strong> — Reverses word order: "hello world" → "world hello"</li>
        <li><strong>Reverse Each Word</strong> — Reverses each word individually: "hello world" → "olleh dlrow"</li>
        <li><strong>Reverse Sentences</strong> — Reverses sentence order in multi-sentence text</li>
      </ul>
    </div>
  </div>

  <script>
    const input = document.getElementById('revInput') as HTMLTextAreaElement;
    const output = document.getElementById('revOutput')!;
    const palindrome = document.getElementById('palindromeResult')!;
    let currentMode = 'string';

    function reverseText(text: string, mode: string): string {
      switch (mode) {
        case 'string':
          return [...text].reverse().join('');
        case 'words':
          return text.split('\n').map(line =>
            line.split(/\s+/).reverse().join(' ')
          ).join('\n');
        case 'each':
          return text.split('\n').map(line =>
            line.split(/(\s+)/).map(part =>
              /\s/.test(part) ? part : [...part].reverse().join('')
            ).join('')
          ).join('\n');
        case 'sentences':
          return text.split(/(?<=[.!?])\s+/).reverse().join(' ');
        default:
          return text;
      }
    }

    function checkPalindrome(text: string): void {
      const cleaned = text.toLowerCase().replace(/[^a-z0-9]/g, '');
      if (cleaned.length < 2) {
        palindrome.classList.add('hidden');
        return;
      }
      const reversed = [...cleaned].reverse().join('');
      const isPalindrome = cleaned === reversed;
      palindrome.classList.remove('hidden');
      if (isPalindrome) {
        palindrome.className = 'mb-4 p-3 rounded-lg text-sm bg-green-50 border border-green-200 text-green-800';
        palindrome.innerHTML = '✓ <strong>Palindrome detected!</strong> This text reads the same forwards and backwards.';
      } else {
        palindrome.className = 'mb-4 p-3 rounded-lg text-sm bg-gray-100 border border-gray-200 text-gray-600';
        palindrome.innerHTML = '✗ Not a palindrome.';
      }
    }

    function update(): void {
      const text = input.value;
      if (!text) {
        output.textContent = '';
        palindrome.classList.add('hidden');
        return;
      }
      output.textContent = reverseText(text, currentMode);
      checkPalindrome(text);
    }

    // Mode button handling
    document.querySelectorAll('.rev-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentMode = (btn as HTMLElement).dataset.mode!;
        document.querySelectorAll('.rev-btn').forEach(b => {
          b.className = 'rev-btn px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-sm font-medium rounded-lg transition-colors';
        });
        btn.className = 'rev-btn px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg transition-colors hover:bg-blue-700';
        update();
      });
    });

    // Live update
    input.addEventListener('input', update);

    document.getElementById('revCopy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(output.textContent || '');
      const btn = document.getElementById('revCopy')!;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = 'Copy', 1500);
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free String Reverser Online</h2>
    <p>Reverse text in multiple ways: reverse the entire string character by character, reverse word order, reverse each word individually, or reverse sentence order. Also checks if your text is a palindrome.</p>
    <h3>Reverse Modes</h3>
    <ul>
      <li><strong>Reverse String</strong> - Flip all characters from end to start</li>
      <li><strong>Reverse Words</strong> - Keep words intact but reverse their order</li>
      <li><strong>Reverse Each Word</strong> - Reverse characters within each word</li>
      <li><strong>Reverse Sentences</strong> - Reverse the order of sentences</li>
      <li><strong>Palindrome Checker</strong> - Detect if text is the same forwards and backwards</li>
    </ul>
  </Fragment>
</ToolLayout>
