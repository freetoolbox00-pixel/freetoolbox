---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Number to Words" description="Convert numbers to words in English. Supports decimals, negatives, and currency format. Free online converter." category="utility" icon="🔤">
  <div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Enter a number</label>
      <input type="text" id="nwInput" class="w-full px-3 py-3 border border-gray-300 rounded-lg text-lg font-mono" placeholder="e.g. 1234.56" />
    </div>
    <div class="flex gap-3 mb-4">
      <label class="flex items-center gap-2 text-sm"><input type="radio" name="nwMode" value="words" checked /> Words</label>
      <label class="flex items-center gap-2 text-sm"><input type="radio" name="nwMode" value="currency" /> Currency (USD)</label>
      <label class="flex items-center gap-2 text-sm"><input type="radio" name="nwMode" value="ordinal" /> Ordinal</label>
    </div>
    <div id="nwResult" class="p-4 bg-blue-50 border border-blue-200 rounded-lg min-h-[60px]">
      <div class="flex justify-between mb-1"><span class="text-xs text-blue-600">Result</span><button id="nwCopy" class="text-xs text-blue-600 hover:underline">Copy</button></div>
      <div id="nwOutput" class="text-lg font-medium text-blue-900 capitalize"></div>
    </div>
  </div>
</ToolLayout>

<script>
  const input = document.getElementById('nwInput') as HTMLInputElement;
  const output = document.getElementById('nwOutput')!;
  const copyBtn = document.getElementById('nwCopy')!;

  const ones = ['','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve','thirteen','fourteen','fifteen','sixteen','seventeen','eighteen','nineteen'];
  const tens = ['','','twenty','thirty','forty','fifty','sixty','seventy','eighty','ninety'];
  const scales = ['','thousand','million','billion','trillion','quadrillion'];

  function chunk(n: number): string {
    if (n === 0) return '';
    if (n < 20) return ones[n];
    if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 ? '-' + ones[n % 10] : '');
    return ones[Math.floor(n / 100)] + ' hundred' + (n % 100 ? ' and ' + chunk(n % 100) : '');
  }

  function toWords(n: number): string {
    if (n === 0) return 'zero';
    if (n < 0) return 'negative ' + toWords(-n);
    let result = '';
    let idx = 0;
    let num = Math.floor(n);
    while (num > 0) {
      const part = num % 1000;
      if (part > 0) {
        const w = chunk(part) + (scales[idx] ? ' ' + scales[idx] : '');
        result = w + (result ? ', ' + result : '');
      }
      num = Math.floor(num / 1000);
      idx++;
    }
    return result;
  }

  function convert() {
    const raw = input.value.replace(/,/g, '').trim();
    if (!raw) { output.textContent = ''; return; }
    const num = parseFloat(raw);
    if (isNaN(num)) { output.textContent = 'Invalid number'; return; }
    const mode = (document.querySelector('input[name="nwMode"]:checked') as HTMLInputElement).value;

    if (mode === 'currency') {
      const dollars = Math.floor(Math.abs(num));
      const cents = Math.round((Math.abs(num) - dollars) * 100);
      let text = toWords(dollars) + ' dollar' + (dollars !== 1 ? 's' : '');
      if (cents > 0) text += ' and ' + toWords(cents) + ' cent' + (cents !== 1 ? 's' : '');
      if (num < 0) text = 'negative ' + text;
      output.textContent = text;
    } else if (mode === 'ordinal') {
      const n = Math.floor(Math.abs(num));
      let w = toWords(n);
      if (w.endsWith('one')) w = w.slice(0, -3) + 'first';
      else if (w.endsWith('two')) w = w.slice(0, -3) + 'second';
      else if (w.endsWith('three')) w = w.slice(0, -5) + 'third';
      else if (w.endsWith('five')) w = w.slice(0, -4) + 'fifth';
      else if (w.endsWith('eight')) w = w.slice(0, -5) + 'eighth';
      else if (w.endsWith('nine')) w = w.slice(0, -4) + 'ninth';
      else if (w.endsWith('twelve')) w = w.slice(0, -6) + 'twelfth';
      else if (w.endsWith('y')) w = w.slice(0, -1) + 'ieth';
      else w += 'th';
      output.textContent = w;
    } else {
      let text = toWords(num);
      const dec = raw.split('.')[1];
      if (dec) text += ' point ' + dec.split('').map(d => ones[parseInt(d)] || 'zero').join(' ');
      output.textContent = text;
    }
  }

  input.addEventListener('input', convert);
  document.querySelectorAll('input[name="nwMode"]').forEach(r => r.addEventListener('change', convert));
  copyBtn.addEventListener('click', () => { navigator.clipboard.writeText(output.textContent || ''); copyBtn.textContent = 'Copied!'; setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500); });
</script>
