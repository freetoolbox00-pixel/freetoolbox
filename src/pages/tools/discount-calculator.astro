---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Discount Calculator" description="Calculate discount price, savings and final amount. Multiple discounts, bulk pricing. Free online discount calculator." category="utility" icon="🏷️">
  <div>
    <div class="grid gap-4 sm:grid-cols-3 mb-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Original Price ($)</label>
        <input type="number" id="dcPrice" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="100" min="0" step="0.01" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Discount (%)</label>
        <input type="number" id="dcDiscount" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="20" min="0" max="100" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">2nd Discount (%)</label>
        <input type="number" id="dcDiscount2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="0" min="0" max="100" placeholder="Optional" />
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-3 mb-6">
      <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-center">
        <div class="text-xs text-green-600">Final Price</div>
        <div class="text-3xl font-bold text-green-700" id="dcFinal">$80.00</div>
      </div>
      <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-center">
        <div class="text-xs text-red-600">You Save</div>
        <div class="text-3xl font-bold text-red-600" id="dcSave">$20.00</div>
      </div>
      <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-center">
        <div class="text-xs text-blue-600">Total Discount</div>
        <div class="text-3xl font-bold text-blue-700" id="dcTotal">20%</div>
      </div>
    </div>
    <h3 class="text-lg font-semibold text-gray-900 mb-3">Quick Discounts</h3>
    <div id="dcQuick" class="grid grid-cols-3 sm:grid-cols-5 gap-2"></div>
  </div>
</ToolLayout>

<script>
  const priceIn = document.getElementById('dcPrice') as HTMLInputElement;
  const discIn = document.getElementById('dcDiscount') as HTMLInputElement;
  const disc2In = document.getElementById('dcDiscount2') as HTMLInputElement;
  const finalEl = document.getElementById('dcFinal')!;
  const saveEl = document.getElementById('dcSave')!;
  const totalEl = document.getElementById('dcTotal')!;
  const quickEl = document.getElementById('dcQuick')!;

  function calc() {
    const price = parseFloat(priceIn.value) || 0;
    const d1 = parseFloat(discIn.value) || 0;
    const d2 = parseFloat(disc2In.value) || 0;
    let final_ = price * (1 - d1 / 100);
    if (d2 > 0) final_ = final_ * (1 - d2 / 100);
    const saved = price - final_;
    const totalPct = price > 0 ? (saved / price * 100) : 0;
    finalEl.textContent = '$' + final_.toFixed(2);
    saveEl.textContent = '$' + saved.toFixed(2);
    totalEl.textContent = totalPct.toFixed(1) + '%';

    const quicks = [5, 10, 15, 20, 25, 30, 40, 50, 60, 75];
    quickEl.innerHTML = quicks.map(q => {
      const f = price * (1 - q / 100);
      return `<div class="p-2 bg-gray-50 rounded-lg text-center border border-gray-200"><div class="text-sm font-bold text-gray-900">${q}%</div><div class="text-xs text-gray-500">$${f.toFixed(2)}</div></div>`;
    }).join('');
  }

  [priceIn, discIn, disc2In].forEach(el => el.addEventListener('input', calc));
  calc();
</script>
