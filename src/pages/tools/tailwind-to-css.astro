---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Tailwind to CSS Converter"
  description="Convert Tailwind CSS classes to plain CSS and vice versa. Real-time conversion with extensive class mappings. Supports spacing, colors, typography, layout, flexbox, grid and more. Free Tailwind converter."
  category="developer"
  icon="🌊"
>
  <div>
    <!-- Mode Toggle -->
    <div class="flex mb-6 bg-gray-100 rounded-lg p-1">
      <button id="modeT2C" class="flex-1 py-2 px-4 rounded-md text-sm font-medium bg-white shadow text-blue-600 transition-all">Tailwind &rarr; CSS</button>
      <button id="modeC2T" class="flex-1 py-2 px-4 rounded-md text-sm font-medium text-gray-600 hover:text-gray-800 transition-all">CSS &rarr; Tailwind</button>
    </div>

    <!-- Tailwind to CSS -->
    <div id="t2cSection">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Tailwind Classes</label>
        <textarea id="twInput" rows="3" placeholder="p-4 bg-blue-500 text-white rounded-lg flex items-center gap-2 hover:bg-blue-600" class="w-full px-4 py-3 border border-gray-300 rounded-lg font-mono text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-y"></textarea>
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-sm font-medium text-gray-700">CSS Output</label>
          <button id="copyCSS" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Copy</button>
        </div>
        <pre id="cssOutput" class="p-4 bg-gray-900 text-green-400 rounded-lg font-mono text-sm whitespace-pre-wrap min-h-[120px]"></pre>
      </div>
    </div>

    <!-- CSS to Tailwind -->
    <div id="c2tSection" class="hidden">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">CSS Properties</label>
        <textarea id="cssInput" rows="5" placeholder="padding: 1rem;&#10;background-color: #3b82f6;&#10;color: white;&#10;border-radius: 0.5rem;&#10;display: flex;&#10;align-items: center;" class="w-full px-4 py-3 border border-gray-300 rounded-lg font-mono text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-y"></textarea>
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-sm font-medium text-gray-700">Tailwind Classes</label>
          <button id="copyTW" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Copy</button>
        </div>
        <pre id="twOutput" class="p-4 bg-gray-900 text-green-400 rounded-lg font-mono text-sm whitespace-pre-wrap min-h-[120px]"></pre>
      </div>
    </div>

    <!-- Common examples -->
    <div class="mt-6">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Quick Examples (click to load)</h3>
      <div class="flex flex-wrap gap-2" id="exampleBtns">
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="p-4 m-2 bg-blue-500 text-white font-bold rounded-lg">Card</button>
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="flex items-center justify-between gap-4 w-full">Flex Row</button>
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="grid grid-cols-3 gap-4 p-6">Grid</button>
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="text-2xl font-semibold text-gray-900 tracking-tight leading-tight">Typography</button>
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors cursor-pointer">Button</button>
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="absolute top-0 left-0 w-full h-full opacity-50 z-10">Overlay</button>
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="border-2 border-dashed border-gray-300 rounded-xl shadow-lg">Border</button>
        <button class="example-btn px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded text-xs" data-tw="max-w-md mx-auto overflow-hidden truncate">Container</button>
      </div>
    </div>

    <!-- Copy notification -->
    <div id="copyNotif" class="fixed bottom-6 right-6 bg-gray-900 text-white px-4 py-2 rounded-lg text-sm opacity-0 transition-opacity duration-300 pointer-events-none z-50">
      Copied!
    </div>
  </div>

