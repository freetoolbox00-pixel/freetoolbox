      "stone-50": "#fafaf9", "stone-100": "#f5f5f4", "stone-200": "#e7e5e4", "stone-300": "#d6d3d1", "stone-400": "#a8a29e", "stone-500": "#78716c", "stone-600": "#57534e", "stone-700": "#44403c", "stone-800": "#292524", "stone-900": "#1c1917",
      "zinc-50": "#fafafa", "zinc-100": "#f4f4f5", "zinc-200": "#e4e4e7", "zinc-300": "#d4d4d8", "zinc-400": "#a1a1aa", "zinc-500": "#71717a", "zinc-600": "#52525b", "zinc-700": "#3f3f46", "zinc-800": "#27272a", "zinc-900": "#18181b",
      "neutral-50": "#fafafa", "neutral-100": "#f5f5f5", "neutral-200": "#e5e5e5", "neutral-300": "#d4d4d4", "neutral-400": "#a3a3a3", "neutral-500": "#737373", "neutral-600": "#525252", "neutral-700": "#404040", "neutral-800": "#262626", "neutral-900": "#171717",
    };

    function parseTailwindClass(cls: string): string | null {
      // Direct lookup
      if (twToCSS[cls]) return twToCSS[cls];

      // Handle hover:, focus:, etc. — strip modifier prefix
      const modMatch = cls.match(/^(hover|focus|active|disabled|visited|first|last|odd|even|group-hover|focus-within|focus-visible|dark|sm|md|lg|xl|2xl):/);
      if (modMatch) {
        const inner = cls.slice(modMatch[0].length);
        const innerCSS = parseTailwindClass(inner);
        if (innerCSS) return `/* ${modMatch[1]}: */ ${innerCSS}`;
        return null;
      }

      // Spacing: p, px, py, pt, pr, pb, pl, m, mx, my, mt, mr, mb, ml, gap
      const spacingProps: Record<string, string[]> = {
        "p": ["padding"], "px": ["padding-left", "padding-right"], "py": ["padding-top", "padding-bottom"],
        "pt": ["padding-top"], "pr": ["padding-right"], "pb": ["padding-bottom"], "pl": ["padding-left"],
        "m": ["margin"], "mx": ["margin-left", "margin-right"], "my": ["margin-top", "margin-bottom"],
        "mt": ["margin-top"], "mr": ["margin-right"], "mb": ["margin-bottom"], "ml": ["margin-left"],
        "gap": ["gap"], "gap-x": ["column-gap"], "gap-y": ["row-gap"],
        "space-x": ["column-gap"], "space-y": ["row-gap"],
      };

      for (const [prefix, props] of Object.entries(spacingProps)) {
        const re = new RegExp(`^-?${prefix.replace("-", "\\-")}-(\\S+)$`);
        const m = cls.match(re);
        if (m) {
          const neg = cls.startsWith("-");
          const sizeKey = m[1];
          const val = spacingScale[sizeKey];
          if (val) {
            const v = neg ? `-${val}` : val;
            return props.map(p => `${p}: ${v};`).join(" ");
          }
        }
      }

      // Width/Height: w-N, h-N
      const whMatch = cls.match(/^(w|h)-([\d.]+)$/);
      if (whMatch) {
        const prop = whMatch[1] === "w" ? "width" : "height";
        const val = spacingScale[whMatch[2]];
        if (val) return `${prop}: ${val};`;
      }

      // Min/Max width/height with scale
      const minMaxMatch = cls.match(/^(min|max)-(w|h)-([\d.]+)$/);
      if (minMaxMatch) {
        const mm = minMaxMatch[1];
        const wh = minMaxMatch[2] === "w" ? "width" : "height";
        const val = spacingScale[minMaxMatch[3]];
        if (val) return `${mm}-${wh}: ${val};`;
      }

      // Top/right/bottom/left with spacing
      const posMatch = cls.match(/^-?(top|right|bottom|left)-([\d.]+|px)$/);
      if (posMatch) {
        const neg = cls.startsWith("-");
        const val = spacingScale[posMatch[2]];
        if (val) return `${posMatch[1]}: ${neg ? '-' : ''}${val};`;
      }

      // Text color
      const textColorMatch = cls.match(/^text-(.+)$/);
      if (textColorMatch && colorMap[textColorMatch[1]]) {
        return `color: ${colorMap[textColorMatch[1]]};`;
      }

      // Background color
      const bgColorMatch = cls.match(/^bg-(.+)$/);
      if (bgColorMatch && colorMap[bgColorMatch[1]]) {
        return `background-color: ${colorMap[bgColorMatch[1]]};`;
      }

      // Border color
      const borderColorMatch = cls.match(/^border-(.+)$/);
      if (borderColorMatch && colorMap[borderColorMatch[1]]) {
        return `border-color: ${colorMap[borderColorMatch[1]]};`;
      }

      // Border width
      const borderMatch = cls.match(/^border(?:-(t|r|b|l|x|y))?(?:-(\d+))?$/);
      if (borderMatch) {
        const side = borderMatch[1];
        const width = borderMatch[2] ? `${borderMatch[2]}px` : "1px";
        if (!side) return `border-width: ${width};`;
        const sideMap: Record<string, string[]> = {
          t: ["border-top-width"], r: ["border-right-width"], b: ["border-bottom-width"], l: ["border-left-width"],
          x: ["border-left-width", "border-right-width"], y: ["border-top-width", "border-bottom-width"],
        };
        return (sideMap[side] || []).map(p => `${p}: ${width};`).join(" ");
      }

      // Rotate
      const rotateMatch = cls.match(/^-?rotate-(\d+)$/);
      if (rotateMatch) {
        const neg = cls.startsWith("-");
        return `transform: rotate(${neg ? '-' : ''}${rotateMatch[1]}deg);`;
      }

      // Scale
      const scaleMatch = cls.match(/^scale-(\d+)$/);
      if (scaleMatch) {
        return `transform: scale(${parseInt(scaleMatch[1]) / 100});`;
      }

      // Translate
      const translateMatch = cls.match(/^-?translate-(x|y)-([\d.]+|px|full|1\/2)$/);
      if (translateMatch) {
        const neg = cls.startsWith("-");
        const axis = translateMatch[1];
        const rawVal = translateMatch[2];
        let val: string;
        if (rawVal === "full") val = "100%";
        else if (rawVal === "1/2") val = "50%";
        else val = spacingScale[rawVal] || rawVal;
        const fn = axis === "x" ? "translateX" : "translateY";
        return `transform: ${fn}(${neg ? '-' : ''}${val});`;
      }

      // Ring
      const ringMatch = cls.match(/^ring(?:-(\d+))?$/);
      if (ringMatch) {
        const w = ringMatch[1] || "3";
        return `box-shadow: 0 0 0 ${w}px rgba(59, 130, 246, 0.5);`;
      }

      // Rounded with sides
      const roundedSideMatch = cls.match(/^rounded-(t|r|b|l|tl|tr|bl|br)(?:-(none|sm|md|lg|xl|2xl|3xl|full))?$/);
      if (roundedSideMatch) {
        const sideKey = roundedSideMatch[1];
        const sizeKey = roundedSideMatch[2] || "";
        const radiusMap: Record<string, string> = {
          "none": "0px", "sm": "0.125rem", "": "0.25rem", "md": "0.375rem",
          "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "3xl": "1.5rem", "full": "9999px"
        };
        const radius = radiusMap[sizeKey] || "0.25rem";
        const corners: Record<string, string[]> = {
          "t": ["border-top-left-radius", "border-top-right-radius"],
          "r": ["border-top-right-radius", "border-bottom-right-radius"],
          "b": ["border-bottom-left-radius", "border-bottom-right-radius"],
          "l": ["border-top-left-radius", "border-bottom-left-radius"],
          "tl": ["border-top-left-radius"], "tr": ["border-top-right-radius"],
          "bl": ["border-bottom-left-radius"], "br": ["border-bottom-right-radius"],
        };
        return (corners[sideKey] || []).map(p => `${p}: ${radius};`).join(" ");
      }

      return null;
    }

    // Reverse mapping: CSS to Tailwind
    const cssToTwMap: Record<string, string> = {};
    for (const [tw, css] of Object.entries(twToCSS)) {
      const normalized = css.replace(/\s+/g, " ").trim().toLowerCase();
      cssToTwMap[normalized] = tw;
    }
    // Add spacing and color reverse lookups
    for (const [key, val] of Object.entries(spacingScale)) {
      cssToTwMap[`padding: ${val};`] = `p-${key}`;
      cssToTwMap[`margin: ${val};`] = `m-${key}`;
      cssToTwMap[`gap: ${val};`] = `gap-${key}`;
      cssToTwMap[`padding-top: ${val};`] = `pt-${key}`;
      cssToTwMap[`padding-bottom: ${val};`] = `pb-${key}`;
      cssToTwMap[`padding-left: ${val};`] = `pl-${key}`;
      cssToTwMap[`padding-right: ${val};`] = `pr-${key}`;
      cssToTwMap[`margin-top: ${val};`] = `mt-${key}`;
      cssToTwMap[`margin-bottom: ${val};`] = `mb-${key}`;
      cssToTwMap[`margin-left: ${val};`] = `ml-${key}`;
      cssToTwMap[`margin-right: ${val};`] = `mr-${key}`;
      cssToTwMap[`width: ${val};`] = `w-${key}`;
      cssToTwMap[`height: ${val};`] = `h-${key}`;
    }
    for (const [name, hex] of Object.entries(colorMap)) {
      cssToTwMap[`color: ${hex};`] = `text-${name}`;
      cssToTwMap[`background-color: ${hex};`] = `bg-${name}`;
      cssToTwMap[`border-color: ${hex};`] = `border-${name}`;
    }

    function cssPropertyToTailwind(prop: string, val: string): string | null {
      const normalized = `${prop.trim()}: ${val.trim().replace(/;$/, "")};`.toLowerCase();
      if (cssToTwMap[normalized]) return cssToTwMap[normalized];

      // Try color name matching
      if (prop === "color" || prop === "background-color" || prop === "border-color") {
        const prefix = prop === "color" ? "text" : prop === "background-color" ? "bg" : "border";
        for (const [name, hex] of Object.entries(colorMap)) {
          if (val.trim().replace(";", "").toLowerCase() === hex.toLowerCase()) {
            return `${prefix}-${name}`;
          }
        }
      }

      return null;
    }

    // DOM elements
    const twInput = document.getElementById("twInput") as HTMLTextAreaElement;
    const cssOutput = document.getElementById("cssOutput")!;
    const cssInput = document.getElementById("cssInput") as HTMLTextAreaElement;
    const twOutput = document.getElementById("twOutput")!;
    const copyNotif = document.getElementById("copyNotif")!;
    const modeT2C = document.getElementById("modeT2C")!;
    const modeC2T = document.getElementById("modeC2T")!;
    const t2cSection = document.getElementById("t2cSection")!;
    const c2tSection = document.getElementById("c2tSection")!;

    function convertTailwindToCSS(): void {
      const input = twInput.value.trim();
      if (!input) { cssOutput.textContent = "/* Enter Tailwind classes above */"; return; }

      const classes = input.split(/\s+/).filter(Boolean);
      const results: string[] = [];
      const unknowns: string[] = [];

      for (const cls of classes) {
        const css = parseTailwindClass(cls);
        if (css) {
          results.push(`  ${css}`);
        } else {
          unknowns.push(cls);
        }
      }

      let output = ".element {\n" + results.join("\n") + "\n}";
      if (unknowns.length > 0) {
        output += "\n\n/* Unknown classes (may need custom config):\n   " + unknowns.join(", ") + " */";
      }

      cssOutput.textContent = output;
    }

    function convertCSSToTailwind(): void {
      const input = cssInput.value.trim();
      if (!input) { twOutput.textContent = "/* Enter CSS above */"; return; }

      const lines = input.split("\n").map(l => l.trim()).filter(l => l && !l.startsWith("{") && !l.startsWith("}") && !l.startsWith("/*") && !l.startsWith(".") && !l.startsWith("//"));
      const twClasses: string[] = [];
      const unknowns: string[] = [];

      for (const line of lines) {
        const match = line.match(/^([a-z-]+)\s*:\s*(.+?)$/);
        if (match) {
          const prop = match[1].trim();
          const val = match[2].trim().replace(/;$/, "");
          const tw = cssPropertyToTailwind(prop, val);
          if (tw) {
            twClasses.push(tw);
          } else {
            unknowns.push(`${prop}: ${val}`);
          }
        }
      }

      let output = twClasses.join(" ");
      if (unknowns.length > 0) {
        output += "\n\n/* No direct Tailwind equivalent found:\n   " + unknowns.join("\n   ") + " */";
      }
      if (!output.trim()) {
        output = "/* No matching Tailwind classes found */";
      }

      twOutput.textContent = output;
    }

    // Mode toggle
    modeT2C.addEventListener("click", () => {
      t2cSection.classList.remove("hidden");
      c2tSection.classList.add("hidden");
      modeT2C.classList.add("bg-white", "shadow", "text-blue-600");
      modeT2C.classList.remove("text-gray-600");
      modeC2T.classList.remove("bg-white", "shadow", "text-blue-600");
      modeC2T.classList.add("text-gray-600");
    });

    modeC2T.addEventListener("click", () => {
      c2tSection.classList.remove("hidden");
      t2cSection.classList.add("hidden");
      modeC2T.classList.add("bg-white", "shadow", "text-blue-600");
      modeC2T.classList.remove("text-gray-600");
      modeT2C.classList.remove("bg-white", "shadow", "text-blue-600");
      modeT2C.classList.add("text-gray-600");
    });

    // Real-time conversion
    twInput.addEventListener("input", convertTailwindToCSS);
    cssInput.addEventListener("input", convertCSSToTailwind);

    // Examples
    document.querySelectorAll(".example-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const tw = (btn as HTMLElement).dataset.tw || "";
        twInput.value = tw;
        // Switch to T2C mode
        modeT2C.click();
        convertTailwindToCSS();
      });
    });

    // Copy buttons
    function showCopyNotif(): void {
      copyNotif.style.opacity = "1";
      setTimeout(() => { copyNotif.style.opacity = "0"; }, 1500);
    }

    document.getElementById("copyCSS")!.addEventListener("click", async () => {
      await navigator.clipboard.writeText(cssOutput.textContent || "");
      showCopyNotif();
    });

    document.getElementById("copyTW")!.addEventListener("click", async () => {
      await navigator.clipboard.writeText(twOutput.textContent || "");
      showCopyNotif();
    });

    convertTailwindToCSS();
  </script>

