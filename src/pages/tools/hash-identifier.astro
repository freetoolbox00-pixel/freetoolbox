---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Hash Identifier"
  description="Identify hash types from a hash string. Detects MD5, SHA-1, SHA-256, SHA-512, bcrypt, CRC32 and more. Free online hash analyzer."
  category="security"
  icon="🔍"
>
  <div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Paste a hash</label>
      <input type="text" id="hiHash" class="w-full px-3 py-3 border border-gray-300 rounded-lg font-mono text-sm" placeholder="e.g. 5d41402abc4b2a76b9719d911017c592" />
    </div>

    <button id="hiBtn" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium mb-6">Identify</button>

    <div id="hiResult" class="hidden">
      <div class="mb-3 text-sm text-gray-500">Length: <span id="hiLen" class="font-mono font-medium text-gray-900">0</span> characters</div>
      <div id="hiMatches" class="space-y-2"></div>
      <div id="hiNone" class="hidden p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-sm text-yellow-700">No known hash type matched. Check for typos or extra whitespace.</div>
    </div>
  </div>
</ToolLayout>

<script>
  const hashIn = document.getElementById('hiHash') as HTMLInputElement;
  const btn = document.getElementById('hiBtn')!;
  const resultEl = document.getElementById('hiResult')!;
  const lenEl = document.getElementById('hiLen')!;
  const matchesEl = document.getElementById('hiMatches')!;
  const noneEl = document.getElementById('hiNone')!;

  const HASHES = [
    { name: 'CRC16', regex: /^[a-f0-9]{4}$/i, desc: '16-bit checksum' },
    { name: 'CRC32', regex: /^[a-f0-9]{8}$/i, desc: '32-bit checksum' },
    { name: 'MD4', regex: /^[a-f0-9]{32}$/i, desc: '128-bit, broken' },
    { name: 'MD5', regex: /^[a-f0-9]{32}$/i, desc: '128-bit, insecure, widely used' },
    { name: 'NTLM', regex: /^[a-f0-9]{32}$/i, desc: '128-bit, Windows authentication' },
    { name: 'SHA-1', regex: /^[a-f0-9]{40}$/i, desc: '160-bit, deprecated' },
    { name: 'RIPEMD-160', regex: /^[a-f0-9]{40}$/i, desc: '160-bit, Bitcoin addresses' },
    { name: 'SHA-224', regex: /^[a-f0-9]{56}$/i, desc: '224-bit, SHA-2 family' },
    { name: 'SHA-256', regex: /^[a-f0-9]{64}$/i, desc: '256-bit, SHA-2, very common' },
    { name: 'SHA-384', regex: /^[a-f0-9]{96}$/i, desc: '384-bit, SHA-2 family' },
    { name: 'SHA-512', regex: /^[a-f0-9]{128}$/i, desc: '512-bit, SHA-2 family' },
    { name: 'SHA3-256', regex: /^[a-f0-9]{64}$/i, desc: '256-bit, SHA-3 family' },
    { name: 'SHA3-512', regex: /^[a-f0-9]{128}$/i, desc: '512-bit, SHA-3 family' },
    { name: 'bcrypt', regex: /^\$2[abxy]?\$\d{2}\$.{53}$/i, desc: 'Password hashing, 60 chars' },
    { name: 'scrypt', regex: /^\$s0\$/, desc: 'Memory-hard password hash' },
    { name: 'Argon2', regex: /^\$argon2(id?|d)\$/, desc: 'Modern password hash' },
    { name: 'MySQL 4.1+', regex: /^\*[a-f0-9]{40}$/i, desc: 'MySQL password hash' },
    { name: 'Base64 (not a hash)', regex: /^[A-Za-z0-9+/]+=*$/, desc: 'Encoding, not hashing' },
    { name: 'MD5 (Unix)', regex: /^\$1\$[a-zA-Z0-9./]{8}\$[a-zA-Z0-9./]{22}$/, desc: 'crypt() MD5' },
    { name: 'SHA-256 (Unix)', regex: /^\$5\$/, desc: 'crypt() SHA-256' },
    { name: 'SHA-512 (Unix)', regex: /^\$6\$/, desc: 'crypt() SHA-512' },
  ];

  btn.addEventListener('click', () => {
    const hash = hashIn.value.trim();
    if (!hash) return;

    resultEl.classList.remove('hidden');
    lenEl.textContent = String(hash.length);

    const matches = HASHES.filter(h => h.regex.test(hash));

    if (matches.length === 0) {
      matchesEl.innerHTML = '';
      noneEl.classList.remove('hidden');
      return;
    }

    noneEl.classList.add('hidden');
    matchesEl.innerHTML = matches.map((m, i) => `
      <div class="flex items-center gap-3 p-3 ${i === 0 ? 'bg-green-50 border-green-200' : 'bg-gray-50 border-gray-200'} border rounded-lg">
        <div class="flex-1">
          <div class="font-medium text-gray-900">${m.name}</div>
          <div class="text-xs text-gray-500">${m.desc}</div>
        </div>
        ${i === 0 ? '<span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded font-medium">Most likely</span>' : '<span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded">Possible</span>'}
      </div>
    `).join('');
  });

  hashIn.addEventListener('keydown', e => { if (e.key === 'Enter') btn.click(); });
</script>
