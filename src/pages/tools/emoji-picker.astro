---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Emoji Picker & Search"
  description="Search and copy emojis by name or category. Browse all Unicode emojis with one-click copy. Free emoji finder and picker tool."
  category="text"
  icon="😀"
>
  <div>
    <!-- Search -->
    <div class="mb-4">
      <input type="text" id="emojiSearch" placeholder="Search emojis... (e.g. heart, fire, face)" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-base" />
    </div>

    <!-- Category tabs -->
    <div class="flex flex-wrap gap-1 mb-4">
      <button class="emoji-cat px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium" data-cat="all">All</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="smileys">😀 Smileys</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="people">👋 People</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="animals">🐶 Animals</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="food">🍕 Food</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="travel">✈️ Travel</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="objects">💡 Objects</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="symbols">❤️ Symbols</button>
      <button class="emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm" data-cat="flags">🏁 Flags</button>
    </div>

    <!-- Copied notification -->
    <div id="emojiNotify" class="mb-4 hidden">
      <div class="p-2 bg-green-50 text-green-700 text-sm rounded-lg text-center font-medium"></div>
    </div>

    <!-- Emoji Grid -->
    <div id="emojiGrid" class="grid grid-cols-8 sm:grid-cols-12 lg:grid-cols-16 gap-1 max-h-[400px] overflow-y-auto p-2"></div>

    <!-- Recently Copied -->
    <div class="mt-6 pt-4 border-t border-gray-200">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Recently Copied</h3>
      <div id="recentEmojis" class="flex flex-wrap gap-2 text-2xl min-h-[40px]"></div>
    </div>
  </div>

