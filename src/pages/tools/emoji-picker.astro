      ],
      people: [
        ['👋','wave'],['🤚','raised back hand'],['🖐️','hand fingers'],['✋','raised hand'],['🖖','vulcan'],['👌','ok hand'],['🤌','pinched fingers'],['🤏','pinching hand'],['✌️','victory'],['🤞','crossed fingers'],['🫰','hand heart'],['🤟','love you'],['🤘','rock on'],['🤙','call me'],['👈','point left'],['👉','point right'],['👆','point up'],['👇','point down'],['☝️','index up'],['👍','thumbs up'],['👎','thumbs down'],['✊','fist'],['👊','punch'],['🤛','left fist'],['🤜','right fist'],['👏','clap'],['🙌','raised hands'],['👐','open hands'],['🤲','palms up'],['🤝','handshake'],['🙏','pray please'],['✍️','writing'],['💪','muscle strong'],['🦾','mechanical arm'],['🧠','brain'],['👀','eyes looking'],['👁️','eye'],['👅','tongue'],['👄','lips mouth'],
      ],
      animals: [
        ['🐶','dog'],['🐱','cat'],['🐭','mouse'],['🐹','hamster'],['🐰','rabbit'],['🦊','fox'],['🐻','bear'],['🐼','panda'],['🐨','koala'],['🐯','tiger'],['🦁','lion'],['🐮','cow'],['🐷','pig'],['🐸','frog'],['🐵','monkey'],['🐔','chicken'],['🐧','penguin'],['🐦','bird'],['🦅','eagle'],['🦆','duck'],['🦉','owl'],['🐺','wolf'],['🐗','boar'],['🐴','horse'],['🦄','unicorn'],['🐝','bee'],['🪱','worm'],['🐛','bug'],['🦋','butterfly'],['🐌','snail'],['🐞','ladybug'],['🐢','turtle'],['🐍','snake'],['🦎','lizard'],['🦂','scorpion'],['🕷️','spider'],['🐙','octopus'],['🦑','squid'],['🐠','fish'],['🐬','dolphin'],['🐳','whale'],['🦈','shark'],['🐊','crocodile'],['🦓','zebra'],['🦒','giraffe'],['🦬','bison'],['🐘','elephant'],
      ],
      food: [
        ['🍎','apple'],['🍐','pear'],['🍊','orange'],['🍋','lemon'],['🍌','banana'],['🍉','watermelon'],['🍇','grapes'],['🍓','strawberry'],['🫐','blueberries'],['🍑','peach'],['🥭','mango'],['🍍','pineapple'],['🥥','coconut'],['🥝','kiwi'],['🍅','tomato'],['🥑','avocado'],['🍆','eggplant'],['🥦','broccoli'],['🥬','leafy green'],['🌽','corn'],['🌶️','hot pepper'],['🫑','bell pepper'],['🥒','cucumber'],['🥕','carrot'],['🧄','garlic'],['🧅','onion'],['🥔','potato'],['🍞','bread'],['🥐','croissant'],['🍕','pizza'],['🌭','hot dog'],['🍔','hamburger'],['🍟','fries'],['🌮','taco'],['🌯','burrito'],['🥗','salad'],['🍣','sushi'],['🍜','ramen noodle'],['🍝','spaghetti'],['🍦','ice cream'],['🍩','donut'],['🍪','cookie'],['🎂','birthday cake'],['🍫','chocolate'],['☕','coffee'],['🍵','tea'],['🧃','juice box'],['🍺','beer'],['🍷','wine'],
      ],
      travel: [
        ['🚗','car'],['🚕','taxi'],['🚌','bus'],['🚎','trolley'],['🏎️','racing car'],['🚓','police car'],['🚑','ambulance'],['🚒','fire engine'],['✈️','airplane'],['🚀','rocket'],['🛸','ufo'],['🚁','helicopter'],['🛶','canoe'],['⛵','sailboat'],['🚢','ship'],['🏠','house'],['🏢','office'],['🏥','hospital'],['🏫','school'],['🏰','castle'],['🗼','tower'],['🗽','statue liberty'],['⛲','fountain'],['🌋','volcano'],['🏔️','mountain snow'],['🏖️','beach'],['🏝️','island'],['🌍','globe europe'],['🌎','globe americas'],['🌏','globe asia'],['🗺️','world map'],
      ],
      objects: [
        ['💡','light bulb idea'],['🔦','flashlight'],['🕯️','candle'],['💻','laptop computer'],['🖥️','desktop computer'],['⌨️','keyboard'],['🖱️','mouse'],['📱','phone mobile'],['📞','telephone'],['📷','camera'],['📹','video camera'],['🎥','movie camera'],['📺','television tv'],['📻','radio'],['🎧','headphones'],['🎤','microphone'],['🎵','music note'],['🎶','music notes'],['🎸','guitar'],['🎹','piano keyboard'],['🥁','drum'],['📚','books'],['📖','book open'],['📝','memo writing'],['✏️','pencil'],['🖊️','pen'],['📌','pin'],['📎','paperclip'],['🔑','key'],['🔒','lock locked'],['🔓','lock unlocked'],['🛠️','tools hammer wrench'],['⚙️','gear settings'],['🧲','magnet'],['💎','gem diamond'],['💰','money bag'],['💳','credit card'],['📊','chart bar'],['📈','chart up trending'],['📉','chart down'],
      ],
      symbols: [
        ['❤️','red heart love'],['🧡','orange heart'],['💛','yellow heart'],['💚','green heart'],['💙','blue heart'],['💜','purple heart'],['🖤','black heart'],['🤍','white heart'],['💔','broken heart'],['❣️','heart exclamation'],['💕','two hearts'],['💞','revolving hearts'],['💓','beating heart'],['💗','growing heart'],['💖','sparkling heart'],['💘','heart arrow cupid'],['💝','heart ribbon'],['✅','check mark green'],['❌','cross mark red'],['❓','question mark'],['❗','exclamation mark'],['⭐','star yellow'],['🌟','glowing star'],['💫','dizzy star'],['✨','sparkles'],['🔥','fire hot'],['💯','hundred perfect'],['🎯','target dart'],['🏆','trophy winner'],['🥇','gold medal first'],['🥈','silver medal second'],['🥉','bronze medal third'],['⚡','lightning bolt zap'],['💣','bomb'],['🕊️','dove peace'],['☮️','peace symbol'],['♻️','recycling'],['⚠️','warning'],['🚫','prohibited no'],['🔴','red circle'],['🟢','green circle'],['🔵','blue circle'],
      ],
      flags: [
        ['🏁','checkered flag'],['🚩','triangular flag'],['🎌','crossed flags'],['🏴','black flag'],['🏳️','white flag'],['🇺🇸','us usa america'],['🇬🇧','uk britain england'],['🇫🇷','france french'],['🇩🇪','germany german'],['🇮🇹','italy italian'],['🇪🇸','spain spanish'],['🇯🇵','japan japanese'],['🇨🇳','china chinese'],['🇰🇷','korea south korean'],['🇧🇷','brazil brazilian'],['🇮🇳','india indian'],['🇷🇺','russia russian'],['🇨🇦','canada canadian'],['🇦🇺','australia australian'],['🇲🇽','mexico mexican'],
      ],
    };

    const grid = document.getElementById('emojiGrid')!;
    const notify = document.getElementById('emojiNotify')!;
    const recent = document.getElementById('recentEmojis')!;
    let currentCat = 'all';
    const recentList: string[] = [];

    function getAllEmojis(): [string, string][] {
      return Object.values(EMOJIS).flat();
    }

    function render(filter = ''): void {
      const emojis = currentCat === 'all' ? getAllEmojis() : (EMOJIS[currentCat] || []);
      const filtered = filter ? emojis.filter(([, name]) => name.toLowerCase().includes(filter.toLowerCase())) : emojis;

      grid.innerHTML = filtered.map(([emoji, name]) =>
        `<button class="emoji-btn w-10 h-10 flex items-center justify-center text-2xl rounded hover:bg-gray-100 cursor-pointer" data-emoji="${emoji}" title="${name}">${emoji}</button>`
      ).join('');

      grid.querySelectorAll('.emoji-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const emoji = (btn as HTMLElement).dataset.emoji!;
          await navigator.clipboard.writeText(emoji);
          notify.classList.remove('hidden');
          notify.querySelector('div')!.textContent = `${emoji} copied to clipboard!`;
          setTimeout(() => notify.classList.add('hidden'), 1500);
          if (!recentList.includes(emoji)) {
            recentList.unshift(emoji);
            if (recentList.length > 20) recentList.pop();
            renderRecent();
          }
        });
      });
    }

    function renderRecent(): void {
      recent.innerHTML = recentList.map(e => `<span class="cursor-pointer hover:scale-125 transition-transform" title="Click to copy">${e}</span>`).join('');
      recent.querySelectorAll('span').forEach(s => {
        s.addEventListener('click', async () => {
          await navigator.clipboard.writeText(s.textContent || '');
          notify.classList.remove('hidden');
          notify.querySelector('div')!.textContent = `${s.textContent} copied!`;
          setTimeout(() => notify.classList.add('hidden'), 1500);
        });
      });
    }

    document.getElementById('emojiSearch')!.addEventListener('input', (e) => {
      render((e.target as HTMLInputElement).value);
    });

    document.querySelectorAll('.emoji-cat').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.emoji-cat').forEach(b => b.className = 'emoji-cat px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm');
        (btn as HTMLElement).className = 'emoji-cat px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium';
        currentCat = (btn as HTMLElement).dataset.cat!;
        render((document.getElementById('emojiSearch') as HTMLInputElement).value);
      });
    });

    render();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Emoji Picker and Search</h2>
    <p>Find and copy emojis by name, keyword or category. Browse hundreds of Unicode emojis organized by type. One-click copy to clipboard.</p>
    <h3>Categories</h3>
    <ul>
      <li><strong>Smileys & Emotion</strong> - Faces, expressions, reactions</li>
      <li><strong>People & Body</strong> - Hands, gestures, body parts</li>
      <li><strong>Animals & Nature</strong> - Animals, plants, weather</li>
      <li><strong>Food & Drink</strong> - Fruits, dishes, beverages</li>
      <li><strong>Symbols</strong> - Hearts, arrows, signs</li>
    </ul>
  </Fragment>
</ToolLayout>
