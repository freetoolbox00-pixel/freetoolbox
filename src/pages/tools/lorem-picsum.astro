---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Random Image Placeholder"
  description="Generate random placeholder images from Lorem Picsum. Set dimensions, apply effects. Get URLs for mockups. Free placeholder image API."
  category="developer"
  icon="🏞"
>
  <div>
    <!-- Controls -->
    <div class="grid gap-4 sm:grid-cols-3 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Width</label>
        <input type="number" id="lpW" value="600" min="10" max="5000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Height</label>
        <input type="number" id="lpH" value="400" min="10" max="5000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Effect</label>
        <select id="lpEffect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="">None</option>
          <option value="grayscale">Grayscale</option>
          <option value="blur">Blur</option>
        </select>
      </div>
    </div>

    <!-- Presets -->
    <div class="flex flex-wrap gap-2 mb-6">
      <button class="lp-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="1920" data-h="1080">1920×1080</button>
      <button class="lp-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="1280" data-h="720">1280×720</button>
      <button class="lp-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="800" data-h="600">800×600</button>
      <button class="lp-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="400" data-h="300">400×300</button>
      <button class="lp-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="300" data-h="300">300×300</button>
      <button class="lp-preset px-3 py-1 bg-gray-100 hover:bg-blue-50 rounded text-xs" data-w="1200" data-h="630">OG Image</button>
    </div>

    <button id="lpGen" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg mb-6">Generate Image</button>
    <button id="lpRefresh" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-lg text-sm mb-6">🔄 New Random</button>

    <!-- Preview -->
    <div class="flex justify-center mb-6">
      <img id="lpImg" class="max-w-full rounded-lg border border-gray-200" alt="Placeholder" />
    </div>

    <!-- URLs -->
    <div class="space-y-3">
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-sm font-medium text-gray-700">Image URL</label>
          <button class="lp-copy text-xs text-blue-600 hover:text-blue-800" data-target="lpUrl">Copy</button>
        </div>
        <input type="text" id="lpUrl" readonly class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-sm font-mono" />
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-sm font-medium text-gray-700">HTML</label>
          <button class="lp-copy text-xs text-blue-600 hover:text-blue-800" data-target="lpHtml">Copy</button>
        </div>
        <input type="text" id="lpHtml" readonly class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-sm font-mono" />
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-sm font-medium text-gray-700">Markdown</label>
          <button class="lp-copy text-xs text-blue-600 hover:text-blue-800" data-target="lpMd">Copy</button>
        </div>
        <input type="text" id="lpMd" readonly class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-sm font-mono" />
      </div>
    </div>
  </div>

  <script>
    let seed = Math.floor(Math.random() * 1000);

    function generate(): void {
      const w = (document.getElementById('lpW') as HTMLInputElement).value;
      const h = (document.getElementById('lpH') as HTMLInputElement).value;
      const effect = (document.getElementById('lpEffect') as HTMLSelectElement).value;

      let url = `https://picsum.photos/seed/${seed}/${w}/${h}`;
      if (effect === 'grayscale') url += '?grayscale';
      else if (effect === 'blur') url += '?blur=5';

      (document.getElementById('lpImg') as HTMLImageElement).src = url;
      (document.getElementById('lpUrl') as HTMLInputElement).value = url;
      (document.getElementById('lpHtml') as HTMLInputElement).value = `<img src="${url}" width="${w}" height="${h}" alt="Placeholder" />`;
      (document.getElementById('lpMd') as HTMLInputElement).value = `![Placeholder](${url})`;
    }

    document.getElementById('lpGen')!.addEventListener('click', generate);
    document.getElementById('lpRefresh')!.addEventListener('click', () => {
      seed = Math.floor(Math.random() * 1000);
      generate();
    });

    document.querySelectorAll('.lp-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        (document.getElementById('lpW') as HTMLInputElement).value = (btn as HTMLElement).dataset.w!;
        (document.getElementById('lpH') as HTMLInputElement).value = (btn as HTMLElement).dataset.h!;
        generate();
      });
    });

    document.querySelectorAll('.lp-copy').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement).dataset.target!;
        navigator.clipboard.writeText((document.getElementById(target) as HTMLInputElement).value);
      });
    });

    generate();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Random Placeholder Image Generator</h2>
    <p>Generate random placeholder images using Lorem Picsum. Set custom dimensions, apply grayscale or blur effects. Get direct URLs, HTML tags and Markdown for your mockups and designs.</p>
  </Fragment>
</ToolLayout>
