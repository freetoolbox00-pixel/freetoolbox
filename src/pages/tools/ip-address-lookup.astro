---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="IP Address Lookup"
  description="Find your public IP address and geolocation. Look up any IP for country, city, ISP and timezone. Free IP lookup tool."
  category="utility"
  icon="🌐"
>
  <div>
    <!-- Your IP -->
    <div class="mb-8 p-6 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl text-center">
      <div class="text-sm text-gray-600 mb-1">Your Public IP Address</div>
      <div id="myIp" class="text-3xl font-bold font-mono text-blue-600 cursor-pointer" title="Click to copy">Loading...</div>
      <div id="myLocation" class="text-sm text-gray-500 mt-2"></div>
    </div>

    <!-- Lookup -->
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-1">Look up an IP address</label>
      <div class="flex gap-2">
        <input type="text" id="ipInput" placeholder="e.g. 8.8.8.8" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        <button id="lookupBtn" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Lookup</button>
      </div>
    </div>

    <!-- Results -->
    <div id="ipResults" class="hidden">
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">IP Address</strong><div id="resIp" class="font-mono"></div></div>
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">Country</strong><div id="resCountry"></div></div>
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">Region</strong><div id="resRegion"></div></div>
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">City</strong><div id="resCity"></div></div>
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">ISP / Org</strong><div id="resIsp"></div></div>
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">Timezone</strong><div id="resTz"></div></div>
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">Coordinates</strong><div id="resCoords" class="font-mono text-sm"></div></div>
        <div class="p-3 bg-gray-50 rounded-lg"><strong class="text-xs text-gray-500">AS Number</strong><div id="resAs" class="font-mono text-sm"></div></div>
      </div>
    </div>

    <!-- Error -->
    <div id="ipError" class="hidden p-3 bg-red-50 text-red-700 rounded-lg text-sm"></div>
  </div>

  <script>
    async function lookupIp(ip?: string): Promise<any> {
      const url = ip ? `https://ip-api.com/json/${ip}` : 'https://ip-api.com/json/';
      const res = await fetch(url);
      return res.json();
    }

    function showResults(data: any): void {
      if (data.status === 'fail') {
        document.getElementById('ipError')!.classList.remove('hidden');
        document.getElementById('ipError')!.textContent = `Error: ${data.message || 'Invalid IP'}`;
        document.getElementById('ipResults')!.classList.add('hidden');
        return;
      }
      document.getElementById('ipError')!.classList.add('hidden');
      document.getElementById('ipResults')!.classList.remove('hidden');
      document.getElementById('resIp')!.textContent = data.query;
      document.getElementById('resCountry')!.textContent = `${data.country} (${data.countryCode})`;
      document.getElementById('resRegion')!.textContent = data.regionName;
      document.getElementById('resCity')!.textContent = data.city || '—';
      document.getElementById('resIsp')!.textContent = data.isp || data.org || '—';
      document.getElementById('resTz')!.textContent = data.timezone || '—';
      document.getElementById('resCoords')!.textContent = `${data.lat}, ${data.lon}`;
      document.getElementById('resAs')!.textContent = data.as || '—';
    }

    // Get user's IP
    lookupIp().then(data => {
      if (data.query) {
        document.getElementById('myIp')!.textContent = data.query;
        document.getElementById('myLocation')!.textContent = `${data.city}, ${data.regionName}, ${data.country}`;
      }
    }).catch(() => {
      document.getElementById('myIp')!.textContent = 'Could not detect';
    });

    document.getElementById('myIp')!.addEventListener('click', async () => {
      const ip = document.getElementById('myIp')!.textContent || '';
      if (ip && ip !== 'Loading...' && ip !== 'Could not detect') {
        await navigator.clipboard.writeText(ip);
        document.getElementById('myLocation')!.textContent = 'Copied!';
      }
    });

    document.getElementById('lookupBtn')!.addEventListener('click', async () => {
      const ip = (document.getElementById('ipInput') as HTMLInputElement).value.trim();
      if (!ip) return;
      try {
        const data = await lookupIp(ip);
        showResults(data);
      } catch {
        document.getElementById('ipError')!.classList.remove('hidden');
        document.getElementById('ipError')!.textContent = 'Lookup failed. Check the IP address and try again.';
      }
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free IP Address Lookup Tool</h2>
    <p>Instantly find your public IP address and see geolocation details including country, city, ISP and timezone. Look up any IP address for free.</p>
    <h3>What Does This Tool Show?</h3>
    <ul>
      <li><strong>Your IP</strong> - Your current public IP address</li>
      <li><strong>Geolocation</strong> - Country, region, city and coordinates</li>
      <li><strong>ISP</strong> - Your Internet Service Provider</li>
      <li><strong>Timezone</strong> - The timezone associated with the IP</li>
    </ul>
  </Fragment>
</ToolLayout>
