---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Text Sorter"
  description="Sort text lines alphabetically, by length, numerically, or randomly. Remove duplicates and empty lines. Free online text sorting tool."
  category="text"
  icon="↕"
>
  <div>
    <!-- Input -->
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Input Text <span class="text-gray-400 font-normal">(one item per line)</span></label>
      <textarea id="sortInput" rows="8" placeholder="Enter text, one item per line..." class="w-full p-4 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y font-mono"></textarea>
      <div class="text-xs text-gray-500 mt-1"><span id="inputCount">0</span> lines</div>
    </div>

    <!-- Sort Options -->
    <div class="grid gap-4 sm:grid-cols-2 mb-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Sort Method</label>
        <select id="sortMethod" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="az">A → Z (Alphabetical)</option>
          <option value="za">Z → A (Reverse Alphabetical)</option>
          <option value="short">Shortest First</option>
          <option value="long">Longest First</option>
          <option value="numeric">Numeric Sort</option>
          <option value="random">Random Shuffle</option>
        </select>
      </div>
      <div class="flex flex-col gap-2 justify-center">
        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" id="removeDupes" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
          Remove duplicates
        </label>
        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" id="removeEmpty" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
          Remove empty lines
        </label>
      </div>
    </div>

    <!-- Action -->
    <div class="flex gap-2 mb-4">
      <button id="sortBtn" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Sort Lines</button>
      <button id="sortClear" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-sm font-medium rounded-lg transition-colors">Clear</button>
    </div>

    <!-- Output -->
    <div class="flex items-center justify-between mb-1">
      <label class="block text-sm font-medium text-gray-700">Result <span class="text-gray-400 font-normal">(<span id="outputCount">0</span> lines)</span></label>
      <button id="sortCopy" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Copy</button>
    </div>
    <textarea id="sortOutput" rows="8" readonly class="w-full p-4 bg-gray-50 border border-gray-200 rounded-lg text-sm resize-y font-mono"></textarea>
  </div>

  <script>
    const input = document.getElementById('sortInput') as HTMLTextAreaElement;
    const output = document.getElementById('sortOutput') as HTMLTextAreaElement;
    const method = document.getElementById('sortMethod') as HTMLSelectElement;
    const removeDupes = document.getElementById('removeDupes') as HTMLInputElement;
    const removeEmpty = document.getElementById('removeEmpty') as HTMLInputElement;
    const inputCount = document.getElementById('inputCount')!;
    const outputCount = document.getElementById('outputCount')!;

    function updateInputCount(): void {
      const lines = input.value.split('\n').filter(l => l.length > 0);
      inputCount.textContent = lines.length.toString();
    }

    input.addEventListener('input', updateInputCount);

    function sortLines(): void {
      let lines = input.value.split('\n');

      if (removeEmpty.checked) {
        lines = lines.filter(l => l.trim().length > 0);
      }

      if (removeDupes.checked) {
        lines = [...new Set(lines)];
      }

      switch (method.value) {
        case 'az':
          lines.sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));
          break;
        case 'za':
          lines.sort((a, b) => b.localeCompare(a, undefined, { sensitivity: 'base' }));
          break;
        case 'short':
          lines.sort((a, b) => a.length - b.length);
          break;
        case 'long':
          lines.sort((a, b) => b.length - a.length);
          break;
        case 'numeric':
          lines.sort((a, b) => {
            const numA = parseFloat(a.replace(/[^\d.\-]/g, '')) || 0;
            const numB = parseFloat(b.replace(/[^\d.\-]/g, '')) || 0;
            return numA - numB;
          });
          break;
        case 'random':
          for (let i = lines.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [lines[i], lines[j]] = [lines[j], lines[i]];
          }
          break;
      }

      output.value = lines.join('\n');
      outputCount.textContent = lines.length.toString();
    }

    document.getElementById('sortBtn')!.addEventListener('click', sortLines);

    document.getElementById('sortClear')!.addEventListener('click', () => {
      input.value = '';
      output.value = '';
      inputCount.textContent = '0';
      outputCount.textContent = '0';
    });

    document.getElementById('sortCopy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(output.value);
      const btn = document.getElementById('sortCopy')!;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = 'Copy', 1500);
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free Text Sorter Online</h2>
    <p>Sort lines of text alphabetically (A-Z or Z-A), by length (shortest or longest first), numerically, or shuffle them randomly. Optionally remove duplicate and empty lines.</p>
    <h3>Sort Options</h3>
    <ul>
      <li><strong>Alphabetical (A-Z / Z-A)</strong> - Sort lines in ascending or descending order</li>
      <li><strong>By Length</strong> - Arrange lines from shortest to longest or vice versa</li>
      <li><strong>Numeric Sort</strong> - Sort lines by their numeric value</li>
      <li><strong>Random Shuffle</strong> - Randomize the order of all lines</li>
      <li><strong>Remove Duplicates</strong> - Keep only unique lines</li>
    </ul>
  </Fragment>
</ToolLayout>
