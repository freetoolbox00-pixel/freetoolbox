---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="CSS Clip-Path Generator"
  description="Visual CSS clip-path generator with shape presets. Create circles, ellipses, polygons, stars, hearts and more. Preview on images or colored backgrounds. Free clip-path maker."
  category="developer"
  icon="✂"
>
  <div>
    <!-- Preview -->
    <div class="mb-6 p-6 bg-gray-100 rounded-xl flex justify-center items-center min-h-[320px]">
      <div class="relative">
        <div id="previewBox" class="w-64 h-64 transition-all duration-300" style="clip-path: circle(50% at 50% 50%); background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        </div>
        <div id="ghostBox" class="absolute inset-0 w-64 h-64 opacity-20" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
      </div>
    </div>

    <!-- Background type selector -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div>
        <label class="block text-xs text-gray-500 mb-1">Preview Background</label>
        <select id="bgType" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
          <option value="gradient1">Gradient Purple</option>
          <option value="gradient2">Gradient Sunset</option>
          <option value="gradient3">Gradient Ocean</option>
          <option value="solid">Solid Color</option>
          <option value="image">Sample Image</option>
        </select>
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">Solid Color (if selected)</label>
        <input type="color" id="solidColor" value="#3b82f6" class="w-full h-10 rounded border cursor-pointer" />
      </div>
    </div>

    <!-- Shape Presets -->
    <div class="mb-6">
      <h3 class="text-sm font-medium text-gray-700 mb-3">Shape Presets</h3>
      <div class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-9 gap-2" id="shapeGrid">
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors active-shape" data-shape="circle">
          <div class="text-xl mb-1">&#9679;</div>Circle
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="ellipse">
          <div class="text-xl mb-1">&#11044;</div>Ellipse
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="triangle">
          <div class="text-xl mb-1">&#9650;</div>Triangle
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="pentagon">
          <div class="text-xl mb-1">&#11039;</div>Pentagon
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="hexagon">
          <div class="text-xl mb-1">&#11042;</div>Hexagon
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="star">
          <div class="text-xl mb-1">&#9733;</div>Star
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="arrow">
          <div class="text-xl mb-1">&#10132;</div>Arrow
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="cross">
          <div class="text-xl mb-1">&#10010;</div>Cross
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="heart">
          <div class="text-xl mb-1">&#9829;</div>Heart
        </button>
      </div>
    </div>

    <!-- Additional shapes row -->
    <div class="mb-6">
      <div class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-7 gap-2">
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="diamond">
          <div class="text-xl mb-1">&#9670;</div>Diamond
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="octagon">
          <div class="text-xl mb-1">&#11202;</div>Octagon
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="trapezoid">
          <div class="text-xl mb-1">&#9645;</div>Trapezoid
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="parallelogram">
          <div class="text-xl mb-1">&#9649;</div>Parallelogram
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="chevron">
          <div class="text-xl mb-1">&#10095;</div>Chevron
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="rabbet">
          <div class="text-xl mb-1">&#9638;</div>Rabbet
        </button>
        <button class="shape-btn px-3 py-3 bg-gray-50 hover:bg-blue-50 border rounded-lg text-xs font-medium text-center transition-colors" data-shape="message">
          <div class="text-xl mb-1">&#128172;</div>Message
        </button>
      </div>
    </div>

    <!-- Custom clip-path input -->
    <div class="mb-6">
      <label class="block text-xs text-gray-500 mb-1">Custom clip-path (editable)</label>
      <input type="text" id="customPath" class="w-full px-4 py-2 border border-gray-300 rounded-lg font-mono text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" value="circle(50% at 50% 50%)" />
    </div>

    <!-- CSS Output -->
    <div>
      <div class="flex items-center justify-between mb-1">
        <label class="text-sm font-medium text-gray-700">CSS Code</label>
        <button id="copyBtn" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Copy CSS</button>
      </div>
      <pre id="cssOutput" class="p-4 bg-gray-900 text-green-400 rounded-lg font-mono text-sm whitespace-pre-wrap"></pre>
    </div>

    <!-- Copy notification -->
    <div id="copyNotif" class="fixed bottom-6 right-6 bg-gray-900 text-white px-4 py-2 rounded-lg text-sm opacity-0 transition-opacity duration-300 pointer-events-none z-50">
      Copied!
    </div>
  </div>

  <script>
    const shapes: Record<string, string> = {
      circle: "circle(50% at 50% 50%)",
      ellipse: "ellipse(50% 35% at 50% 50%)",
      triangle: "polygon(50% 0%, 0% 100%, 100% 100%)",
      pentagon: "polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%)",
      hexagon: "polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%)",
      star: "polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%)",
      arrow: "polygon(40% 0%, 40% 20%, 100% 20%, 100% 80%, 40% 80%, 40% 100%, 0% 50%)",
      cross: "polygon(35% 0%, 65% 0%, 65% 35%, 100% 35%, 100% 65%, 65% 65%, 65% 100%, 35% 100%, 35% 65%, 0% 65%, 0% 35%, 35% 35%)",
      heart: "polygon(50% 18%, 61% 5%, 75% 0%, 90% 2%, 100% 15%, 100% 35%, 90% 55%, 75% 72%, 50% 100%, 25% 72%, 10% 55%, 0% 35%, 0% 15%, 10% 2%, 25% 0%, 39% 5%)",
      diamond: "polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%)",
      octagon: "polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%)",
      trapezoid: "polygon(20% 0%, 80% 0%, 100% 100%, 0% 100%)",
      parallelogram: "polygon(25% 0%, 100% 0%, 75% 100%, 0% 100%)",
      chevron: "polygon(75% 0%, 100% 50%, 75% 100%, 0% 100%, 25% 50%, 0% 0%)",
      rabbet: "polygon(0% 15%, 15% 15%, 15% 0%, 85% 0%, 85% 15%, 100% 15%, 100% 85%, 85% 85%, 85% 100%, 15% 100%, 15% 85%, 0% 85%)",
      message: "polygon(0% 0%, 100% 0%, 100% 75%, 75% 75%, 75% 100%, 50% 75%, 0% 75%)",
    };

    const backgrounds: Record<string, string> = {
      gradient1: "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
      gradient2: "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
      gradient3: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
      solid: "",
      image: "",
    };

    const previewBox = document.getElementById("previewBox")!;
    const ghostBox = document.getElementById("ghostBox")!;
    const customPath = document.getElementById("customPath") as HTMLInputElement;
    const cssOutput = document.getElementById("cssOutput")!;
    const copyNotif = document.getElementById("copyNotif")!;
    const bgType = document.getElementById("bgType") as HTMLSelectElement;
    const solidColor = document.getElementById("solidColor") as HTMLInputElement;

    function setBackground(type: string): void {
      if (type === "solid") {
        const bg = solidColor.value;
        previewBox.style.background = bg;
        ghostBox.style.background = bg;
      } else if (type === "image") {
        const imgUrl = "https://picsum.photos/400/400?random=1";
        previewBox.style.background = `url('${imgUrl}') center/cover no-repeat`;
        ghostBox.style.background = `url('${imgUrl}') center/cover no-repeat`;
      } else {
        previewBox.style.background = backgrounds[type];
        ghostBox.style.background = backgrounds[type];
      }
    }

    function applyShape(clipPath: string): void {
      previewBox.style.clipPath = clipPath;
      customPath.value = clipPath;
      updateCSS(clipPath);
    }

    function updateCSS(clipPath: string): void {
      cssOutput.textContent = `-webkit-clip-path: ${clipPath};\nclip-path: ${clipPath};`;
    }

    // Shape buttons
    document.querySelectorAll(".shape-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".shape-btn").forEach(b => b.classList.remove("active-shape", "bg-blue-100", "border-blue-400"));
        btn.classList.add("active-shape", "bg-blue-100", "border-blue-400");
        const shape = (btn as HTMLElement).dataset.shape!;
        applyShape(shapes[shape]);
      });
    });

    // Custom path input
    customPath.addEventListener("input", () => {
      const val = customPath.value.trim();
      if (val) {
        previewBox.style.clipPath = val;
        updateCSS(val);
        document.querySelectorAll(".shape-btn").forEach(b => b.classList.remove("active-shape", "bg-blue-100", "border-blue-400"));
      }
    });

    // Background type
    bgType.addEventListener("change", () => setBackground(bgType.value));
    solidColor.addEventListener("input", () => { if (bgType.value === "solid") setBackground("solid"); });

    // Copy
    document.getElementById("copyBtn")!.addEventListener("click", async () => {
      await navigator.clipboard.writeText(cssOutput.textContent || "");
      copyNotif.textContent = "Copied!";
      copyNotif.style.opacity = "1";
      setTimeout(() => { copyNotif.style.opacity = "0"; }, 1500);
    });

    // Init
    setBackground("gradient1");
    applyShape(shapes.circle);
  </script>

  <Fragment slot="seo-content">
    <h2>Free CSS Clip-Path Generator</h2>
    <p>Create CSS clip-path shapes visually with this free generator. Choose from preset shapes including circle, ellipse, triangle, pentagon, hexagon, star, arrow, cross, heart, diamond and more. Preview on gradients, solid colors or images. Copy the CSS code with vendor prefixes.</p>
  </Fragment>
</ToolLayout>
