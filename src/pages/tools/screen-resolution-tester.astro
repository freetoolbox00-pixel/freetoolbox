---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Screen Resolution Tester"
  description="Check your current screen resolution, viewport size, DPI and device pixel ratio. Test responsive breakpoints. Free screen info tool."
  category="utility"
  icon="📐"
>
  <div>
    <!-- Current Info -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
      <div class="p-4 bg-blue-50 rounded-lg text-center">
        <div class="text-sm text-gray-600 mb-1">Screen Resolution</div>
        <div id="screenRes" class="text-xl font-bold font-mono text-blue-600"></div>
      </div>
      <div class="p-4 bg-green-50 rounded-lg text-center">
        <div class="text-sm text-gray-600 mb-1">Viewport Size</div>
        <div id="viewportSize" class="text-xl font-bold font-mono text-green-600"></div>
      </div>
      <div class="p-4 bg-purple-50 rounded-lg text-center">
        <div class="text-sm text-gray-600 mb-1">Device Pixel Ratio</div>
        <div id="dpr" class="text-xl font-bold font-mono text-purple-600"></div>
      </div>
      <div class="p-4 bg-orange-50 rounded-lg text-center">
        <div class="text-sm text-gray-600 mb-1">Color Depth</div>
        <div id="colorDepth" class="text-xl font-bold font-mono text-orange-600"></div>
      </div>
    </div>

    <!-- Detailed Info -->
    <div class="grid gap-3 sm:grid-cols-2 mb-8">
      <div class="p-3 bg-gray-50 rounded text-sm"><strong>Available Size:</strong> <span id="availSize"></span></div>
      <div class="p-3 bg-gray-50 rounded text-sm"><strong>Orientation:</strong> <span id="orientation"></span></div>
      <div class="p-3 bg-gray-50 rounded text-sm"><strong>Touch:</strong> <span id="touchSupport"></span></div>
      <div class="p-3 bg-gray-50 rounded text-sm"><strong>CSS Breakpoint:</strong> <span id="breakpoint" class="font-mono"></span></div>
    </div>

    <!-- Viewport Resize Test -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">Responsive Breakpoint Tester</h3>
      <div class="flex flex-wrap gap-2">
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="375" data-h="667">iPhone SE <span class="text-gray-400">375×667</span></button>
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="390" data-h="844">iPhone 14 <span class="text-gray-400">390×844</span></button>
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="768" data-h="1024">iPad <span class="text-gray-400">768×1024</span></button>
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="1024" data-h="768">iPad Landscape <span class="text-gray-400">1024×768</span></button>
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="1366" data-h="768">Laptop <span class="text-gray-400">1366×768</span></button>
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="1920" data-h="1080">Full HD <span class="text-gray-400">1920×1080</span></button>
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="2560" data-h="1440">QHD <span class="text-gray-400">2560×1440</span></button>
        <button class="bp-btn px-3 py-2 bg-gray-100 hover:bg-blue-50 rounded text-xs font-medium" data-w="3840" data-h="2160">4K UHD <span class="text-gray-400">3840×2160</span></button>
      </div>
      <div id="bpNote" class="mt-3 text-sm text-gray-500 hidden"></div>
    </div>

    <!-- Tailwind Breakpoint Indicator -->
    <div>
      <h3 class="text-sm font-medium text-gray-700 mb-2">Tailwind CSS Breakpoints</h3>
      <div class="flex flex-wrap gap-2">
        <div id="bp-sm" class="px-3 py-2 rounded text-xs font-mono">sm (640px+)</div>
        <div id="bp-md" class="px-3 py-2 rounded text-xs font-mono">md (768px+)</div>
        <div id="bp-lg" class="px-3 py-2 rounded text-xs font-mono">lg (1024px+)</div>
        <div id="bp-xl" class="px-3 py-2 rounded text-xs font-mono">xl (1280px+)</div>
        <div id="bp-2xl" class="px-3 py-2 rounded text-xs font-mono">2xl (1536px+)</div>
      </div>
    </div>
  </div>

  <script>
    function update(): void {
      document.getElementById('screenRes')!.textContent = `${screen.width} × ${screen.height}`;
      document.getElementById('viewportSize')!.textContent = `${window.innerWidth} × ${window.innerHeight}`;
      document.getElementById('dpr')!.textContent = `${window.devicePixelRatio}x`;
      document.getElementById('colorDepth')!.textContent = `${screen.colorDepth}-bit`;
      document.getElementById('availSize')!.textContent = `${screen.availWidth} × ${screen.availHeight}`;
      document.getElementById('orientation')!.textContent = window.innerWidth > window.innerHeight ? 'Landscape' : 'Portrait';
      document.getElementById('touchSupport')!.textContent = 'ontouchstart' in window ? 'Yes' : 'No';

      const w = window.innerWidth;
      let bp = 'xs (<640px)';
      if (w >= 1536) bp = '2xl (1536px+)';
      else if (w >= 1280) bp = 'xl (1280px+)';
      else if (w >= 1024) bp = 'lg (1024px+)';
      else if (w >= 768) bp = 'md (768px+)';
      else if (w >= 640) bp = 'sm (640px+)';
      document.getElementById('breakpoint')!.textContent = bp;

      // Tailwind indicators
      const bps = [
        ['bp-sm', 640], ['bp-md', 768], ['bp-lg', 1024], ['bp-xl', 1280], ['bp-2xl', 1536]
      ] as const;
      bps.forEach(([id, min]) => {
        const el = document.getElementById(id)!;
        el.className = `px-3 py-2 rounded text-xs font-mono ${w >= min ? 'bg-green-100 text-green-700 font-bold' : 'bg-gray-100 text-gray-400'}`;
      });
    }

    window.addEventListener('resize', update);
    update();

    document.querySelectorAll('.bp-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const w = (btn as HTMLElement).dataset.w;
        const h = (btn as HTMLElement).dataset.h;
        const note = document.getElementById('bpNote')!;
        note.classList.remove('hidden');
        if (parseInt(w!) > screen.width || parseInt(h!) > screen.height) {
          note.textContent = `${w}×${h} is larger than your screen (${screen.width}×${screen.height}). Use browser DevTools (F12 → responsive mode) to test this resolution.`;
        } else {
          note.textContent = `To test ${w}×${h}: Open browser DevTools (F12), click the responsive/device toggle, and set dimensions to ${w}×${h}.`;
        }
      });
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free Screen Resolution Tester</h2>
    <p>Instantly check your screen resolution, viewport size, device pixel ratio and color depth. See which CSS breakpoints are active and test responsive design.</p>
    <h3>What's Measured</h3>
    <ul>
      <li><strong>Screen Resolution</strong> - Your monitor's native pixel dimensions</li>
      <li><strong>Viewport Size</strong> - The actual browser content area (changes when you resize)</li>
      <li><strong>Device Pixel Ratio</strong> - How many physical pixels per CSS pixel (2x on Retina)</li>
      <li><strong>CSS Breakpoints</strong> - Which Tailwind/Bootstrap breakpoints are active</li>
    </ul>
  </Fragment>
</ToolLayout>
