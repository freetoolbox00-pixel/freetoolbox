---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Heading Checker"
  description="Analyze HTML heading structure for SEO. Check H1-H6 hierarchy, find missing headings, duplicate H1s, skipped levels. Free heading analyzer tool."
  category="seo"
  icon="H1"
>
  <div>
    <!-- Input Mode -->
    <div class="flex gap-2 mb-4">
      <button id="modeHtml" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg transition-colors">Paste HTML</button>
      <button id="modeUrl" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-colors">Paste Content</button>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">HTML Content</label>
      <textarea id="htmlInput" rows="10" placeholder="<h1>Main Title</h1>&#10;<p>Some content...</p>&#10;<h2>Section</h2>&#10;<h3>Subsection</h3>&#10;<h2>Another Section</h2>" class="w-full p-4 font-mono text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
    </div>

    <div class="flex gap-2 mt-4">
      <button id="analyzeBtn" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Analyze Headings</button>
      <button id="clearBtn" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium rounded-lg transition-colors">Clear</button>
    </div>

    <!-- Results -->
    <div id="results" class="mt-6 hidden">
      <!-- SEO Score -->
      <div class="mb-6">
        <div class="flex items-center gap-4 mb-2">
          <h3 class="text-sm font-medium text-gray-700">SEO Heading Score</h3>
          <span id="scoreValue" class="text-2xl font-bold"></span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-3">
          <div id="scoreBar" class="h-3 rounded-full transition-all duration-500"></div>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Heading Tree -->
        <div>
          <h3 class="text-sm font-medium text-gray-700 mb-2">Heading Hierarchy</h3>
          <div id="headingTree" class="p-4 bg-gray-50 border border-gray-200 rounded-lg overflow-auto max-h-[400px] font-mono text-sm"></div>
        </div>

        <!-- Stats & Issues -->
        <div class="space-y-4">
          <!-- Counts -->
          <div>
            <h3 class="text-sm font-medium text-gray-700 mb-2">Heading Counts</h3>
            <div id="headingCounts" class="grid grid-cols-3 gap-2"></div>
          </div>

          <!-- Issues -->
          <div>
            <h3 class="text-sm font-medium text-gray-700 mb-2">Issues Found</h3>
            <div id="issuesList" class="space-y-2"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    interface HeadingInfo {
      level: number;
      text: string;
      tag: string;
    }

    let isHtmlMode = true;

    function setMode(html: boolean): void {
      isHtmlMode = html;
      document.getElementById('modeHtml')!.className = `px-4 py-2 text-sm font-medium rounded-lg transition-colors ${html ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}`;
      document.getElementById('modeUrl')!.className = `px-4 py-2 text-sm font-medium rounded-lg transition-colors ${!html ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}`;
      const input = document.getElementById('htmlInput') as HTMLTextAreaElement;
      if (html) {
        input.placeholder = '<h1>Main Title</h1>\n<p>Some content...</p>\n<h2>Section</h2>\n<h3>Subsection</h3>';
      } else {
        input.placeholder = 'Paste any content with headings. Lines starting with # are treated as headings:\n# Main Title\n## Section\n### Subsection';
      }
    }

    function extractHeadings(input: string): HeadingInfo[] {
      const headings: HeadingInfo[] = [];

      if (isHtmlMode) {
        const regex = /<h([1-6])[^>]*>(.*?)<\/h\1>/gi;
        let match;
        while ((match = regex.exec(input)) !== null) {
          const text = match[2].replace(/<[^>]*>/g, '').trim();
          headings.push({ level: parseInt(match[1]), text, tag: `H${match[1]}` });
        }
      } else {
        const lines = input.split('\n');
        for (const line of lines) {
          const md = line.match(/^(#{1,6})\s+(.+)/);
          if (md) {
            const level = md[1].length;
            headings.push({ level, text: md[2].trim(), tag: `H${level}` });
          }
        }
      }
      return headings;
    }

    function findIssues(headings: HeadingInfo[]): { type: 'error' | 'warning' | 'info'; message: string }[] {
      const issues: { type: 'error' | 'warning' | 'info'; message: string }[] = [];

      if (headings.length === 0) {
        issues.push({ type: 'error', message: 'No headings found in the content' });
        return issues;
      }

      // Missing H1
      const h1s = headings.filter(h => h.level === 1);
      if (h1s.length === 0) {
        issues.push({ type: 'error', message: 'Missing H1 tag — every page should have exactly one H1' });
      }

      // Multiple H1s
      if (h1s.length > 1) {
        issues.push({ type: 'warning', message: `Multiple H1 tags found (${h1s.length}) — use only one H1 per page` });
      }

      // H1 not first
      if (h1s.length > 0 && headings[0].level !== 1) {
        issues.push({ type: 'warning', message: 'H1 is not the first heading on the page' });
      }

      // Skipped levels
      for (let i = 1; i < headings.length; i++) {
        const diff = headings[i].level - headings[i - 1].level;
        if (diff > 1) {
          issues.push({
            type: 'warning',
            message: `Skipped heading level: ${headings[i - 1].tag} → ${headings[i].tag} (at "${headings[i].text.substring(0, 40)}${headings[i].text.length > 40 ? '...' : ''}")`
          });
        }
      }

      // Empty headings
      const empty = headings.filter(h => !h.text);
      if (empty.length > 0) {
        issues.push({ type: 'error', message: `${empty.length} empty heading(s) found — all headings should have text` });
      }

      // Very long headings
      const long = headings.filter(h => h.text.length > 70);
      if (long.length > 0) {
        issues.push({ type: 'info', message: `${long.length} heading(s) exceed 70 characters — consider shorter headings` });
      }

      // First heading not H1
      if (headings[0].level > 1 && h1s.length === 0) {
        issues.push({ type: 'warning', message: `Content starts with ${headings[0].tag} instead of H1` });
      }

      if (issues.length === 0) {
        issues.push({ type: 'info', message: 'No issues found — heading structure looks good!' });
      }

      return issues;
    }

    function calcScore(headings: HeadingInfo[], issues: { type: string }[]): number {
      if (headings.length === 0) return 0;
      let score = 100;
      for (const issue of issues) {
        if (issue.type === 'error') score -= 20;
        else if (issue.type === 'warning') score -= 10;
        else if (issue.type === 'info') score -= 2;
      }
      return Math.max(0, Math.min(100, score));
    }

    function renderTree(headings: HeadingInfo[]): string {
      if (headings.length === 0) return '<span class="text-gray-400">No headings found</span>';
      let html = '';
      for (const h of headings) {
        const indent = (h.level - 1) * 20;
        const colors: Record<number, string> = {
          1: 'text-blue-700 font-bold',
          2: 'text-blue-600 font-semibold',
          3: 'text-gray-700 font-medium',
          4: 'text-gray-600',
          5: 'text-gray-500',
          6: 'text-gray-400',
        };
        const isEmpty = !h.text;
        html += `<div style="padding-left:${indent}px" class="py-1 ${colors[h.level] || ''}">
          <span class="inline-block w-8 text-xs bg-blue-100 text-blue-700 rounded px-1 text-center mr-2">${h.tag}</span>
          <span class="${isEmpty ? 'italic text-red-400' : ''}">${isEmpty ? '(empty)' : h.text.length > 80 ? h.text.substring(0, 80) + '...' : h.text}</span>
        </div>`;
      }
      return html;
    }

    function analyze(): void {
      const input = (document.getElementById('htmlInput') as HTMLTextAreaElement).value;
      if (!input.trim()) return;

      const headings = extractHeadings(input);
      const issues = findIssues(headings);
      const score = calcScore(headings, issues);

      document.getElementById('results')!.classList.remove('hidden');

      // Score
      const scoreEl = document.getElementById('scoreValue')!;
      scoreEl.textContent = `${score}/100`;
      scoreEl.className = `text-2xl font-bold ${score >= 80 ? 'text-green-600' : score >= 50 ? 'text-yellow-600' : 'text-red-600'}`;
      const bar = document.getElementById('scoreBar')!;
      bar.style.width = `${score}%`;
      bar.className = `h-3 rounded-full transition-all duration-500 ${score >= 80 ? 'bg-green-500' : score >= 50 ? 'bg-yellow-500' : 'bg-red-500'}`;

      // Tree
      document.getElementById('headingTree')!.innerHTML = renderTree(headings);

      // Counts
      const counts = document.getElementById('headingCounts')!;
      let countsHtml = '';
      for (let i = 1; i <= 6; i++) {
        const count = headings.filter(h => h.level === i).length;
        countsHtml += `<div class="text-center p-2 bg-gray-50 border border-gray-200 rounded-lg">
          <div class="text-lg font-bold ${count > 0 ? 'text-blue-600' : 'text-gray-300'}">${count}</div>
          <div class="text-xs text-gray-500">H${i}</div>
        </div>`;
      }
      counts.innerHTML = countsHtml;

      // Issues
      const issuesList = document.getElementById('issuesList')!;
      const icons: Record<string, string> = { error: '&#10060;', warning: '&#9888;&#65039;', info: '&#8505;&#65039;' };
      const colors: Record<string, string> = {
        error: 'bg-red-50 border-red-200 text-red-700',
        warning: 'bg-yellow-50 border-yellow-200 text-yellow-700',
        info: 'bg-blue-50 border-blue-200 text-blue-700'
      };
      issuesList.innerHTML = issues.map(i =>
        `<div class="p-3 border rounded-lg text-sm ${colors[i.type]}">${icons[i.type]} ${i.message}</div>`
      ).join('');
    }

    document.getElementById('modeHtml')!.addEventListener('click', () => setMode(true));
    document.getElementById('modeUrl')!.addEventListener('click', () => setMode(false));
    document.getElementById('analyzeBtn')!.addEventListener('click', analyze);
    document.getElementById('htmlInput')!.addEventListener('input', analyze);
    document.getElementById('clearBtn')!.addEventListener('click', () => {
      (document.getElementById('htmlInput') as HTMLTextAreaElement).value = '';
      document.getElementById('results')!.classList.add('hidden');
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free Heading Structure Checker</h2>
    <p>Analyze your page's heading hierarchy for SEO best practices. Detects missing H1 tags, multiple H1s, skipped heading levels, empty headings, and provides an overall SEO heading score.</p>
    <h3>What This Tool Checks</h3>
    <ul>
      <li><strong>Missing H1</strong> - Every page needs exactly one H1 tag</li>
      <li><strong>Multiple H1s</strong> - Only one H1 should exist per page</li>
      <li><strong>Skipped Levels</strong> - Going from H1 to H3 without H2 hurts accessibility</li>
      <li><strong>Empty Headings</strong> - Headings without text waste SEO potential</li>
      <li><strong>Heading Order</strong> - H1 should be the first heading on the page</li>
    </ul>
  </Fragment>
</ToolLayout>
