---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Scientific Calculator" description="Free online scientific calculator with trigonometry, logarithms, powers, roots and more." category="utility" icon="🔢">
  <div>
    <div id="scDisplay" class="bg-gray-900 rounded-lg p-4 mb-4">
      <div id="scExpr" class="text-right text-gray-400 text-sm h-5 font-mono"></div>
      <div id="scVal" class="text-right text-white text-3xl font-mono">0</div>
    </div>
    <div class="grid grid-cols-5 gap-2" id="scKeys">
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.sin(">sin</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.cos(">cos</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.tan(">tan</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.log10(">log</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.log(">ln</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.sqrt(">√</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="**">x^y</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="(">(</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v=")">)</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.PI">π</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="7">7</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="8">8</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="9">9</button>
      <button class="sc-op bg-blue-100 text-blue-700 p-3 rounded-lg text-lg font-medium hover:bg-blue-200" data-v="/">÷</button>
      <button class="sc-ac bg-red-100 text-red-700 p-3 rounded-lg text-sm font-medium hover:bg-red-200" data-v="AC">AC</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="4">4</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="5">5</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="6">6</button>
      <button class="sc-op bg-blue-100 text-blue-700 p-3 rounded-lg text-lg font-medium hover:bg-blue-200" data-v="*">×</button>
      <button class="sc-ac bg-orange-100 text-orange-700 p-3 rounded-lg text-sm font-medium hover:bg-orange-200" data-v="DEL">DEL</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="1">1</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="2">2</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="3">3</button>
      <button class="sc-op bg-blue-100 text-blue-700 p-3 rounded-lg text-lg font-medium hover:bg-blue-200" data-v="-">−</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="Math.E">e</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v="0">0</button>
      <button class="sc-n bg-white border p-3 rounded-lg text-lg font-medium hover:bg-gray-50" data-v=".">.</button>
      <button class="sc-fn bg-gray-200 p-3 rounded-lg text-sm font-medium hover:bg-gray-300" data-v="**2">x²</button>
      <button class="sc-op bg-blue-100 text-blue-700 p-3 rounded-lg text-lg font-medium hover:bg-blue-200" data-v="+">+</button>
      <button class="sc-eq bg-blue-600 text-white p-3 rounded-lg text-lg font-bold hover:bg-blue-700" data-v="=">=</button>
    </div>
  </div>
</ToolLayout>

<script>
  let expr = '';
  const valEl = document.getElementById('scVal')!;
  const exprEl = document.getElementById('scExpr')!;

  function display(v: string) {
    const d = v.replace(/Math\.sin\(/g,'sin(').replace(/Math\.cos\(/g,'cos(').replace(/Math\.tan\(/g,'tan(').replace(/Math\.log10\(/g,'log(').replace(/Math\.log\(/g,'ln(').replace(/Math\.sqrt\(/g,'√(').replace(/Math\.PI/g,'π').replace(/Math\.E/g,'e').replace(/\*\*/g,'^').replace(/\*/g,'×').replace(/\//g,'÷');
    return d;
  }

  document.getElementById('scKeys')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const v = btn.dataset.v!;
    if (v === 'AC') { expr = ''; valEl.textContent = '0'; exprEl.textContent = ''; }
    else if (v === 'DEL') { expr = expr.slice(0, -1); valEl.textContent = display(expr) || '0'; }
    else if (v === '=') {
      try {
        exprEl.textContent = display(expr) + ' =';
        const result = Function('"use strict";return (' + expr + ')')();
        valEl.textContent = String(Number.isFinite(result) ? parseFloat(result.toPrecision(12)) : 'Error');
        expr = String(result);
      } catch { valEl.textContent = 'Error'; }
    } else {
      expr += v;
      valEl.textContent = display(expr);
    }
  });
</script>
