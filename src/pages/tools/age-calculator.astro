---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Age Calculator"
  description="Calculate your exact age in years, months, days, hours and minutes. Find days until next birthday. Free age calculator."
  category="utility"
  icon="🎂"
>
  <div>
    <!-- Input -->
    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Date of Birth</label>
        <input type="date" id="ageDob" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Calculate as of</label>
        <input type="date" id="ageAsOf" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
    </div>

    <button id="ageCalc" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors mb-6">Calculate Age</button>

    <!-- Result -->
    <div id="ageResult" class="hidden">
      <!-- Main age -->
      <div class="text-center mb-6">
        <div class="text-5xl font-bold text-blue-600 mb-1"><span id="ageYears">0</span></div>
        <div class="text-gray-500">years old</div>
      </div>

      <!-- Detailed -->
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="text-center p-4 bg-blue-50 rounded-xl">
          <div id="ageY" class="text-2xl font-bold text-blue-600">0</div>
          <div class="text-xs text-gray-500">Years</div>
        </div>
        <div class="text-center p-4 bg-green-50 rounded-xl">
          <div id="ageM" class="text-2xl font-bold text-green-600">0</div>
          <div class="text-xs text-gray-500">Months</div>
        </div>
        <div class="text-center p-4 bg-purple-50 rounded-xl">
          <div id="ageD" class="text-2xl font-bold text-purple-600">0</div>
          <div class="text-xs text-gray-500">Days</div>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid gap-3 sm:grid-cols-2 mb-6">
        <div class="p-3 bg-gray-50 rounded-lg flex justify-between">
          <span class="text-sm text-gray-600">Total months</span>
          <span id="ageTotalM" class="text-sm font-mono font-medium">0</span>
        </div>
        <div class="p-3 bg-gray-50 rounded-lg flex justify-between">
          <span class="text-sm text-gray-600">Total weeks</span>
          <span id="ageTotalW" class="text-sm font-mono font-medium">0</span>
        </div>
        <div class="p-3 bg-gray-50 rounded-lg flex justify-between">
          <span class="text-sm text-gray-600">Total days</span>
          <span id="ageTotalD" class="text-sm font-mono font-medium">0</span>
        </div>
        <div class="p-3 bg-gray-50 rounded-lg flex justify-between">
          <span class="text-sm text-gray-600">Total hours</span>
          <span id="ageTotalH" class="text-sm font-mono font-medium">0</span>
        </div>
        <div class="p-3 bg-gray-50 rounded-lg flex justify-between">
          <span class="text-sm text-gray-600">Total minutes</span>
          <span id="ageTotalMin" class="text-sm font-mono font-medium">0</span>
        </div>
        <div class="p-3 bg-gray-50 rounded-lg flex justify-between">
          <span class="text-sm text-gray-600">Day of birth</span>
          <span id="ageDayName" class="text-sm font-medium">0</span>
        </div>
      </div>

      <!-- Next birthday -->
      <div id="ageNextBday" class="p-4 bg-yellow-50 border border-yellow-200 rounded-xl text-center">
        <div class="text-sm text-gray-600">Next Birthday</div>
        <div id="ageNextDays" class="text-2xl font-bold text-yellow-600">0</div>
        <div class="text-xs text-gray-400">days away</div>
      </div>
    </div>
  </div>

  <script>
    // Set defaults
    const today = new Date();
    const todayStr = today.toISOString().split('T')[0];
    (document.getElementById('ageAsOf') as HTMLInputElement).value = todayStr;

    function calculate(): void {
      const dobStr = (document.getElementById('ageDob') as HTMLInputElement).value;
      const asOfStr = (document.getElementById('ageAsOf') as HTMLInputElement).value;
      if (!dobStr || !asOfStr) return;

      const dob = new Date(dobStr);
      const asOf = new Date(asOfStr);
      if (dob >= asOf) return;

      document.getElementById('ageResult')!.classList.remove('hidden');

      // Calculate years, months, days
      let years = asOf.getFullYear() - dob.getFullYear();
      let months = asOf.getMonth() - dob.getMonth();
      let days = asOf.getDate() - dob.getDate();

      if (days < 0) {
        months--;
        const prevMonth = new Date(asOf.getFullYear(), asOf.getMonth(), 0);
        days += prevMonth.getDate();
      }
      if (months < 0) {
        years--;
        months += 12;
      }

      document.getElementById('ageYears')!.textContent = String(years);
      document.getElementById('ageY')!.textContent = String(years);
      document.getElementById('ageM')!.textContent = String(months);
      document.getElementById('ageD')!.textContent = String(days);

      // Totals
      const totalDays = Math.floor((asOf.getTime() - dob.getTime()) / 86400000);
      const totalMonths = years * 12 + months;
      document.getElementById('ageTotalM')!.textContent = totalMonths.toLocaleString();
      document.getElementById('ageTotalW')!.textContent = Math.floor(totalDays / 7).toLocaleString();
      document.getElementById('ageTotalD')!.textContent = totalDays.toLocaleString();
      document.getElementById('ageTotalH')!.textContent = (totalDays * 24).toLocaleString();
      document.getElementById('ageTotalMin')!.textContent = (totalDays * 1440).toLocaleString();

      const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      document.getElementById('ageDayName')!.textContent = dayNames[dob.getDay()];

      // Next birthday
      let nextBday = new Date(asOf.getFullYear(), dob.getMonth(), dob.getDate());
      if (nextBday <= asOf) nextBday = new Date(asOf.getFullYear() + 1, dob.getMonth(), dob.getDate());
      const daysUntil = Math.ceil((nextBday.getTime() - asOf.getTime()) / 86400000);
      document.getElementById('ageNextDays')!.textContent = String(daysUntil);
    }

    document.getElementById('ageCalc')!.addEventListener('click', calculate);
    document.getElementById('ageDob')!.addEventListener('change', calculate);
    document.getElementById('ageAsOf')!.addEventListener('change', calculate);
  </script>

  <Fragment slot="seo-content">
    <h2>Free Age Calculator</h2>
    <p>Calculate your exact age in years, months and days. See total months, weeks, days, hours and minutes lived. Find out what day you were born on and how many days until your next birthday.</p>
  </Fragment>
</ToolLayout>
