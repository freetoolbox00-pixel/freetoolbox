---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Password Generator"
  description="Generate strong, secure random passwords with custom length, uppercase, lowercase, numbers and symbols. Free online password generator tool."
  category="utility"
  icon="**"
>
  <div id="password-tool">
    <!-- Generated Password Display -->
    <div class="mb-6">
      <div class="flex items-center gap-2">
        <input
          type="text"
          id="passwordOutput"
          readonly
          class="flex-1 p-4 text-lg font-mono bg-gray-50 border border-gray-300 rounded-lg focus:outline-none select-all"
          value="Click Generate to create a password"
        />
        <button
          id="copyBtn"
          class="px-4 py-4 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors text-sm font-medium"
          title="Copy to clipboard"
        >
          Copy
        </button>
      </div>
      <p id="copyMsg" class="text-sm text-green-600 mt-1 hidden">Copied to clipboard!</p>
    </div>

    <!-- Options -->
    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Password Length: <span id="lengthDisplay">16</span>
        </label>
        <input type="range" id="lengthSlider" min="4" max="128" value="16" class="w-full accent-blue-600" />
        <div class="flex justify-between text-xs text-gray-400 mt-1">
          <span>4</span>
          <span>128</span>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-3">Include:</label>
        <div class="space-y-2">
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" id="uppercase" checked class="accent-blue-600" /> Uppercase (A-Z)
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" id="lowercase" checked class="accent-blue-600" /> Lowercase (a-z)
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" id="numbers" checked class="accent-blue-600" /> Numbers (0-9)
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" id="symbols" checked class="accent-blue-600" /> Symbols (!@#$%...)
          </label>
        </div>
      </div>
    </div>

    <!-- Strength Meter -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-1">
        <span class="text-sm font-medium text-gray-700">Strength:</span>
        <span id="strengthLabel" class="text-sm font-bold">Strong</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2.5">
        <div id="strengthBar" class="h-2.5 rounded-full bg-green-500 transition-all duration-300" style="width: 100%"></div>
      </div>
    </div>

    <!-- Generate Button -->
    <button
      id="generateBtn"
      class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors text-lg"
    >
      Generate Password
    </button>
  </div>

  <script>
    const output = document.getElementById('passwordOutput') as HTMLInputElement;
    const lengthSlider = document.getElementById('lengthSlider') as HTMLInputElement;
    const lengthDisplay = document.getElementById('lengthDisplay')!;
    const generateBtn = document.getElementById('generateBtn')!;
    const copyBtn = document.getElementById('copyBtn')!;
    const copyMsg = document.getElementById('copyMsg')!;
    const strengthBar = document.getElementById('strengthBar')!;
    const strengthLabel = document.getElementById('strengthLabel')!;

    function getCharset(): string {
      let chars = '';
      if ((document.getElementById('uppercase') as HTMLInputElement).checked) chars += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      if ((document.getElementById('lowercase') as HTMLInputElement).checked) chars += 'abcdefghijklmnopqrstuvwxyz';
      if ((document.getElementById('numbers') as HTMLInputElement).checked) chars += '0123456789';
      if ((document.getElementById('symbols') as HTMLInputElement).checked) chars += '!@#$%^&*()_+-=[]{}|;:,.<>?';
      return chars;
    }

    function generatePassword(): string {
      const charset = getCharset();
      if (!charset) return 'Select at least one option';
      const length = parseInt(lengthSlider.value);
      const array = new Uint32Array(length);
      crypto.getRandomValues(array);
      return Array.from(array, (n) => charset[n % charset.length]).join('');
    }

    function updateStrength(): void {
      const length = parseInt(lengthSlider.value);
      const charset = getCharset();
      const poolSize = charset.length;
      const entropy = length * Math.log2(poolSize || 1);

      let width: number, color: string, label: string;
      if (entropy < 30) { width = 15; color = 'bg-red-500'; label = 'Very Weak'; }
      else if (entropy < 50) { width = 35; color = 'bg-orange-500'; label = 'Weak'; }
      else if (entropy < 70) { width = 55; color = 'bg-yellow-500'; label = 'Fair'; }
      else if (entropy < 90) { width = 75; color = 'bg-green-400'; label = 'Strong'; }
      else { width = 100; color = 'bg-green-600'; label = 'Very Strong'; }

      strengthBar.style.width = width + '%';
      strengthBar.className = `h-2.5 rounded-full transition-all duration-300 ${color}`;
      strengthLabel.textContent = label;
      strengthLabel.className = `text-sm font-bold ${color.replace('bg-', 'text-')}`;
    }

    generateBtn.addEventListener('click', () => {
      output.value = generatePassword();
      updateStrength();
    });

    lengthSlider.addEventListener('input', () => {
      lengthDisplay.textContent = lengthSlider.value;
      updateStrength();
    });

    document.querySelectorAll('#password-tool input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', updateStrength);
    });

    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(output.value);
      copyMsg.classList.remove('hidden');
      setTimeout(() => copyMsg.classList.add('hidden'), 2000);
    });

    // Generate on load
    output.value = generatePassword();
    updateStrength();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Online Password Generator</h2>
    <p>Create strong, random passwords instantly with our free password generator. Choose your preferred length (4 to 128 characters) and select which character types to include: uppercase letters, lowercase letters, numbers, and special symbols.</p>
    <h3>Why Use a Password Generator?</h3>
    <p>Human-chosen passwords are predictable. A truly random password with 16+ characters, including mixed case, numbers and symbols, would take billions of years to crack with current technology. Our generator uses the Web Crypto API for cryptographically secure randomness.</p>
    <h3>Password Strength Tips</h3>
    <ul>
      <li>Use at least 16 characters for important accounts</li>
      <li>Include all character types (uppercase, lowercase, numbers, symbols)</li>
      <li>Never reuse passwords across different sites</li>
      <li>Consider using a password manager to store generated passwords</li>
    </ul>
  </Fragment>
</ToolLayout>
