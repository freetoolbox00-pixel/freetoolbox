---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Color Picker"
  description="Pick colors from a visual color wheel. Get HEX, RGB, HSL values. Eyedropper tool. Free online color picker."
  category="developer"
  icon="🖌"
>
  <div>
    <div class="flex flex-col sm:flex-row gap-6 mb-6">
      <!-- Color input area -->
      <div class="flex-1">
        <div class="flex gap-4 items-start">
          <input type="color" id="cpkColor" value="#3B82F6" class="w-24 h-24 rounded-xl cursor-pointer border-2 border-gray-200" />
          <div id="cpkSwatch" class="w-24 h-24 rounded-xl border-2 border-gray-200" style="background:#3B82F6"></div>
        </div>
      </div>
    </div>

    <!-- Values -->
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-6">
      <div class="p-3 bg-gray-50 rounded-lg">
        <label class="block text-xs text-gray-400 mb-1">HEX</label>
        <div class="flex gap-1">
          <input type="text" id="cpkHex" value="#3B82F6" class="flex-1 px-2 py-1 font-mono text-sm border rounded" />
          <button class="cpk-copy px-2 text-xs text-blue-600" data-target="cpkHex">Copy</button>
        </div>
      </div>
      <div class="p-3 bg-gray-50 rounded-lg">
        <label class="block text-xs text-gray-400 mb-1">RGB</label>
        <div class="flex gap-1">
          <input type="text" id="cpkRgb" value="rgb(59, 130, 246)" class="flex-1 px-2 py-1 font-mono text-sm border rounded" readonly />
          <button class="cpk-copy px-2 text-xs text-blue-600" data-target="cpkRgb">Copy</button>
        </div>
      </div>
      <div class="p-3 bg-gray-50 rounded-lg">
        <label class="block text-xs text-gray-400 mb-1">HSL</label>
        <div class="flex gap-1">
          <input type="text" id="cpkHsl" value="hsl(217, 91%, 60%)" class="flex-1 px-2 py-1 font-mono text-sm border rounded" readonly />
          <button class="cpk-copy px-2 text-xs text-blue-600" data-target="cpkHsl">Copy</button>
        </div>
      </div>
      <div class="p-3 bg-gray-50 rounded-lg">
        <label class="block text-xs text-gray-400 mb-1">RGBA</label>
        <div class="flex gap-1">
          <input type="text" id="cpkRgba" value="rgba(59, 130, 246, 1)" class="flex-1 px-2 py-1 font-mono text-sm border rounded" readonly />
          <button class="cpk-copy px-2 text-xs text-blue-600" data-target="cpkRgba">Copy</button>
        </div>
      </div>
    </div>

    <!-- RGB sliders -->
    <div class="space-y-3 mb-6">
      <div>
        <label class="text-xs text-gray-500">R: <span id="cpkRval">59</span></label>
        <input type="range" id="cpkR" min="0" max="255" value="59" class="w-full accent-red-500" />
      </div>
      <div>
        <label class="text-xs text-gray-500">G: <span id="cpkGval">130</span></label>
        <input type="range" id="cpkG" min="0" max="255" value="130" class="w-full accent-green-500" />
      </div>
      <div>
        <label class="text-xs text-gray-500">B: <span id="cpkBval">246</span></label>
        <input type="range" id="cpkB" min="0" max="255" value="246" class="w-full accent-blue-500" />
      </div>
    </div>

    <!-- Shades -->
    <div class="mb-4">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Shades & Tints</h3>
      <div id="cpkShades" class="flex rounded-lg overflow-hidden h-12"></div>
    </div>
  </div>

  <script>
    function hexToRgb(hex: string): [number, number, number] {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return [r, g, b];
    }

    function rgbToHex(r: number, g: number, b: number): string {
      return '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('');
    }

    function rgbToHsl(r: number, g: number, b: number): [number, number, number] {
      r /= 255; g /= 255; b /= 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h = 0, s = 0;
      const l = (max + min) / 2;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
        else if (max === g) h = ((b - r) / d + 2) / 6;
        else h = ((r - g) / d + 4) / 6;
      }
      return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
    }

    function updateFromHex(hex: string): void {
      const [r, g, b] = hexToRgb(hex);
      const [h, s, l] = rgbToHsl(r, g, b);

      (document.getElementById('cpkColor') as HTMLInputElement).value = hex;
      (document.getElementById('cpkHex') as HTMLInputElement).value = hex.toUpperCase();
      (document.getElementById('cpkRgb') as HTMLInputElement).value = `rgb(${r}, ${g}, ${b})`;
      (document.getElementById('cpkHsl') as HTMLInputElement).value = `hsl(${h}, ${s}%, ${l}%)`;
      (document.getElementById('cpkRgba') as HTMLInputElement).value = `rgba(${r}, ${g}, ${b}, 1)`;
      document.getElementById('cpkSwatch')!.style.background = hex;

      (document.getElementById('cpkR') as HTMLInputElement).value = String(r);
      (document.getElementById('cpkG') as HTMLInputElement).value = String(g);
      (document.getElementById('cpkB') as HTMLInputElement).value = String(b);
      document.getElementById('cpkRval')!.textContent = String(r);
      document.getElementById('cpkGval')!.textContent = String(g);
      document.getElementById('cpkBval')!.textContent = String(b);

      // Shades
      const shades = document.getElementById('cpkShades')!;
      shades.innerHTML = '';
      for (let i = 0; i <= 10; i++) {
        const factor = i / 10;
        const sr = Math.round(r * (1 - factor));
        const sg = Math.round(g * (1 - factor));
        const sb = Math.round(b * (1 - factor));
        const shade = rgbToHex(sr, sg, sb);
        const div = document.createElement('div');
        div.className = 'flex-1 cursor-pointer';
        div.style.background = shade;
        div.title = shade.toUpperCase();
        div.addEventListener('click', () => {
          updateFromHex(shade);
          navigator.clipboard.writeText(shade.toUpperCase());
        });
        shades.appendChild(div);
      }
    }

    document.getElementById('cpkColor')!.addEventListener('input', (e) => {
      updateFromHex((e.target as HTMLInputElement).value);
    });

    document.getElementById('cpkHex')!.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value;
      if (/^#[0-9a-fA-F]{6}$/.test(v)) updateFromHex(v);
    });

    ['cpkR', 'cpkG', 'cpkB'].forEach(id => {
      document.getElementById(id)!.addEventListener('input', () => {
        const r = parseInt((document.getElementById('cpkR') as HTMLInputElement).value);
        const g = parseInt((document.getElementById('cpkG') as HTMLInputElement).value);
        const b = parseInt((document.getElementById('cpkB') as HTMLInputElement).value);
        updateFromHex(rgbToHex(r, g, b));
      });
    });

    document.querySelectorAll('.cpk-copy').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement).dataset.target!;
        navigator.clipboard.writeText((document.getElementById(target) as HTMLInputElement).value);
      });
    });

    updateFromHex('#3B82F6');
  </script>

  <Fragment slot="seo-content">
    <h2>Free Color Picker</h2>
    <p>Pick any color visually and get HEX, RGB, HSL and RGBA values. Adjust with RGB sliders. View shades and tints. Click to copy any color value.</p>
  </Fragment>
</ToolLayout>
