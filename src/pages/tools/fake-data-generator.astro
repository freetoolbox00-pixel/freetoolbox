---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Fake Data Generator" description="Generate fake test data for development. Names, emails, addresses, phone numbers. Export as JSON or CSV." category="developer" icon="🧪">
  <div>
    <div class="grid gap-4 sm:grid-cols-2 mb-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Number of Records</label>
        <select id="fdCount" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="1">1</option>
          <option value="5">5</option>
          <option value="10" selected>10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Export Format</label>
        <select id="fdFormat" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="json">JSON</option>
          <option value="csv">CSV</option>
        </select>
      </div>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-2">Fields to Include</label>
      <div class="flex flex-wrap gap-2">
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="name" checked /> Name</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="email" checked /> Email</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="phone" checked /> Phone</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="address" checked /> Address</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="company" /> Company</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="job" /> Job Title</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="dob" /> Date of Birth</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="username" /> Username</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="ip" /> IP Address</label>
        <label class="flex items-center gap-1 text-sm bg-gray-50 px-3 py-1.5 rounded-lg"><input type="checkbox" class="fd-field rounded" value="uuid" /> UUID</label>
      </div>
    </div>

    <button id="fdGen" class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium mb-4">Generate Data</button>

    <div class="flex justify-between mb-2">
      <span class="text-sm text-gray-500"><span id="fdTotal">0</span> records</span>
      <div class="flex gap-2">
        <button id="fdCopy" class="text-xs text-blue-600 hover:underline hidden">Copy</button>
        <button id="fdDl" class="text-xs text-blue-600 hover:underline hidden">Download</button>
      </div>
    </div>
    <pre id="fdOutput" class="p-4 bg-gray-900 text-green-400 rounded-lg text-xs overflow-x-auto max-h-96 overflow-y-auto font-mono"></pre>
  </div>
</ToolLayout>

<script>
  const FIRST = ['James','Emma','Liam','Olivia','Noah','Ava','William','Sophia','Oliver','Isabella','Elijah','Mia','Lucas','Charlotte','Mason','Amelia','Logan','Harper','Alexander','Evelyn','Ethan','Abigail','Daniel','Emily','Henry','Ella','Jackson','Elizabeth','Sebastian','Sofia'];
  const LAST = ['Smith','Johnson','Williams','Brown','Jones','Garcia','Miller','Davis','Rodriguez','Martinez','Anderson','Taylor','Thomas','Moore','Jackson','Martin','Lee','Thompson','White','Harris','Clark','Lewis','Robinson','Walker','Young'];
  const STREETS = ['Main St','Oak Ave','Maple Dr','Cedar Ln','Park Blvd','Elm St','Pine Rd','Lake Ave','Hill St','River Rd','Forest Dr','Spring St','Valley Rd','Sunset Blvd','Broadway'];
  const CITIES = ['New York','Los Angeles','Chicago','Houston','Phoenix','San Diego','Dallas','Austin','Denver','Seattle','Portland','Miami','Atlanta','Boston','Nashville'];
  const STATES = ['NY','CA','IL','TX','AZ','FL','WA','CO','GA','MA','TN','OR','OH','PA','NC'];
  const COMPANIES = ['Acme Corp','TechVault','DataStream','CloudPeak','NovaSoft','PixelForge','CodeNest','BrightEdge','SwiftLogic','CyberPulse','NetSphere','InnoCore','DigiWave','PrimeStack','ZenithTech'];
  const JOBS = ['Software Engineer','Product Manager','Data Analyst','UX Designer','Marketing Manager','Sales Director','DevOps Engineer','Project Manager','Business Analyst','Full Stack Developer','QA Engineer','HR Manager','Financial Analyst','Content Writer','System Administrator'];
  const DOMAINS = ['gmail.com','yahoo.com','outlook.com','protonmail.com','mail.com','fastmail.com','icloud.com'];

  function pick<T>(a: T[]): T { return a[Math.floor(Math.random() * a.length)]; }
  function rand(min: number, max: number) { return Math.floor(Math.random() * (max - min + 1)) + min; }

  function uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }

  function genRecord(fields: string[]) {
    const first = pick(FIRST);
    const last = pick(LAST);
    const rec: Record<string, string> = {};

    fields.forEach(f => {
      switch (f) {
        case 'name': rec.name = `${first} ${last}`; break;
        case 'email': rec.email = `${first.toLowerCase()}.${last.toLowerCase()}${rand(1,99)}@${pick(DOMAINS)}`; break;
        case 'phone': rec.phone = `(${rand(200,999)}) ${rand(200,999)}-${rand(1000,9999)}`; break;
        case 'address': rec.address = `${rand(100,9999)} ${pick(STREETS)}, ${pick(CITIES)}, ${pick(STATES)} ${rand(10000,99999)}`; break;
        case 'company': rec.company = pick(COMPANIES); break;
        case 'job': rec.job_title = pick(JOBS); break;
        case 'dob': rec.date_of_birth = `${rand(1960,2005)}-${String(rand(1,12)).padStart(2,'0')}-${String(rand(1,28)).padStart(2,'0')}`; break;
        case 'username': rec.username = `${first.toLowerCase()}${last.charAt(0).toLowerCase()}${rand(10,999)}`; break;
        case 'ip': rec.ip_address = `${rand(1,255)}.${rand(0,255)}.${rand(0,255)}.${rand(1,254)}`; break;
        case 'uuid': rec.uuid = uuid(); break;
      }
    });
    return rec;
  }

  function generate() {
    const count = parseInt((document.getElementById('fdCount') as HTMLSelectElement).value);
    const format = (document.getElementById('fdFormat') as HTMLSelectElement).value;
    const fields = Array.from(document.querySelectorAll('.fd-field:checked')).map(c => (c as HTMLInputElement).value);

    if (fields.length === 0) {
      document.getElementById('fdOutput')!.textContent = '// Select at least one field';
      return;
    }

    const data = Array.from({ length: count }, () => genRecord(fields));
    let output: string;

    if (format === 'csv') {
      const keys = Object.keys(data[0]);
      const header = keys.join(',');
      const rows = data.map(r => keys.map(k => `"${(r[k] || '').replace(/"/g, '""')}"`).join(','));
      output = [header, ...rows].join('\n');
    } else {
      output = JSON.stringify(data, null, 2);
    }

    document.getElementById('fdOutput')!.textContent = output;
    document.getElementById('fdTotal')!.textContent = String(count);
    document.getElementById('fdCopy')!.classList.remove('hidden');
    document.getElementById('fdDl')!.classList.remove('hidden');
  }

  document.getElementById('fdGen')!.addEventListener('click', generate);

  document.getElementById('fdCopy')!.addEventListener('click', () => {
    navigator.clipboard.writeText(document.getElementById('fdOutput')!.textContent || '');
    const btn = document.getElementById('fdCopy')!;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
  });

  document.getElementById('fdDl')!.addEventListener('click', () => {
    const format = (document.getElementById('fdFormat') as HTMLSelectElement).value;
    const text = document.getElementById('fdOutput')!.textContent || '';
    const blob = new Blob([text], { type: format === 'csv' ? 'text/csv' : 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `fake-data.${format}`;
    a.click();
  });

  generate();
</script>
