---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Privacy Policy Generator"
  description="Generate a free privacy policy for your website. Covers data collection, cookies, GDPR and CCPA compliance. Free privacy policy maker."
  category="business"
  icon="🔒"
>
  <div>
    <!-- Inputs -->
    <div class="grid gap-4 sm:grid-cols-2 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Website Name</label>
        <input type="text" id="ppSite" value="My Website" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Website URL</label>
        <input type="text" id="ppUrl" value="https://example.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Contact Email</label>
        <input type="text" id="ppEmail" value="privacy@example.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
        <input type="text" id="ppCountry" value="United States" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
    </div>

    <!-- Data Collection -->
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2">What data do you collect?</label>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="pp-data accent-blue-600" value="personal" checked /> Personal info (name, email)</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="pp-data accent-blue-600" value="analytics" checked /> Analytics (Google Analytics)</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="pp-data accent-blue-600" value="cookies" checked /> Cookies</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="pp-data accent-blue-600" value="ads" /> Advertising (AdSense)</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="pp-data accent-blue-600" value="payment" /> Payment info</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="pp-data accent-blue-600" value="location" /> Location data</label>
      </div>
    </div>

    <!-- Compliance -->
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2">Compliance</label>
      <div class="flex flex-wrap gap-4">
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="ppGdpr" class="accent-blue-600" checked /> GDPR (EU)</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="ppCcpa" class="accent-blue-600" /> CCPA (California)</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="ppChildren" class="accent-blue-600" /> Children's privacy (COPPA)</label>
      </div>
    </div>

    <div class="flex gap-2 mb-6">
      <button id="generatePP" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Generate</button>
      <button id="copyPP" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-sm font-medium rounded-lg transition-colors">Copy</button>
    </div>

    <!-- Output -->
    <div id="ppOutput" class="p-6 bg-white border border-gray-200 rounded-lg prose prose-sm max-w-none max-h-[500px] overflow-y-auto"></div>
  </div>

  <script>
    function generate(): void {
      const site = (document.getElementById('ppSite') as HTMLInputElement).value;
      const url = (document.getElementById('ppUrl') as HTMLInputElement).value;
      const email = (document.getElementById('ppEmail') as HTMLInputElement).value;
      const country = (document.getElementById('ppCountry') as HTMLInputElement).value;
      const gdpr = (document.getElementById('ppGdpr') as HTMLInputElement).checked;
      const ccpa = (document.getElementById('ppCcpa') as HTMLInputElement).checked;
      const children = (document.getElementById('ppChildren') as HTMLInputElement).checked;

      const dataTypes: string[] = [];
      document.querySelectorAll('.pp-data:checked').forEach(cb => dataTypes.push((cb as HTMLInputElement).value));

      const today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

      let html = `<h1>Privacy Policy for ${site}</h1><p><em>Last updated: ${today}</em></p>`;
      html += `<p>This Privacy Policy describes how ${site} ("we", "us", or "our") at <a href="${url}">${url}</a> collects, uses, and protects your information.</p>`;

      html += `<h2>Information We Collect</h2>`;
      if (dataTypes.includes('personal')) html += `<p><strong>Personal Information:</strong> We may collect your name, email address, and other contact details when you fill out forms, subscribe to newsletters, or contact us.</p>`;
      if (dataTypes.includes('analytics')) html += `<p><strong>Usage Data:</strong> We use analytics services (such as Google Analytics) to collect information about how you interact with our website, including pages visited, time spent, and referring sources. This data is anonymized.</p>`;
      if (dataTypes.includes('cookies')) html += `<p><strong>Cookies:</strong> We use cookies and similar tracking technologies to enhance your experience. You can control cookie preferences through your browser settings.</p>`;
      if (dataTypes.includes('ads')) html += `<p><strong>Advertising:</strong> Third-party advertising partners (such as Google AdSense) may use cookies to serve relevant ads based on your browsing history.</p>`;
      if (dataTypes.includes('payment')) html += `<p><strong>Payment Information:</strong> If you make purchases, payment information is processed securely through third-party payment processors. We do not store your credit card details.</p>`;
      if (dataTypes.includes('location')) html += `<p><strong>Location Data:</strong> We may collect approximate location data based on your IP address for analytics and content personalization.</p>`;

      html += `<h2>How We Use Your Information</h2><ul><li>To provide and maintain our services</li><li>To improve user experience</li><li>To send communications (with your consent)</li><li>To comply with legal obligations</li></ul>`;

      html += `<h2>Data Sharing</h2><p>We do not sell your personal information. We may share data with trusted service providers who assist in operating our website, subject to confidentiality agreements.</p>`;

      html += `<h2>Data Security</h2><p>We implement appropriate technical and organizational measures to protect your personal information. However, no method of transmission over the Internet is 100% secure.</p>`;

      if (gdpr) {
        html += `<h2>GDPR Rights (EU Users)</h2><p>If you are in the European Economic Area, you have the right to: access your data, rectify inaccurate data, request deletion, restrict processing, data portability, and object to processing. Contact us at <a href="mailto:${email}">${email}</a> to exercise these rights.</p>`;
      }
      if (ccpa) {
        html += `<h2>CCPA Rights (California Residents)</h2><p>California residents have the right to: know what personal information is collected, request deletion, opt-out of the sale of personal information, and non-discrimination for exercising privacy rights.</p>`;
      }
      if (children) {
        html += `<h2>Children's Privacy</h2><p>Our services are not directed to children under 13. We do not knowingly collect personal information from children. If we become aware that we have collected data from a child, we will take steps to delete it.</p>`;
      }

      html += `<h2>Changes to This Policy</h2><p>We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated revision date.</p>`;
      html += `<h2>Contact Us</h2><p>If you have questions about this Privacy Policy, contact us at: <a href="mailto:${email}">${email}</a></p>`;

      document.getElementById('ppOutput')!.innerHTML = html;
    }

    document.getElementById('generatePP')!.addEventListener('click', generate);
    document.getElementById('copyPP')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(document.getElementById('ppOutput')!.innerText || '');
    });

    generate();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Privacy Policy Generator</h2>
    <p>Generate a comprehensive privacy policy for your website in seconds. Covers GDPR, CCPA compliance, cookie usage, analytics and more.</p>
    <h3>Why You Need a Privacy Policy</h3>
    <ul>
      <li><strong>Legal requirement</strong> - Most jurisdictions require websites to disclose data practices</li>
      <li><strong>GDPR compliance</strong> - Required for any site with EU visitors</li>
      <li><strong>Google AdSense</strong> - Required to run ads on your website</li>
      <li><strong>Trust</strong> - Users expect transparency about data handling</li>
    </ul>
  </Fragment>
</ToolLayout>
