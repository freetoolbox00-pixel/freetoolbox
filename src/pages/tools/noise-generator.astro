---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="White Noise Generator" description="Generate white, pink, brown noise for focus, sleep and relaxation. Free online noise machine." category="utility" icon="🔊">
  <div>
    <div class="grid gap-4 sm:grid-cols-3 mb-8">
      <button class="ng-type p-6 rounded-xl border-2 border-blue-500 bg-blue-50 text-center transition-all" data-type="white">
        <div class="text-3xl mb-2">⚪</div>
        <div class="font-semibold text-gray-900">White Noise</div>
        <div class="text-xs text-gray-500">All frequencies equal</div>
      </button>
      <button class="ng-type p-6 rounded-xl border-2 border-gray-200 text-center hover:border-gray-400 transition-all" data-type="pink">
        <div class="text-3xl mb-2">🩷</div>
        <div class="font-semibold text-gray-900">Pink Noise</div>
        <div class="text-xs text-gray-500">Deeper, more natural</div>
      </button>
      <button class="ng-type p-6 rounded-xl border-2 border-gray-200 text-center hover:border-gray-400 transition-all" data-type="brown">
        <div class="text-3xl mb-2">🟤</div>
        <div class="font-semibold text-gray-900">Brown Noise</div>
        <div class="text-xs text-gray-500">Deep rumble, thunder</div>
      </button>
    </div>
    <div class="flex items-center gap-4 mb-6">
      <label class="text-sm font-medium text-gray-700">Volume</label>
      <input type="range" id="ngVol" min="0" max="100" value="50" class="flex-1" />
      <span id="ngVolVal" class="text-sm text-gray-500 w-10 text-right">50%</span>
    </div>
    <div class="flex justify-center">
      <button id="ngPlay" class="px-10 py-4 bg-blue-600 text-white rounded-full text-lg font-bold hover:bg-blue-700 transition-all shadow-lg">
        Play
      </button>
    </div>
  </div>
</ToolLayout>

<script>
  let audioCtx: AudioContext | null = null;
  let sourceNode: AudioBufferSourceNode | null = null;
  let gainNode: GainNode | null = null;
  let playing = false;
  let noiseType = 'white';

  const playBtn = document.getElementById('ngPlay')!;
  const volIn = document.getElementById('ngVol') as HTMLInputElement;
  const volVal = document.getElementById('ngVolVal')!;

  function createNoise(type: string): AudioBuffer {
    const ctx = audioCtx!;
    const bufferSize = ctx.sampleRate * 2;
    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    const data = buffer.getChannelData(0);

    if (type === 'white') {
      for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
    } else if (type === 'pink') {
      let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
      for (let i = 0; i < bufferSize; i++) {
        const w = Math.random() * 2 - 1;
        b0 = 0.99886 * b0 + w * 0.0555179; b1 = 0.99332 * b1 + w * 0.0750759;
        b2 = 0.96900 * b2 + w * 0.1538520; b3 = 0.86650 * b3 + w * 0.3104856;
        b4 = 0.55000 * b4 + w * 0.5329522; b5 = -0.7616 * b5 - w * 0.0168980;
        data[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362) * 0.11;
        b6 = w * 0.115926;
      }
    } else {
      let last = 0;
      for (let i = 0; i < bufferSize; i++) {
        const w = Math.random() * 2 - 1;
        last = (last + (0.02 * w)) / 1.02;
        data[i] = last * 3.5;
      }
    }
    return buffer;
  }

  function start() {
    if (!audioCtx) audioCtx = new AudioContext();
    stop();
    const buffer = createNoise(noiseType);
    sourceNode = audioCtx.createBufferSource();
    gainNode = audioCtx.createGain();
    sourceNode.buffer = buffer;
    sourceNode.loop = true;
    gainNode.gain.value = parseInt(volIn.value) / 100;
    sourceNode.connect(gainNode);
    gainNode.connect(audioCtx.destination);
    sourceNode.start();
    playing = true;
    playBtn.textContent = 'Stop';
    playBtn.className = 'px-10 py-4 bg-red-600 text-white rounded-full text-lg font-bold hover:bg-red-700 transition-all shadow-lg';
  }

  function stop() {
    if (sourceNode) { try { sourceNode.stop(); } catch {} sourceNode = null; }
    playing = false;
    playBtn.textContent = 'Play';
    playBtn.className = 'px-10 py-4 bg-blue-600 text-white rounded-full text-lg font-bold hover:bg-blue-700 transition-all shadow-lg';
  }

  playBtn.addEventListener('click', () => { playing ? stop() : start(); });

  volIn.addEventListener('input', () => {
    volVal.textContent = volIn.value + '%';
    if (gainNode) gainNode.gain.value = parseInt(volIn.value) / 100;
  });

  document.querySelectorAll('.ng-type').forEach(btn => btn.addEventListener('click', () => {
    document.querySelectorAll('.ng-type').forEach(b => { b.className = 'ng-type p-6 rounded-xl border-2 border-gray-200 text-center hover:border-gray-400 transition-all'; });
    (btn as HTMLElement).className = 'ng-type p-6 rounded-xl border-2 border-blue-500 bg-blue-50 text-center transition-all';
    noiseType = (btn as HTMLElement).dataset.type!;
    if (playing) start();
  }));
</script>
