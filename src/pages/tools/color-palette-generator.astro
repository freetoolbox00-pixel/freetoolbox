---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="Color Palette Generator"
  description="Generate beautiful color palettes. Complementary, analogous, triadic, split-complementary schemes. Export as CSS variables, Tailwind or SCSS."
  category="developer"
  icon="🎨"
>
  <div>
    <!-- Base Color -->
    <div class="flex items-center gap-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Base Color</label>
        <div class="flex gap-2">
          <input type="color" id="cpBase" value="#3B82F6" class="w-12 h-10 rounded cursor-pointer" />
          <input type="text" id="cpBaseHex" value="#3B82F6" class="w-28 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Scheme</label>
        <select id="cpScheme" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="complementary">Complementary</option>
          <option value="analogous">Analogous</option>
          <option value="triadic">Triadic</option>
          <option value="split">Split-Complementary</option>
          <option value="tetradic">Tetradic</option>
          <option value="monochromatic">Monochromatic</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">&nbsp;</label>
        <button id="cpRandom" class="px-4 py-2 bg-gray-100 hover:bg-blue-50 rounded-lg text-sm">🎲 Random</button>
      </div>
    </div>

    <!-- Palette Display -->
    <div id="cpPalette" class="grid grid-cols-5 gap-0 rounded-xl overflow-hidden mb-6 h-40"></div>

    <!-- Color Details -->
    <div id="cpDetails" class="grid gap-2 sm:grid-cols-5 mb-6"></div>

    <!-- Export -->
    <div class="mb-4">
      <div class="flex items-center justify-between mb-2">
        <label class="text-sm font-medium text-gray-700">Export</label>
        <div class="flex gap-2">
          <button class="cp-fmt px-3 py-1 bg-blue-600 text-white text-xs rounded" data-fmt="css">CSS</button>
          <button class="cp-fmt px-3 py-1 bg-gray-100 text-xs rounded" data-fmt="tailwind">Tailwind</button>
          <button class="cp-fmt px-3 py-1 bg-gray-100 text-xs rounded" data-fmt="scss">SCSS</button>
          <button class="cp-fmt px-3 py-1 bg-gray-100 text-xs rounded" data-fmt="array">Array</button>
        </div>
      </div>
      <div class="relative">
        <pre id="cpCode" class="p-4 bg-gray-900 text-green-400 rounded-lg font-mono text-sm overflow-auto"></pre>
        <button id="cpCopy" class="absolute top-2 right-2 text-xs text-blue-400 hover:text-blue-300">Copy</button>
      </div>
    </div>
  </div>

  <script>
    let exportFmt = 'css';

    function hexToHsl(hex: string): [number, number, number] {
      const r = parseInt(hex.slice(1, 3), 16) / 255;
      const g = parseInt(hex.slice(3, 5), 16) / 255;
      const b = parseInt(hex.slice(5, 7), 16) / 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h = 0, s = 0;
      const l = (max + min) / 2;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
        else if (max === g) h = ((b - r) / d + 2) / 6;
        else h = ((r - g) / d + 4) / 6;
      }
      return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
    }

    function hslToHex(h: number, s: number, l: number): string {
      h = ((h % 360) + 360) % 360;
      s = Math.max(0, Math.min(100, s)) / 100;
      l = Math.max(0, Math.min(100, l)) / 100;
      const a = s * Math.min(l, 1 - l);
      const f = (n: number) => {
        const k = (n + h / 30) % 12;
        const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
        return Math.round(255 * color).toString(16).padStart(2, '0');
      };
      return `#${f(0)}${f(8)}${f(4)}`;
    }

    function generatePalette(hex: string, scheme: string): string[] {
      const [h, s, l] = hexToHsl(hex);
      switch (scheme) {
        case 'complementary': return [hex, hslToHex(h + 30, s, l + 10), hslToHex(h + 180, s, l), hslToHex(h + 210, s, l - 10), hslToHex(h + 180, s - 20, l + 20)];
        case 'analogous': return [hslToHex(h - 30, s, l), hslToHex(h - 15, s, l), hex, hslToHex(h + 15, s, l), hslToHex(h + 30, s, l)];
        case 'triadic': return [hex, hslToHex(h + 120, s, l), hslToHex(h + 240, s, l), hslToHex(h, s - 30, l + 20), hslToHex(h + 120, s - 30, l + 20)];
        case 'split': return [hex, hslToHex(h + 150, s, l), hslToHex(h + 210, s, l), hslToHex(h + 150, s - 20, l + 15), hslToHex(h + 210, s - 20, l + 15)];
        case 'tetradic': return [hex, hslToHex(h + 90, s, l), hslToHex(h + 180, s, l), hslToHex(h + 270, s, l), hslToHex(h, s, l + 20)];
        case 'monochromatic': return [hslToHex(h, s, 90), hslToHex(h, s, 70), hex, hslToHex(h, s, 30), hslToHex(h, s, 15)];
        default: return [hex, hex, hex, hex, hex];
      }
    }

    function update(): void {
      const hex = (document.getElementById('cpBase') as HTMLInputElement).value;
      const scheme = (document.getElementById('cpScheme') as HTMLSelectElement).value;
      const colors = generatePalette(hex, scheme);

      const palette = document.getElementById('cpPalette')!;
      palette.innerHTML = colors.map(c => `<div style="background:${c}" class="cursor-pointer flex items-end justify-center pb-3"><span class="text-xs font-mono px-2 py-1 rounded bg-black/30 text-white">${c.toUpperCase()}</span></div>`).join('');

      const details = document.getElementById('cpDetails')!;
      details.innerHTML = colors.map((c, i) => {
        const [h, s, l] = hexToHsl(c);
        return `<div class="p-2 bg-gray-50 rounded text-center"><div class="w-full h-8 rounded mb-1" style="background:${c}"></div><div class="text-xs font-mono">${c.toUpperCase()}</div><div class="text-xs text-gray-400">HSL(${h},${s}%,${l}%)</div></div>`;
      }).join('');

      // Click to copy
      palette.querySelectorAll('div').forEach((el, i) => {
        el.addEventListener('click', () => navigator.clipboard.writeText(colors[i].toUpperCase()));
      });

      updateExport(colors);
    }

    function updateExport(colors: string[]): void {
      const names = ['primary', 'secondary', 'accent', 'muted', 'subtle'];
      let code = '';
      switch (exportFmt) {
        case 'css':
          code = ':root {\n' + colors.map((c, i) => `  --color-${names[i]}: ${c};`).join('\n') + '\n}';
          break;
        case 'tailwind':
          code = 'module.exports = {\n  theme: {\n    extend: {\n      colors: {\n' + colors.map((c, i) => `        '${names[i]}': '${c}',`).join('\n') + '\n      }\n    }\n  }\n}';
          break;
        case 'scss':
          code = colors.map((c, i) => `$color-${names[i]}: ${c};`).join('\n');
          break;
        case 'array':
          code = JSON.stringify(colors.map(c => c.toUpperCase()), null, 2);
          break;
      }
      document.getElementById('cpCode')!.textContent = code;
    }

    document.getElementById('cpBase')!.addEventListener('input', (e) => {
      (document.getElementById('cpBaseHex') as HTMLInputElement).value = (e.target as HTMLInputElement).value;
      update();
    });
    document.getElementById('cpBaseHex')!.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value;
      if (/^#[0-9a-fA-F]{6}$/.test(v)) {
        (document.getElementById('cpBase') as HTMLInputElement).value = v;
        update();
      }
    });
    document.getElementById('cpScheme')!.addEventListener('change', update);
    document.getElementById('cpRandom')!.addEventListener('click', () => {
      const hex = '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0');
      (document.getElementById('cpBase') as HTMLInputElement).value = hex;
      (document.getElementById('cpBaseHex') as HTMLInputElement).value = hex;
      update();
    });
    document.querySelectorAll('.cp-fmt').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cp-fmt').forEach(b => b.className = 'cp-fmt px-3 py-1 bg-gray-100 text-xs rounded');
        (btn as HTMLElement).className = 'cp-fmt px-3 py-1 bg-blue-600 text-white text-xs rounded';
        exportFmt = (btn as HTMLElement).dataset.fmt!;
        update();
      });
    });
    document.getElementById('cpCopy')!.addEventListener('click', () => {
      navigator.clipboard.writeText(document.getElementById('cpCode')!.textContent || '');
    });

    update();
  </script>

  <Fragment slot="seo-content">
    <h2>Free Color Palette Generator</h2>
    <p>Generate harmonious color palettes from any base color. Choose from complementary, analogous, triadic, split-complementary, tetradic and monochromatic schemes. Export as CSS variables, Tailwind config, SCSS variables or JSON array.</p>
  </Fragment>
</ToolLayout>
