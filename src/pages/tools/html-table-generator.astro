---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="HTML Table Generator"
  description="Create HTML tables visually. Set rows, columns, headers, styling. Generate clean HTML code. Free table generator."
  category="developer"
  icon="▦"
>
  <div>
    <!-- Controls -->
    <div class="grid gap-4 sm:grid-cols-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Rows</label>
        <input type="number" id="tgRows" value="4" min="1" max="20" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Columns</label>
        <input type="number" id="tgCols" value="3" min="1" max="10" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Style</label>
        <select id="tgStyle" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="basic">Basic</option>
          <option value="bordered" selected>Bordered</option>
          <option value="striped">Striped</option>
          <option value="minimal">Minimal</option>
        </select>
      </div>
      <div class="flex items-end">
        <label class="flex items-center gap-2 text-sm pb-2">
          <input type="checkbox" id="tgHeader" checked class="accent-blue-600" /> Header row
        </label>
      </div>
    </div>

    <!-- Editable table -->
    <div class="mb-6 overflow-auto">
      <table id="tgTable" class="w-full text-sm border-collapse"></table>
    </div>

    <!-- Generate -->
    <button id="tgGen" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg mb-4">Generate HTML</button>

    <!-- Output -->
    <div>
      <div class="flex items-center justify-between mb-1">
        <label class="text-sm font-medium text-gray-700">HTML Code</label>
        <button id="tgCopy" class="text-xs text-blue-600 hover:text-blue-800">Copy</button>
      </div>
      <pre id="tgCode" class="p-4 bg-gray-900 text-green-400 rounded-lg font-mono text-sm overflow-auto max-h-[300px] whitespace-pre-wrap"></pre>
    </div>
  </div>

  <script>
    function renderTable(): void {
      const rows = parseInt((document.getElementById('tgRows') as HTMLInputElement).value) || 4;
      const cols = parseInt((document.getElementById('tgCols') as HTMLInputElement).value) || 3;
      const hasHeader = (document.getElementById('tgHeader') as HTMLInputElement).checked;
      const style = (document.getElementById('tgStyle') as HTMLSelectElement).value;

      const table = document.getElementById('tgTable')!;
      let classes = 'w-full text-sm ';
      if (style === 'bordered') classes += 'border border-gray-300';
      else if (style === 'minimal') classes += '';
      else classes += 'border border-gray-300';
      table.className = classes;

      let html = '';
      if (hasHeader) {
        html += '<thead><tr>';
        for (let c = 0; c < cols; c++) {
          const cellClass = style === 'minimal' ? 'px-4 py-2 text-left border-b-2 border-gray-300' : 'px-4 py-2 text-left bg-gray-100 border border-gray-300 font-medium';
          html += `<th class="${cellClass}" contenteditable="true">Header ${c + 1}</th>`;
        }
        html += '</tr></thead>';
      }

      html += '<tbody>';
      for (let r = 0; r < rows; r++) {
        const rowClass = style === 'striped' && r % 2 === 1 ? 'bg-gray-50' : '';
        html += `<tr class="${rowClass}">`;
        for (let c = 0; c < cols; c++) {
          const cellClass = style === 'minimal' ? 'px-4 py-2 border-b border-gray-200' : 'px-4 py-2 border border-gray-300';
          html += `<td class="${cellClass}" contenteditable="true">Row ${r + 1} Col ${c + 1}</td>`;
        }
        html += '</tr>';
      }
      html += '</tbody>';
      table.innerHTML = html;
    }

    function generateHtml(): void {
      const table = document.getElementById('tgTable')!;
      const hasHeader = (document.getElementById('tgHeader') as HTMLInputElement).checked;
      const style = (document.getElementById('tgStyle') as HTMLSelectElement).value;

      let html = '<table';
      if (style === 'bordered') html += ' border="1" cellpadding="8" cellspacing="0"';
      else if (style === 'basic') html += ' cellpadding="8"';
      html += '>\n';

      if (hasHeader) {
        const ths = table.querySelectorAll('thead th');
        html += '  <thead>\n    <tr>\n';
        ths.forEach(th => { html += `      <th>${th.textContent}</th>\n`; });
        html += '    </tr>\n  </thead>\n';
      }

      html += '  <tbody>\n';
      const trs = table.querySelectorAll('tbody tr');
      trs.forEach(tr => {
        html += '    <tr>\n';
        tr.querySelectorAll('td').forEach(td => { html += `      <td>${td.textContent}</td>\n`; });
        html += '    </tr>\n';
      });
      html += '  </tbody>\n</table>';

      document.getElementById('tgCode')!.textContent = html;
    }

    ['tgRows', 'tgCols'].forEach(id => document.getElementById(id)!.addEventListener('change', renderTable));
    document.getElementById('tgStyle')!.addEventListener('change', renderTable);
    document.getElementById('tgHeader')!.addEventListener('change', renderTable);
    document.getElementById('tgGen')!.addEventListener('click', generateHtml);
    document.getElementById('tgCopy')!.addEventListener('click', () => {
      navigator.clipboard.writeText(document.getElementById('tgCode')!.textContent || '');
    });

    renderTable();
  </script>

  <Fragment slot="seo-content">
    <h2>Free HTML Table Generator</h2>
    <p>Create HTML tables with a visual editor. Set the number of rows and columns, choose a style (bordered, striped, minimal), edit cell content inline, then generate clean HTML code.</p>
  </Fragment>
</ToolLayout>
