---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="Image Watermark" description="Add text watermarks to images. Custom text, size, color, opacity and position. Free online watermark tool." category="utility" icon="💧">
  <div>
    <div id="iwDrop" class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-blue-400 transition-colors cursor-pointer mb-6">
      <div class="text-4xl mb-2">🖼️</div>
      <div class="text-sm text-gray-600 font-medium">Drop an image here or click to upload</div>
      <input type="file" id="iwFile" accept="image/*" class="hidden" />
    </div>
    <div id="iwPanel" class="hidden">
      <div class="grid gap-4 sm:grid-cols-2 mb-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Watermark Text</label>
          <input type="text" id="iwText" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value="FreeToolBox" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Font Size</label>
          <input type="range" id="iwSize" min="12" max="120" value="40" class="w-full" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Color</label>
          <input type="color" id="iwColor" value="#ffffff" class="w-full h-10 rounded-lg border border-gray-300 cursor-pointer" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Opacity (<span id="iwOpVal">50</span>%)</label>
          <input type="range" id="iwOpacity" min="5" max="100" value="50" class="w-full" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Position</label>
          <select id="iwPos" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="center">Center</option>
            <option value="tl">Top Left</option>
            <option value="tr">Top Right</option>
            <option value="bl">Bottom Left</option>
            <option value="br">Bottom Right</option>
            <option value="tile">Tiled (repeat)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Rotation</label>
          <select id="iwRot" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="0">0°</option>
            <option value="-30" selected>-30°</option>
            <option value="-45">-45°</option>
            <option value="30">30°</option>
            <option value="45">45°</option>
          </select>
        </div>
      </div>
      <div class="flex justify-center mb-4">
        <canvas id="iwCanvas" class="max-w-full border border-gray-200 rounded-lg"></canvas>
      </div>
      <div class="flex gap-3">
        <button id="iwApply" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">Download</button>
        <button id="iwReset" class="px-4 py-2.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">Reset</button>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const drop = document.getElementById('iwDrop')!;
  const fileIn = document.getElementById('iwFile') as HTMLInputElement;
  const panel = document.getElementById('iwPanel')!;
  const canvas = document.getElementById('iwCanvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let img: HTMLImageElement | null = null;

  const textIn = document.getElementById('iwText') as HTMLInputElement;
  const sizeIn = document.getElementById('iwSize') as HTMLInputElement;
  const colorIn = document.getElementById('iwColor') as HTMLInputElement;
  const opacityIn = document.getElementById('iwOpacity') as HTMLInputElement;
  const opValEl = document.getElementById('iwOpVal')!;
  const posIn = document.getElementById('iwPos') as HTMLSelectElement;
  const rotIn = document.getElementById('iwRot') as HTMLSelectElement;

  function loadImage(file: File) {
    const i = new Image();
    i.onload = () => { img = i; render(); panel.classList.remove('hidden'); drop.classList.add('hidden'); };
    i.src = URL.createObjectURL(file);
  }

  function render() {
    if (!img) return;
    const maxW = Math.min(700, window.innerWidth - 80);
    const scale = Math.min(1, maxW / img.naturalWidth);
    canvas.width = img.naturalWidth * scale;
    canvas.height = img.naturalHeight * scale;
    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

    const text = textIn.value || 'Watermark';
    const size = parseInt(sizeIn.value) * scale;
    const color = colorIn.value;
    const opacity = parseInt(opacityIn.value) / 100;
    const pos = posIn.value;
    const rot = parseFloat(rotIn.value) * Math.PI / 180;

    ctx.font = `bold ${size}px Arial, sans-serif`;
    ctx.fillStyle = color;
    ctx.globalAlpha = opacity;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    if (pos === 'tile') {
      const tm = ctx.measureText(text);
      const tw = tm.width + 60;
      const th = size + 40;
      for (let y = -canvas.height; y < canvas.height * 2; y += th) {
        for (let x = -canvas.width; x < canvas.width * 2; x += tw) {
          ctx.save(); ctx.translate(x, y); ctx.rotate(rot);
          ctx.fillText(text, 0, 0); ctx.restore();
        }
      }
    } else {
      let x = canvas.width / 2, y = canvas.height / 2;
      const pad = size;
      if (pos === 'tl') { x = pad; y = pad; ctx.textAlign = 'left'; }
      else if (pos === 'tr') { x = canvas.width - pad; y = pad; ctx.textAlign = 'right'; }
      else if (pos === 'bl') { x = pad; y = canvas.height - pad; ctx.textAlign = 'left'; }
      else if (pos === 'br') { x = canvas.width - pad; y = canvas.height - pad; ctx.textAlign = 'right'; }
      ctx.save(); ctx.translate(x, y); ctx.rotate(rot);
      ctx.fillText(text, 0, 0); ctx.restore();
    }
    ctx.globalAlpha = 1;
  }

  [textIn, sizeIn, colorIn, opacityIn, posIn, rotIn].forEach(el => el.addEventListener('input', () => { opValEl.textContent = opacityIn.value; render(); }));
  [posIn, rotIn].forEach(el => el.addEventListener('change', render));

  document.getElementById('iwApply')!.addEventListener('click', () => {
    if (!img) return;
    // Full resolution export
    const c = document.createElement('canvas');
    c.width = img.naturalWidth; c.height = img.naturalHeight;
    const cx = c.getContext('2d')!;
    cx.drawImage(img, 0, 0);
    const text = textIn.value || 'Watermark';
    const size = parseInt(sizeIn.value);
    const rot = parseFloat(rotIn.value) * Math.PI / 180;
    const pos = posIn.value;
    cx.font = `bold ${size}px Arial, sans-serif`;
    cx.fillStyle = colorIn.value;
    cx.globalAlpha = parseInt(opacityIn.value) / 100;
    cx.textAlign = 'center'; cx.textBaseline = 'middle';
    if (pos === 'tile') {
      const tw = cx.measureText(text).width + 60;
      const th = size + 40;
      for (let y = -c.height; y < c.height * 2; y += th) {
        for (let x = -c.width; x < c.width * 2; x += tw) {
          cx.save(); cx.translate(x, y); cx.rotate(rot); cx.fillText(text, 0, 0); cx.restore();
        }
      }
    } else {
      let x = c.width / 2, y = c.height / 2;
      const pad = size;
      if (pos === 'tl') { x = pad; y = pad; cx.textAlign = 'left'; }
      else if (pos === 'tr') { x = c.width - pad; y = pad; cx.textAlign = 'right'; }
      else if (pos === 'bl') { x = pad; y = c.height - pad; cx.textAlign = 'left'; }
      else if (pos === 'br') { x = c.width - pad; y = c.height - pad; cx.textAlign = 'right'; }
      cx.save(); cx.translate(x, y); cx.rotate(rot); cx.fillText(text, 0, 0); cx.restore();
    }
    c.toBlob(blob => { if (!blob) return; const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'watermarked.png'; a.click(); }, 'image/png');
  });

  document.getElementById('iwReset')!.addEventListener('click', () => { img = null; panel.classList.add('hidden'); drop.classList.remove('hidden'); fileIn.value = ''; });
  drop.addEventListener('click', () => fileIn.click());
  drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('border-blue-400', 'bg-blue-50'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('border-blue-400', 'bg-blue-50'));
  drop.addEventListener('drop', e => { e.preventDefault(); drop.classList.remove('border-blue-400', 'bg-blue-50'); const f = e.dataTransfer?.files[0]; if (f?.type.startsWith('image/')) loadImage(f); });
  fileIn.addEventListener('change', () => { if (fileIn.files?.[0]) loadImage(fileIn.files[0]); });
</script>
