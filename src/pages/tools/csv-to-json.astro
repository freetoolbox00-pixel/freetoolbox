---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="CSV to JSON Converter"
  description="Convert CSV data to JSON format and JSON to CSV. Parse spreadsheet data for APIs and databases. Free CSV/JSON converter."
  category="developer"
  icon="CSV"
>
  <div>
    <!-- Mode -->
    <div class="flex gap-2 mb-4">
      <button id="csvToJsonMode" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg transition-colors">CSV → JSON</button>
      <button id="jsonToCsvMode" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-colors">JSON → CSV</button>
    </div>

    <!-- Options -->
    <div class="flex flex-wrap gap-4 mb-4">
      <div>
        <label class="block text-xs text-gray-500 mb-1">Delimiter</label>
        <select id="csvDelimiter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="," selected>Comma (,)</option>
          <option value=";">Semicolon (;)</option>
          <option value="\t">Tab</option>
          <option value="|">Pipe (|)</option>
        </select>
      </div>
      <label class="flex items-end gap-2 text-sm pb-2">
        <input type="checkbox" id="csvHeaders" checked class="accent-blue-600" /> First row as headers
      </label>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <div>
        <label id="inputLabel2" class="block text-sm font-medium text-gray-700 mb-1">CSV Input</label>
        <textarea id="csvInput" rows="12" placeholder="name,age,city&#10;John,30,New York&#10;Jane,25,London&#10;Bob,35,Paris" class="w-full p-4 font-mono text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-sm font-medium text-gray-700">Output</label>
          <button id="copyOutput2" class="text-xs text-blue-600 hover:text-blue-800">Copy</button>
        </div>
        <pre id="csvOutput" class="w-full p-4 font-mono text-sm bg-gray-50 border border-gray-300 rounded-lg overflow-auto min-h-[300px] whitespace-pre-wrap"></pre>
      </div>
    </div>

    <div class="flex gap-2 mt-4">
      <button id="convertBtn2" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Convert</button>
    </div>

    <!-- Table Preview -->
    <div class="mt-6">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Table Preview</h3>
      <div id="tablePreview" class="overflow-auto border border-gray-200 rounded-lg max-h-[300px]"></div>
    </div>
  </div>

  <script>
    let csvMode = true;

    function setMode(isCsv: boolean): void {
      csvMode = isCsv;
      document.getElementById('csvToJsonMode')!.className = `px-4 py-2 text-sm font-medium rounded-lg transition-colors ${isCsv ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}`;
      document.getElementById('jsonToCsvMode')!.className = `px-4 py-2 text-sm font-medium rounded-lg transition-colors ${!isCsv ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}`;
      document.getElementById('inputLabel2')!.textContent = isCsv ? 'CSV Input' : 'JSON Input';
      (document.getElementById('csvInput') as HTMLTextAreaElement).placeholder = isCsv
        ? 'name,age,city\nJohn,30,New York\nJane,25,London'
        : '[{"name":"John","age":30},{"name":"Jane","age":25}]';
    }

    function parseCSV(text: string, delimiter: string, hasHeaders: boolean): any[] {
      const lines = text.trim().split('\n').map(l => l.trim()).filter(l => l);
      if (lines.length === 0) return [];

      const parseLine = (line: string): string[] => {
        const result: string[] = [];
        let current = '';
        let inQuotes = false;
        for (let i = 0; i < line.length; i++) {
          if (inQuotes) {
            if (line[i] === '"' && line[i+1] === '"') { current += '"'; i++; }
            else if (line[i] === '"') inQuotes = false;
            else current += line[i];
          } else if (line[i] === '"') { inQuotes = true; }
          else if (line[i] === delimiter) { result.push(current.trim()); current = ''; }
          else current += line[i];
        }
        result.push(current.trim());
        return result;
      };

      const rows = lines.map(parseLine);
      if (hasHeaders && rows.length > 1) {
        const headers = rows[0];
        return rows.slice(1).map(row => {
          const obj: Record<string, string> = {};
          headers.forEach((h, i) => obj[h] = row[i] || '');
          return obj;
        });
      }
      return rows;
    }

    function jsonToCSV(data: any[], delimiter: string): string {
      if (!Array.isArray(data) || data.length === 0) return '';
      const keys = Object.keys(data[0]);
      const header = keys.join(delimiter);
      const rows = data.map(row => keys.map(k => {
        const val = String(row[k] ?? '');
        return val.includes(delimiter) || val.includes('"') || val.includes('\n')
          ? `"${val.replace(/"/g, '""')}"` : val;
      }).join(delimiter));
      return [header, ...rows].join('\n');
    }

    function renderTable(data: any[]): void {
      const preview = document.getElementById('tablePreview')!;
      if (!Array.isArray(data) || data.length === 0) { preview.innerHTML = '<div class="p-4 text-gray-400 text-sm">No data</div>'; return; }

      const isObj = typeof data[0] === 'object' && !Array.isArray(data[0]);
      const keys = isObj ? Object.keys(data[0]) : data[0].map((_: any, i: number) => `Col ${i+1}`);

      let html = '<table class="w-full text-sm border-collapse"><thead><tr>';
      keys.forEach((k: string) => html += `<th class="px-3 py-2 bg-gray-100 border border-gray-200 text-left font-medium">${k}</th>`);
      html += '</tr></thead><tbody>';
      const rows = isObj ? data : data.slice(1);
      rows.slice(0, 50).forEach((row: any) => {
        html += '<tr>';
        if (isObj) keys.forEach((k: string) => html += `<td class="px-3 py-1 border border-gray-200">${row[k] ?? ''}</td>`);
        else row.forEach((v: any) => html += `<td class="px-3 py-1 border border-gray-200">${v}</td>`);
        html += '</tr>';
      });
      html += '</tbody></table>';
      if ((isObj ? data : data.slice(1)).length > 50) html += '<div class="p-2 text-xs text-gray-400">Showing first 50 rows</div>';
      preview.innerHTML = html;
    }

    function convert(): void {
      const input = (document.getElementById('csvInput') as HTMLTextAreaElement).value;
      const output = document.getElementById('csvOutput')!;
      const delim = (document.getElementById('csvDelimiter') as HTMLSelectElement).value === '\\t' ? '\t' : (document.getElementById('csvDelimiter') as HTMLSelectElement).value;
      const headers = (document.getElementById('csvHeaders') as HTMLInputElement).checked;

      try {
        if (csvMode) {
          const data = parseCSV(input, delim, headers);
          output.textContent = JSON.stringify(data, null, 2);
          renderTable(data);
        } else {
          const data = JSON.parse(input);
          output.textContent = jsonToCSV(Array.isArray(data) ? data : [data], delim);
          renderTable(Array.isArray(data) ? data : [data]);
        }
      } catch (e: any) {
        output.textContent = 'Error: ' + e.message;
      }
    }

    document.getElementById('csvToJsonMode')!.addEventListener('click', () => setMode(true));
    document.getElementById('jsonToCsvMode')!.addEventListener('click', () => setMode(false));
    document.getElementById('convertBtn2')!.addEventListener('click', convert);
    document.getElementById('csvInput')!.addEventListener('input', convert);

    document.getElementById('copyOutput2')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(document.getElementById('csvOutput')!.textContent || '');
    });
  </script>

  <Fragment slot="seo-content">
    <h2>Free CSV to JSON Converter</h2>
    <p>Convert CSV spreadsheet data to JSON format for APIs and databases, or convert JSON arrays back to CSV for spreadsheet import. Supports custom delimiters and table preview.</p>
    <h3>Supported Formats</h3>
    <ul>
      <li><strong>CSV → JSON</strong> - Convert comma-separated values to JSON objects/arrays</li>
      <li><strong>JSON → CSV</strong> - Flatten JSON objects into CSV rows</li>
      <li><strong>Custom delimiters</strong> - Comma, semicolon, tab, pipe</li>
    </ul>
  </Fragment>
</ToolLayout>
