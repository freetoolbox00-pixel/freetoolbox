---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout
  title="CSS Flexbox Generator"
  description="Create CSS Flexbox layouts visually. Control direction, wrap, justify, align. Generate CSS code instantly. Free flexbox tool."
  category="developer"
  icon="⬛"
>
  <div>
    <!-- Preview -->
    <div class="mb-6">
      <div id="fbPreview" class="w-full min-h-[200px] p-4 bg-gray-100 rounded-xl border-2 border-dashed border-gray-300 flex" style="display:flex;flex-direction:row;justify-content:flex-start;align-items:stretch;flex-wrap:nowrap;gap:8px">
        <div class="w-16 h-16 bg-blue-500 rounded-lg flex items-center justify-center text-white font-bold text-sm">1</div>
        <div class="w-20 h-12 bg-green-500 rounded-lg flex items-center justify-center text-white font-bold text-sm">2</div>
        <div class="w-14 h-20 bg-purple-500 rounded-lg flex items-center justify-center text-white font-bold text-sm">3</div>
        <div class="w-16 h-14 bg-orange-500 rounded-lg flex items-center justify-center text-white font-bold text-sm">4</div>
        <div class="w-12 h-16 bg-pink-500 rounded-lg flex items-center justify-center text-white font-bold text-sm">5</div>
      </div>
    </div>

    <!-- Controls -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">flex-direction</label>
        <select id="fbDir" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="row" selected>row</option>
          <option value="row-reverse">row-reverse</option>
          <option value="column">column</option>
          <option value="column-reverse">column-reverse</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">justify-content</label>
        <select id="fbJustify" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="flex-start" selected>flex-start</option>
          <option value="flex-end">flex-end</option>
          <option value="center">center</option>
          <option value="space-between">space-between</option>
          <option value="space-around">space-around</option>
          <option value="space-evenly">space-evenly</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">align-items</label>
        <select id="fbAlign" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="stretch" selected>stretch</option>
          <option value="flex-start">flex-start</option>
          <option value="flex-end">flex-end</option>
          <option value="center">center</option>
          <option value="baseline">baseline</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">flex-wrap</label>
        <select id="fbWrap" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="nowrap" selected>nowrap</option>
          <option value="wrap">wrap</option>
          <option value="wrap-reverse">wrap-reverse</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">align-content</label>
        <select id="fbAlignC" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="normal" selected>normal</option>
          <option value="flex-start">flex-start</option>
          <option value="flex-end">flex-end</option>
          <option value="center">center</option>
          <option value="space-between">space-between</option>
          <option value="space-around">space-around</option>
          <option value="stretch">stretch</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">gap</label>
        <div class="flex items-center gap-2">
          <input type="range" id="fbGap" min="0" max="40" value="8" class="flex-1 accent-blue-600" />
          <span id="fbGapVal" class="text-sm font-mono w-10">8px</span>
        </div>
      </div>
    </div>

    <!-- Items count -->
    <div class="flex items-center gap-4 mb-6">
      <label class="text-sm font-medium text-gray-700">Items:</label>
      <button id="fbRemove" class="w-8 h-8 bg-gray-100 hover:bg-red-50 rounded text-sm">−</button>
      <span id="fbCount" class="font-mono">5</span>
      <button id="fbAdd" class="w-8 h-8 bg-gray-100 hover:bg-green-50 rounded text-sm">+</button>
    </div>

    <!-- CSS Output -->
    <div>
      <div class="flex items-center justify-between mb-1">
        <label class="text-sm font-medium text-gray-700">CSS Code</label>
        <button id="fbCopy" class="text-xs text-blue-600 hover:text-blue-800">Copy</button>
      </div>
      <pre id="fbCode" class="p-4 bg-gray-900 text-green-400 rounded-lg font-mono text-sm"></pre>
    </div>
  </div>

  <script>
    const colors = ['bg-blue-500', 'bg-green-500', 'bg-purple-500', 'bg-orange-500', 'bg-pink-500', 'bg-red-500', 'bg-yellow-500', 'bg-teal-500', 'bg-indigo-500', 'bg-cyan-500'];
    let itemCount = 5;

    function renderItems(): void {
      const preview = document.getElementById('fbPreview')!;
      preview.innerHTML = '';
      for (let i = 0; i < itemCount; i++) {
        const sizes = ['w-16 h-16', 'w-20 h-12', 'w-14 h-20', 'w-16 h-14', 'w-12 h-16', 'w-18 h-14', 'w-14 h-18'];
        const div = document.createElement('div');
        div.className = `${sizes[i % sizes.length]} ${colors[i % colors.length]} rounded-lg flex items-center justify-center text-white font-bold text-sm flex-shrink-0`;
        div.textContent = String(i + 1);
        preview.appendChild(div);
      }
    }

    function update(): void {
      const dir = (document.getElementById('fbDir') as HTMLSelectElement).value;
      const justify = (document.getElementById('fbJustify') as HTMLSelectElement).value;
      const align = (document.getElementById('fbAlign') as HTMLSelectElement).value;
      const wrap = (document.getElementById('fbWrap') as HTMLSelectElement).value;
      const alignC = (document.getElementById('fbAlignC') as HTMLSelectElement).value;
      const gap = (document.getElementById('fbGap') as HTMLInputElement).value;

      const preview = document.getElementById('fbPreview')!;
      preview.style.flexDirection = dir;
      preview.style.justifyContent = justify;
      preview.style.alignItems = align;
      preview.style.flexWrap = wrap;
      preview.style.alignContent = alignC;
      preview.style.gap = gap + 'px';

      document.getElementById('fbGapVal')!.textContent = gap + 'px';

      let css = `.container {\n  display: flex;\n  flex-direction: ${dir};`;
      if (justify !== 'flex-start') css += `\n  justify-content: ${justify};`;
      if (align !== 'stretch') css += `\n  align-items: ${align};`;
      if (wrap !== 'nowrap') css += `\n  flex-wrap: ${wrap};`;
      if (alignC !== 'normal') css += `\n  align-content: ${alignC};`;
      if (gap !== '0') css += `\n  gap: ${gap}px;`;
      css += '\n}';

      document.getElementById('fbCode')!.textContent = css;
    }

    ['fbDir', 'fbJustify', 'fbAlign', 'fbWrap', 'fbAlignC'].forEach(id => {
      document.getElementById(id)!.addEventListener('change', update);
    });
    document.getElementById('fbGap')!.addEventListener('input', update);

    document.getElementById('fbAdd')!.addEventListener('click', () => {
      if (itemCount < 10) { itemCount++; document.getElementById('fbCount')!.textContent = String(itemCount); renderItems(); update(); }
    });
    document.getElementById('fbRemove')!.addEventListener('click', () => {
      if (itemCount > 1) { itemCount--; document.getElementById('fbCount')!.textContent = String(itemCount); renderItems(); update(); }
    });

    document.getElementById('fbCopy')!.addEventListener('click', () => {
      navigator.clipboard.writeText(document.getElementById('fbCode')!.textContent || '');
    });

    update();
  </script>

  <Fragment slot="seo-content">
    <h2>Free CSS Flexbox Generator</h2>
    <p>Create CSS Flexbox layouts visually. Control flex-direction, justify-content, align-items, flex-wrap, align-content and gap. See changes in real-time and copy the generated CSS code.</p>
  </Fragment>
</ToolLayout>
