---
import ToolLayout from '../../components/ToolLayout.astro';
---

<ToolLayout title="MAC Address Generator" description="Generate random MAC addresses. Choose format and vendor prefix. Bulk generation support." category="security" icon="🖥️">
  <div>
    <div class="grid gap-4 sm:grid-cols-3 mb-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Format</label>
        <select id="mgFormat" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="colon">AA:BB:CC:DD:EE:FF</option>
          <option value="dash">AA-BB-CC-DD-EE-FF</option>
          <option value="dot">AABB.CCDD.EEFF</option>
          <option value="none">AABBCCDDEEFF</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Case</label>
        <select id="mgCase" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="upper">UPPERCASE</option>
          <option value="lower">lowercase</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Count</label>
        <input type="number" id="mgCount" min="1" max="100" value="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      </div>
    </div>
    <div class="mb-4">
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="mgLocal" /> Set locally administered bit (LAA)</label>
    </div>
    <div class="flex gap-3 mb-4">
      <button id="mgGen" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">Generate</button>
      <button id="mgCopy" class="px-4 py-2.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 hidden">Copy All</button>
    </div>
    <pre id="mgOut" class="p-4 bg-gray-50 border border-gray-200 rounded-lg text-sm font-mono min-h-[80px]"></pre>
  </div>
</ToolLayout>

<script>
  const formatSel = document.getElementById('mgFormat') as HTMLSelectElement;
  const caseSel = document.getElementById('mgCase') as HTMLSelectElement;
  const countIn = document.getElementById('mgCount') as HTMLInputElement;
  const localCheck = document.getElementById('mgLocal') as HTMLInputElement;
  const genBtn = document.getElementById('mgGen')!;
  const copyBtn = document.getElementById('mgCopy')!;
  const outEl = document.getElementById('mgOut')!;

  function genMAC(): string {
    const bytes = new Uint8Array(6);
    crypto.getRandomValues(bytes);
    bytes[0] = bytes[0] & 0xFE; // unicast
    if (localCheck.checked) bytes[0] = bytes[0] | 0x02; // locally administered
    const hex = Array.from(bytes).map(b => b.toString(16).padStart(2, '0'));
    const fmt = formatSel.value;
    let mac = '';
    if (fmt === 'colon') mac = hex.join(':');
    else if (fmt === 'dash') mac = hex.join('-');
    else if (fmt === 'dot') mac = `${hex[0]}${hex[1]}.${hex[2]}${hex[3]}.${hex[4]}${hex[5]}`;
    else mac = hex.join('');
    return caseSel.value === 'upper' ? mac.toUpperCase() : mac;
  }

  genBtn.addEventListener('click', () => {
    const n = Math.min(100, Math.max(1, parseInt(countIn.value) || 5));
    const macs = Array.from({ length: n }, genMAC);
    outEl.textContent = macs.join('\n');
    copyBtn.classList.remove('hidden');
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(outEl.textContent || '');
    copyBtn.textContent = 'Copied!'; setTimeout(() => { copyBtn.textContent = 'Copy All'; }, 1500);
  });
</script>
