---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - FreeToolBox" description="Contact FreeToolBox for questions, suggestions or bug reports.">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Contact Us</h1>
    <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 shadow-sm">
      <p class="text-gray-600 mb-6">Have a question, suggestion or found a bug? We'd love to hear from you.</p>

      <div class="space-y-4">
        <div class="p-4 bg-blue-50 rounded-lg">
          <h2 class="font-semibold text-blue-800 mb-1">Email</h2>
          <p class="text-blue-700">contact@freetoolbox.io</p>
        </div>

        <div class="p-4 bg-green-50 rounded-lg">
          <h2 class="font-semibold text-green-800 mb-1">Bug Reports</h2>
          <p class="text-green-700">If a tool isn't working correctly, please include: the tool name, what you expected, what happened, and your browser/device.</p>
        </div>

        <div class="p-4 bg-purple-50 rounded-lg">
          <h2 class="font-semibold text-purple-800 mb-1">Tool Suggestions</h2>
          <p class="text-purple-700">Want a tool we don't have? Let us know and we'll consider adding it.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
